        """Dosya MÜSAİT olduğunda sıradaki kullanıcıya bir kez popup göster."""
        try:
            durum = getattr(d, "durum", None)
            musait = str(getattr(durum, "name", durum)).upper() == "MUSAIT"
            sira = list(self.servis.sira_listesi())
            me = str(globals().get("KULLANICI", ""))
            ben_ilk = bool(sira) and str(sira[0]).casefold() == me.casefold()
            if not musait or not ben_ilk:
                self._sira_popup_gosterildi = False
                return
            if not getattr(self, "_sira_popup_gosterildi", False):
                self._sira_popup_gosterildi = True
                self.root.after(150, self._sira_sana_geldi_popup)
        except Exception:
            pass

