    def _ses_calar(self, tip: str) -> None:
        if not (
            self.tercihler.ses_bildirimleri
            and _SES_VAR
        ):
            return

        try:
            if tip in (
                "mesaj",
                "sistem_mesaj",
                "acildi",
                "kaydet",
                "basari",
            ):
                winsound.MessageBeep(
                    winsound.MB_ICONASTERISK
                )

            elif tip in ("hata", "uyari"):
                winsound.MessageBeep(
                    winsound.MB_ICONEXCLAMATION
                )

        except Exception:
            pass

