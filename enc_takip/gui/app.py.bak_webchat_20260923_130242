    def _durum_goster(
        self,
        d,
    ) -> None:
        self.sb_durum_var.set(
            f"Bağlı • "
            f"{datetime.now().strftime('%H:%M:%S')}"
        )

        self.sb_ikon.configure(
            text_color=r(T.OK)
        )

        # ───────────────────────────────────── Son değiştiren

        if d.son_degistiren:
            metin = (
                f"✏️ Son değiştiren: "
                f"{d.son_degistiren}"
            )

            if d.son_degisim:
                metin += (
                    "  •  "
                    f"{d.son_degisim.strftime('%d.%m.%Y %H:%M')}"
                )

            self.iz_deg_var.set(
                metin
            )

        else:
            self.iz_deg_var.set(
                "Son değiştiren bilgisi yok"
            )

        # ───────────────────────────────────────── Dosya bilgisi

        bilgi = []

        if d.boyut_bayt:
            bilgi.append(
                (
                    f"{d.boyut_bayt / 1024:.0f} KB"
                    if d.boyut_bayt < 1_048_576
                    else f"{d.boyut_bayt / 1_048_576:.1f} MB"
                )
            )

        if d.degisim_zamani:
            bilgi.append(
                d.degisim_zamani.strftime(
                    "%d.%m.%Y %H:%M"
                )
            )

        self.iz_bilgi_var.set(
            "     ".join(bilgi)
        )

        # ───────────────────────────────────────── Durum stili

        ikon, baslik, renk, bg = _DURUM_STIL.get(
            d.durum,
            (
                "●",
                str(d.durum),
                T.METIN,
                T.KART,
            ),
        )

        self.iz_ikon_var.set(
            ikon
        )

        self.iz_durum_var.set(
            baslik
        )

        self.iz_ikon.configure(
            text_color=renk
        )

        self.iz_durum.configure(
            text_color=renk
        )

        self.iz_durum_kart.configure(
            fg_color=bg
        )

        self.sira_f.pack(fill=tk.X, padx=20, pady=(0, 9))

        # ───────────────────────────────────── Başkasında açık

        if d.durum == DosyaDurumu.KULLANIMDA_BASKASI:
            self.iz_detay_var.set(
                f"Kullanan: {d.kullanici}\n"
                f"{d.bilgisayar}\n"
                f"Açık süre: {sure_metni(d.acik_sure_sn)}"
            )

            self.iz_ac_btn.configure(
                fg_color=T.HATA,
                text="Dosya Kullanımda",
            )

            self.sira_f.pack(
                fill=tk.X
            )

            self._sira_gostergesini_guncelle()

        # ─────────────────────────────────────────── Sizin açık

        elif d.durum == DosyaDurumu.KULLANIMDA_BENDE:
            self.iz_detay_var.set(
                f"Açık süre: {sure_metni(d.acik_sure_sn)}\n\n"
                f"İşiniz bitince 'Kapattım' butonuna basın"
            )

            self.iz_ac_btn.configure(
                fg_color=(
                    "#4c956c",
                    "#3f7a5a",
                ),
                text="Sizde Açık",
            )

        # ───────────────────────────────────────────── Belirsiz

        elif d.durum == DosyaDurumu.BELIRSIZ:
            sahip = str(getattr(d, "kullanici", "") or "").strip()
            if sahip:
                detay = (
                    f"Dosya Windows / Word tarafından gerçekten kilitli.\n"
                    f"Görünen kullanıcı: {sahip}"
                )
            else:
                try:
                    sahip2 = self.servis.kilit.word_kilit_sahibi()
                except Exception:
                    sahip2 = None
                if sahip2:
                    detay = (
                        "Dosya Windows / Word tarafından gerçekten kilitli.\n"
                        f"Görünen kullanıcı: {sahip2}"
                    )
                else:
                    detay = (
                        "Dosya Windows / Word tarafından gerçekten kilitli.\n"
                        "Kullanıcı adı bu oturumdan alınamadı."
                    )
            self.iz_durum_var.set("KULLANIMDA")
            self.iz_detay_var.set(detay)
            self.iz_ikon_var.set("●")
            try:
                self.iz_ac_btn.configure(fg_color=T.UYARI, text="Kullanımda")
            except Exception:
                pass
        elif d.durum == DosyaDurumu.DOSYA_YOK:
            self.iz_detay_var.set(
                f"{self.s.dosya_adi} konumda bulunamadı."
            )

            self.iz_ac_btn.configure(
                fg_color=T.UYARI,
                text="Dosyayı Aç",
            )

        # ───────────────────────────────────── Bağlantı yok

        elif d.durum == DosyaDurumu.BAGLANTI_YOK:
            self.iz_detay_var.set(
                f"Sunucuya ulaşılamıyor: "
                f"{self.s.ag_yolu}"
            )

            self.iz_ac_btn.configure(
                fg_color=T.HATA,
                text="Dosyayı Aç",
            )

        # ───────────────────────────────────────────── Müsait

        else:
            self.iz_detay_var.set(
                "Dosya müsait. Açmak için butona tıklayın."
            )

            self.iz_ac_btn.configure(
                fg_color=T.ANA,
                text="Dosyayı Aç",
            )

    # ═════════════════════════════════════════════════════ KAPATMA

    def _kapatirken(self) -> None:
        if (
            TEPSI_VAR
            and self.tercihler.tepsiye_kucult
            and not self._tepsiye_gercekten_kapat
        ):
            self.root.withdraw()

            self._bildirim_goster(
                "Tepsiye Küçültüldü",
                "Uygulama arka planda çalışmaya devam ediyor.",
                "bilgi",
                4000,
            )

            return

        if self._tepsi is not None:
            self._tepsi.durdur()

        try:
            self._mesaj_receipt_queue.put_nowait(None)
        except Exception:
            pass
        try:
            self._chat_preview_executor.shutdown(wait=False, cancel_futures=True)
        except Exception:
            pass
        try:
            self._mesaj_local_cache.close()
        except Exception:
            pass
        self.servis.durdur()

        self.root.destroy()

    # ═══════════════════════════════════════════════════ GÜNCELLEME

    def _guncelleme_kontrolu(self) -> None:
        try:
            manifest, hata = kontrol_et(
                self.s
            )

            if manifest:
                yeni_surumu = manifest.get(
                    "version",
                    "?",
                )

                self._bildirim_goster(
                    "Güncelleme",
                    (
                        "ENÇEV Dosya Takip "
                        f"{yeni_surumu} sürümüne "
                        "güncelleniyor..."
                    ),
                    "bilgi",
                    5000,
                )

                guncellemeyi_baslat(
                    self.s,
                    manifest,
                    self.root,
                    self._bildirim_goster,
                )

                return

        except Exception:
            # Güncelleme hatası ana programı etkilemesin.
            pass

        if self.root.winfo_exists():
            self.root.after(
                CHECK_INTERVAL_MS,
                self._guncelleme_kontrolu,
            )

    def calistir(self) -> None:
        self.root.mainloop()


