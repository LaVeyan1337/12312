    def _chat_ayar_dosyasi(self) -> Path:
        return Path(os.environ.get("LOCALAPPDATA") or Path.home()) / "ENÇEV" / "ENCTakip_sohbet_ayarlari.json"

    def _chat_ayarlarini_yukle(self) -> str:
        varsayilan = "classic"
        try:
            p = self._chat_ayar_dosyasi()
            if p.exists():
                v = json.loads(p.read_text(encoding="utf-8"))
                if isinstance(v, dict) and v.get("background") in {"classic", "white", "mint", "blue"}:
                    return str(v["background"])
        except Exception:
            pass
        return varsayilan

    def _chat_ayarlarini_kaydet(self, key: str) -> None:
        try:
            p = self._chat_ayar_dosyasi()
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps({"background": key}, ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception:
            pass

    def _chat_renkleri(self, key=None):
        key = key or getattr(self, "_chat_bg_key", "classic")
        return {
            "classic": ("#efeae2", "#f0f2f5"),
            "white": ("#f7f9fa", "#ffffff"),
            "mint": ("#eaf5f0", "#f4faf7"),
            "blue": ("#edf3fa", "#f7fbff"),
        }.get(key, ("#efeae2", "#f0f2f5"))

    def _chat_arka_plan_menu(self) -> None:
        mevcut = getattr(self, "_chat_bg_popup", None)
        if mevcut is not None:
            try:
                if mevcut.winfo_exists():
                    mevcut.lift(); return
            except Exception:
                self._chat_bg_popup = None

        pen = tk.Toplevel(self.root)
        self._chat_bg_popup = pen
        pen.overrideredirect(True)
        pen.configure(bg="#dfe5e7")
        pen.transient(self.root)
        pen.attributes("-topmost", True)
        shell = tk.Frame(pen, bg="#ffffff", bd=0, highlightthickness=1, highlightbackground="#dfe5e7")
        shell.pack(fill=tk.BOTH, expand=True, padx=1, pady=1)
        tk.Label(shell, text="Sohbet arka planı", bg="#ffffff", fg="#111b21", font=("Segoe UI", 11, "bold")).pack(anchor="w", padx=15, pady=(14, 9))
        choices = [("classic", "Klasik", "#efeae2"), ("white", "Temiz Beyaz", "#f7f9fa"), ("mint", "Soft Mint", "#eaf5f0"), ("blue", "Soft Blue", "#edf3fa")]
        for key, name, color in choices:
            row = tk.Frame(shell, bg="#ffffff", height=42, cursor="hand2")
            row.pack(fill=tk.X, padx=8, pady=1); row.pack_propagate(False)
            sw = tk.Canvas(row, width=27, height=27, bg="#ffffff", bd=0, highlightthickness=0)
            sw.pack(side=tk.LEFT, padx=(7,9), pady=7); sw.create_oval(2,2,25,25,fill=color,outline="#cfd5d9")
            lab = tk.Label(row, text=name, bg="#ffffff", fg="#111b21", font=("Segoe UI",9), cursor="hand2")
            lab.pack(side=tk.LEFT)
            cmd=lambda e=None,k=key,p=pen:self._chat_arka_plan_uygula(k,p)
            for w in (row,sw,lab): w.bind("<Button-1>",cmd)
        tk.Label(shell, text="Seçiminiz bu bilgisayarda saklanır.", bg="#ffffff", fg="#667781", font=("Segoe UI",8)).pack(anchor="w", padx=15, pady=(8,12))
        try:
            x=self.root.winfo_rootx()+self.root.winfo_width()-270; y=self.root.winfo_rooty()+68
            pen.geometry(f"250x278+{max(8,x)}+{max(8,y)}")
        except Exception: pen.geometry("250x278")
        pen.after(20, pen.lift)

    def _chat_arka_plan_uygula(self, key: str, pen=None) -> None:
        if key not in {"classic", "white", "mint", "blue"}:
            return
        self._chat_bg_key = key
        self._chat_ayarlarini_kaydet(key)
        bg, composer_bg = self._chat_renkleri(key)
        try:
            self.ms_canvas.configure(bg=bg)
            self.ms_chat_host.configure(bg=bg)
            self.ms_inner.configure(bg=bg)
            self.ms_composer.configure(bg=composer_bg)
            self.ms_header.configure(bg=composer_bg)
            self.ms_left.configure(bg="#ffffff")
        except Exception:
            pass
        if hasattr(self, "_chat_base_signature"):
            self._chat_base_signature = None
        self._mesajlari_yukle(force=True)
        if pen is not None:
            try:
                pen.destroy()
            except Exception:
                pass

    def _avatar_gorseli(self, harf: str, renk: str, boyut: int = 46):
        cache = getattr(self, "_avatar_cache", {})
        key = (harf, renk, boyut)
        if key in cache:
            return cache[key]
        scale = 4
        s = boyut * scale
        img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        draw.ellipse((0, 0, s - 1, s - 1), fill=renk)
        font_yolu = Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts" / "segoeui.ttf"
        font = ImageFont.truetype(str(font_yolu), int(boyut * 0.34 * scale)) if font_yolu.exists() else ImageFont.load_default()
        bb = draw.textbbox((0, 0), harf, font=font)
        tw, th = bb[2] - bb[0], bb[3] - bb[1]
        draw.text(((s-tw)/2-bb[0], (s-th)/2-bb[1]-2*scale), harf, fill="#ffffff", font=font)
        img = img.resize((boyut, boyut), Image.Resampling.LANCZOS)
        photo = ImageTk.PhotoImage(img)
        cache[key] = photo
        self._avatar_cache = cache
        self._chat_image_refs = getattr(self, "_chat_image_refs", [])
        self._chat_image_refs.append(photo)
        return photo

    def _profil_renk(self, kullanici_adi: str) -> str:
        palet = ("#00a884", "#5468ff", "#8b5cf6", "#d97706", "#0f766e", "#db2777", "#2563eb")
        idx = sum(ord(ch) for ch in str(kullanici_adi)) % len(palet)
        return palet[idx]

    def _mevcut_kullanici_profili(self) -> KullaniciProfili | None:
        try:
            return self._kullanici_rehberi.profil_esle(KULLANICI, self._yerel_bilgisayar)
        except Exception:
            return None

    def _kullanici_profili(self, kullanici_adi: str) -> KullaniciProfili | None:
        try:
            return self._kullanici_rehberi.cache_profili(kullanici_adi)
        except Exception:
            return None

    def _kullanici_durum_bilgisi(self, profil: KullaniciProfili) -> tuple[str, str]:
        try:
            if not self._kullanici_cevrimici_mi(profil.kullanici_adi):
                return "Çevrimdışı", "#8696a0"
        except Exception:
            return "Çevrimdışı", "#8696a0"
        return profil.durum_adi, profil.durum_rengi

    def _durum_panel_guncelle(self) -> None:
        try:
            profil = self._mevcut_kullanici_profili()
            if profil is None or not hasattr(self, "_durum_panel_buton"):
                return
            ad = profil.durum_adi
            renk = profil.durum_rengi
            self._durum_panel_buton.configure(
                text=f"●  Durum Belirle: {ad}",
                fg=renk,
                activeforeground=renk,
            )
        except Exception:
            pass

    def _kullanici_durum_sec(self, durum: str) -> None:
        profil = self._mevcut_kullanici_profili()
        if profil is None:
            self._bildirim_goster("Profil", "Bu bilgisayar için kullanıcı eşleştirmesi bulunamadı.", "uyari", 4500)
            return
        try:
            yeni = self._kullanici_rehberi.durum_degistir(profil.kullanici_adi, durum)
            if yeni is None:
                raise RuntimeError("Profil güncellenemedi.")
            self._kullanici_rehberi.yenile()
            self._durum_panel_guncelle()
            self._kisi_listesini_yukle(force=True)
            self._bildirim_goster("Durum güncellendi", yeni.durum_adi, "basari", 2500)
        except Exception as exc:
            self._bildirim_goster("Durum güncellenemedi", str(exc), "hata", 4500)

    def _durum_menu_ac(self) -> None:
        """Renkli durum seçici; Tk Menu yerine kontrollü kart kullanır.

        Böylece durum noktaları gerçekten kendi renklerinde çizilir ve
        Windows menüsündeki tek tip metin rengi sınırlaması ortadan kalkar.
        """
        try:
            eski = getattr(self, "_durum_popup", None)
            if eski is not None and eski.winfo_exists():
                eski.destroy()
        except Exception:
            pass

        try:
            pen = tk.Toplevel(self.root)
            self._durum_popup = pen
            pen.withdraw()
            pen.overrideredirect(True)
            pen.transient(self.root)
            pen.attributes("-topmost", True)

            shell = tk.Frame(
                pen, bg="#ffffff", bd=0,
                highlightthickness=1, highlightbackground="#d9e0e3"
            )
            shell.pack(fill=tk.BOTH, expand=True)

            tk.Label(
                shell, text="Durumunu seç", bg="#ffffff", fg="#667781",
                font=("Segoe UI", 8, "bold"), anchor="w"
            ).pack(fill=tk.X, padx=12, pady=(10, 5))

            for key in ("online", "busy", "meeting", "away"):
                ad, renk = DURUMLAR[key]
                row = tk.Frame(shell, bg="#ffffff", height=34, cursor="hand2")
                row.pack(fill=tk.X, padx=6, pady=1)
                row.pack_propagate(False)
                dot = tk.Label(
                    row, text="●", bg="#ffffff", fg=renk,
                    font=("Segoe UI", 11, "bold"), width=2
                )
                dot.pack(side=tk.LEFT, padx=(6, 2))
                lbl = tk.Label(
                    row, text=ad, bg="#ffffff", fg="#111b21",
                    font=("Segoe UI", 9), anchor="w"
                )
                lbl.pack(side=tk.LEFT, fill=tk.X, expand=True)

                def choose(k=key):
                    try:
                        pen.destroy()
                    except Exception:
                        pass
                    self._kullanici_durum_sec(k)

                for child in (row, dot, lbl):
                    child.bind("<Button-1>", lambda _e, cb=choose: cb())
                    child.bind("<Enter>", lambda _e, w=row: w.configure(bg="#f5f7f8"))
                    child.bind("<Leave>", lambda _e, w=row: w.configure(bg="#ffffff"))
                    if child is not dot:
                        pass

            pen.update_idletasks()
            w = max(220, pen.winfo_reqwidth())
            h = max(175, pen.winfo_reqheight())
            x = self._durum_panel_buton.winfo_rootx()
            y = self._durum_panel_buton.winfo_rooty() + self._durum_panel_buton.winfo_height() + 4
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
            x = max(6, min(sw - w - 6, x))
            if y + h > sh - 8:
                y = max(8, self._durum_panel_buton.winfo_rooty() - h - 4)
            pen.geometry(f"{w}x{h}+{x}+{y}")
            pen.deiconify()
            pen.lift()
            pen.focus_force()
            pen.bind("<Escape>", lambda _e: pen.destroy())
            self.root.after(30, lambda: self._durum_popup_disim_tiklama_kur(pen))
        except Exception:
            try:
                pen.destroy()
            except Exception:
                pass

    def _durum_popup_disim_tiklama_kur(self, pen):
        # Tk seviyesinde global bind yerine hafif bir odak kontrolü; popup kapanınca
        # root üzerinde kalıcı bind bırakmaz.
        try:
            if pen.winfo_exists():
                pen.grab_set()
        except Exception:
            pass

    def _kullanici_cevrimici_mi(self, kullanici_adi: str) -> bool:
        try:
            hedef = str(kullanici_adi).casefold()
            return any(str(x.kullanici).casefold() == hedef for x in self.servis.aktif_kullanicilar())
        except Exception:
            return False

    def _profil_avatar_gorseli(self, kullanici_adi: str, boyut: int = 46):
        profil = self._kullanici_profili(kullanici_adi)
        if profil is None:
            return self._avatar_gorseli(str(kullanici_adi)[:1].upper() or "?", "#8b98a5", boyut)

        avatar_yolu = None
        try:
            avatar_yolu = self._kullanici_rehberi.avatar_yolu(profil)
        except Exception:
            avatar_yolu = None
        if avatar_yolu is None:
            return self._avatar_gorseli(profil.bas_harfler, self._profil_renk(profil.kullanici_adi), boyut)

        try:
            key = ("profile", profil.kullanici_adi.casefold(), int(boyut))
            cache = getattr(self, "_profile_avatar_cache", {})
            if key in cache:
                return cache[key]
            with Image.open(avatar_yolu) as raw:
                im = raw.convert("RGB")
                side = min(im.width, im.height)
                left = max(0, (im.width - side) // 2)
                top = max(0, (im.height - side) // 2)
                im = im.crop((left, top, left + side, top + side)).resize((boyut * 2, boyut * 2), Image.Resampling.LANCZOS)
                rgba = im.convert("RGBA")
            mask = Image.new("L", rgba.size, 0)
            ImageDraw.Draw(mask).ellipse((0, 0, rgba.width - 1, rgba.height - 1), fill=255)
            rgba.putalpha(mask)
            photo = ImageTk.PhotoImage(rgba.resize((boyut, boyut), Image.Resampling.LANCZOS))
            cache[key] = photo
            self._profile_avatar_cache = cache
            self._chat_image_refs = getattr(self, "_chat_image_refs", [])
            self._chat_image_refs.append(photo)
            return photo
        except Exception:
            return self._avatar_gorseli(profil.bas_harfler, self._profil_renk(profil.kullanici_adi), boyut)

