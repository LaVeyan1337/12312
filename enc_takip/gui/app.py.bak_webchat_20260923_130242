            body.pack(fill=tk.BOTH, expand=True, padx=20, pady=(0, 12))

            receipts = self._mesaj_receiptleri_getir(str(m.id))
            # Lokal cache'te marker henüz yoksa, yalnızca bu pencere açıldığında
            # server geçmişinde hedefe özel marker araması yapılır. Böylece normal
            # sohbet akışı hiçbir zaman ağ taraması yapmaz.
            if not receipts["delivered"] and not receipts["read"]:
                try:
                    uzak = self.servis.mesaj_receiptleri(str(m.id), hedef=str(m.hedef))
                    for item in uzak:
                        kind, data = self._mesaj_marker_coz(item.metin)
                        if kind not in ("delivered", "read"):
                            continue
                        user = str((data or {}).get("user", "")).strip()
                        if user:
                            receipts["read" if kind == "read" else "delivered"][user.casefold()] = {"user": user, "time": str(getattr(item, "zaman", "") or "")}
                except Exception:
                    pass

            def saat(zaman):
                try:
                    return datetime.fromisoformat(zaman).strftime("%d.%m.%Y  %H:%M:%S")
                except Exception:
                    return zaman or "—"

            def kategori(icon, baslik, aciklama, kayitlar, bos):
                kart = tk.Frame(body, bg="#ffffff", bd=0, highlightthickness=1, highlightbackground="#dfe4e6")
                kart.pack(fill=tk.X, padx=5, pady=(7, 4))
                ust = tk.Frame(kart, bg="#ffffff")
                ust.pack(fill=tk.X, padx=14, pady=(12, 2))
                tk.Label(ust, text=icon, bg="#ffffff", fg="#00a884", font=("Segoe UI Symbol", 13, "bold")).pack(side=tk.LEFT)
                tk.Label(ust, text=baslik, bg="#ffffff", fg="#111b21", font=("Segoe UI", 10, "bold")).pack(side=tk.LEFT, padx=(8,0))
                tk.Label(kart, text=aciklama, bg="#ffffff", fg="#667781", font=("Segoe UI", 8), anchor="w").pack(fill=tk.X, padx=14, pady=(0,8))
                if not kayitlar:
                    tk.Label(kart, text=bos, bg="#ffffff", fg="#8696a0", font=("Segoe UI", 9), anchor="w").pack(fill=tk.X, padx=14, pady=(0,13))
                    return
                for item in sorted(kayitlar.values(), key=lambda x: x.get("time", "")):
                    sat = tk.Frame(kart, bg="#f7f9f9")
                    sat.pack(fill=tk.X, padx=10, pady=(0,6))
                    tk.Label(sat, text=item.get("user", ""), bg="#f7f9f9", fg="#111b21", font=("Segoe UI",9,"bold"), anchor="w").pack(side=tk.LEFT, padx=10, pady=9)
                    tk.Label(sat, text=saat(item.get("time", "")), bg="#f7f9f9", fg="#667781", font=("Segoe UI",8), anchor="e").pack(side=tk.RIGHT, padx=10, pady=9)

            kategori("✓✓", "İLETİLDİ", "Mesajın karşı tarafa / ilgili sohbet katılımcısına ulaştığı kayıtlar.", receipts["delivered"], "Henüz iletildi kaydı oluşmadı.")
            kategori("✓✓", "AÇILDI / OKUNDU", "Kişinin sohbeti açıp bu mesajın görüldüğünü bildiren gerçek kayıtlar.", receipts["read"], "Henüz bu mesajı açan / okuyan kişi yok.")

            ctk.CTkButton(pen, text="Kapat", height=38, corner_radius=9, fg_color=T.ANA, hover_color=T.ANA_HOVER, command=pen.destroy).pack(fill=tk.X, padx=20, pady=(0,18))
        except Exception as exc:
            print(f"[MESAJ BİLGİLERİ] {exc}")

    def _mesaj_sil_onayla(self, mesaj_id: str) -> None:
        """Mesajı sohbetin tüm katılımcılarından gizlemek için delete marker gönderir."""
        try:
            if not messagebox.askyesno(
                "Mesajı sil",
                "Bu mesajı sohbetten silmek istediğinize emin misiniz?",
                parent=self.root,
            ):
                return

            marker_data = {
                "id": str(mesaj_id),
                "user": KULLANICI,
            }
            marker = "__ENCTAKIP_DELETE__" + json.dumps(
                marker_data,
                ensure_ascii=False,
                separators=(",", ":"),
            )
            if not self.servis.mesaj_gonder(marker, self.sohbet_hedef):
                messagebox.showerror(
                    "Mesajı sil",
                    "Mesaj silme kaydı oluşturulamadı.",
                    parent=self.root,
                )
                return

            self._mesaj_yeni_senkron_baslat()
            self._chat_base_signature = None
            self._mesajlari_yukle(force=True)
        except Exception as exc:
            messagebox.showerror(
                "Mesajı sil",
                f"Mesaj silinemedi:\n{exc}",
                parent=self.root,
            )

    def _mesaj_duzenle_penceresi(self, mesaj_id: str, mevcut: str) -> None:
        pen = ctk.CTkToplevel(self.root)
        pen.title("Mesajı Düzenle")
        pen.geometry("560x300")
        pen.resizable(False, False)
        pen.attributes("-topmost", True)

        ctk.CTkLabel(
            pen,
            text="Mesajı düzenle",
            font=(T.FONT, T.FONT_BASLIK, "bold"),
            text_color=T.METIN,
        ).pack(anchor="w", padx=18, pady=(16, 3))

        ctk.CTkLabel(
            pen,
            text="Değişiklik kaydedildiğinde mesajın altında “düzenlendi” görünür.",
            font=(T.FONT, T.FONT_KUCUK),
            text_color=T.METIN3,
        ).pack(anchor="w", padx=18, pady=(0, 10))

        alan = tk.Text(
            pen,
            font=(T.FONT, T.FONT_NORMAL),
            bg=r(T.KART_2),
            fg=r(T.METIN),
            insertbackground=r(T.METIN),
            wrap=tk.WORD,
            relief=tk.FLAT,
            bd=0,
            highlightthickness=1,
            highlightbackground=r(T.KENAR),
            padx=12,
            pady=10,
            height=7,
        )
        alan.pack(fill=tk.BOTH, expand=True, padx=18, pady=(0, 12))
        alan.insert("1.0", mevcut)
        alan.focus_set()

        alt = ctk.CTkFrame(pen, fg_color="transparent")
        alt.pack(fill=tk.X, padx=18, pady=(0, 16))

        def kaydet():
            yeni = alan.get("1.0", tk.END).strip()
            if not yeni:
                messagebox.showwarning(
                    "Mesajı Düzenle",
                    "Mesaj boş bırakılamaz.",
                    parent=pen,
                )
                return
            if yeni == mevcut:
                pen.destroy()
                return

            marker_data = {
                "id": mesaj_id,
                "text": yeni,
            }
            marker = "__ENCTAKIP_EDIT__" + json.dumps(
                marker_data,
                ensure_ascii=False,
                separators=(",", ":"),
            )
            if self.servis.mesaj_gonder(marker, self.sohbet_hedef):
                # Edit marker mevcut kullanıcıdan geldiği için watcher onu
                # bilinçli olarak tekrar kuyruğa koymaz. Son gönderilen kaydı
                # doğrudan lokal cache'e alıp düzenlemeyi anında uygula.
                self._mesaj_yeni_senkron_baslat()
                pen.destroy()
                self._chat_base_signature = None
                self._mesajlari_yukle(force=True)
            else:
                messagebox.showerror(
                    "Mesajı Düzenle",
                    "Mesaj güncellenemedi.",
                    parent=pen,
                )

        ctk.CTkButton(
            alt,
            text="İptal",
            font=(T.FONT, T.FONT_KUCUK_BOLD),
            fg_color=T.KART_2,
            hover_color=T.KENAR,
            text_color=T.METIN,
            corner_radius=8,
            height=36,
            command=pen.destroy,
        ).pack(side=tk.RIGHT)

        ctk.CTkButton(
            alt,
            text="Kaydet",
            font=(T.FONT, T.FONT_KUCUK_BOLD),
            fg_color=T.ANA,
            hover_color=T.ANA_HOVER,
            text_color="#FFFFFF",
            corner_radius=8,
            height=36,
            command=kaydet,
        ).pack(side=tk.RIGHT, padx=(0, 8))

    def _mesaj_marker_mi(self, metin: str) -> bool:
        kind, _ = self._mesaj_marker_coz(metin)
        return kind in ("edit", "file", "delete", "delivered", "read")

    def _mesajlari_yukle(self, force: bool = False) -> None:
        if not hasattr(self, "ms_canvas"):
            return
        if getattr(self, "_chat_rendering", False):
            return

        all_views = self._mesaj_gorunumleri_hazirla()
        gorunumler = [x for x in all_views if self._mesaj_gorunumune_uyuyor_mu(x)]
        base_signature = (
            tuple(
                (
                    x["m"].id,
                    x["metin"],
                    bool(x.get("duzenlendi")),
                    bool(x.get("silindi")),
                    str((x.get("dosya") or {}).get("name", "")),
                    str((x.get("dosya") or {}).get("size", 0)),
                )
                for x in gorunumler
            ),
            str(getattr(self, "_chat_search_focus_id", "") or ""),
            str(getattr(self, "_chat_local_search_focus_id", "") or ""),
        )
        target = self.sohbet_hedef
        previous_target = getattr(self, "_chat_current_target", None)
        target_changed = target != previous_target

        # Aynı sohbet ve aynı veri zaten görünürse hiçbir şeyi yeniden oluşturma.
        # Sohbet değişiminde ise eski Canvas sahnesini ASLA geri çağırma; her zaman
        # tek aktif sahne kullanıyoruz. Bu, gizli sahnelerin Configure olaylarının
        # ortak scrollregion'ı bozmasını tamamen ortadan kaldırır.
        if (
            not force
            and not target_changed
            and target == getattr(self, "_chat_current_target", None)
            and base_signature == getattr(self, "_chat_base_signature", None)
        ):
            self._chat_scrollregion_guncelle()
            self._mesaj_receipt_etiketlerini_guncelle()
            if self._chat_kullanici_altta_mi():
                self._mesaj_okundu_isaretle(gorunumler)
            self._chat_tail_butonu_guncelle()
            return

        self._chat_base_signature = base_signature
        self._chat_rendering = True

        old_inner = getattr(self, "ms_inner", None)
        old_item = getattr(self, "ms_canvas_window", None)

        try:
            old_view = self.ms_canvas.yview()
            old_y = old_view[0] if old_view else 0.0
            old_bbox = self.ms_canvas.bbox("all")
            old_total_h = max(1, (old_bbox[3] - old_bbox[1]) if old_bbox else 1)
            old_view_h = max(1, self.ms_canvas.winfo_height())
            old_scroll_px = old_y * max(1, old_total_h - old_view_h)

            # Yeni bir sohbet açıldığında kullanıcıyı son mesaja götür.
            # Arama sonucu sonradan kendi mesajını ortalayacaktır.
            if target_changed:
                old_y = 1.0
                at_bottom = True
            else:
                at_bottom = old_view[1] >= 0.985 if old_view else True
        except Exception:
            old_y, at_bottom = 0.0, True
            old_total_h, old_view_h, old_scroll_px = 1, 1, 0.0

        # Hesaplamanın daha aşağıdaki try bloğunda hata alması durumunda bile
        # finalde güvenle kullanılabilsin.
        should_follow_tail = bool(target_changed or (at_bottom and getattr(self, "_chat_follow_tail", True)))

        WA_BG, _ = self._chat_renkleri(self._chat_bg_key)
        self._chat_scene_generation = getattr(self, "_chat_scene_generation", 0) + 1
        scene_generation = self._chat_scene_generation
        scene_image_refs = []
        self._chat_active_image_refs = scene_image_refs
        new_inner = tk.Frame(self.ms_canvas, bg=WA_BG, bd=0, highlightthickness=0)
        new_item = self.ms_canvas.create_window((0,0), window=new_inner, anchor="nw", state="hidden")
        self.ms_canvas.itemconfigure(new_item, width=max(1, self.ms_canvas.winfo_width()))
        self._chat_tick_widgets = {}

        if not gorunumler:
            wrap = tk.Frame(new_inner, bg=WA_BG)
            wrap.pack(fill=tk.BOTH, expand=True, pady=130)
            tk.Label(wrap, text="Henüz mesaj yok", bg=WA_BG, fg="#22313a", font=("Segoe UI",11,"bold")).pack()
            tk.Label(wrap, text="İlk mesajı gönderin. 😊", bg=WA_BG, fg="#667781", font=("Segoe UI",9)).pack(pady=(5,0))
        else:
            son_gun = None
            for kayit in gorunumler:
                m = kayit["m"]
                try:
                    zaman_dt = datetime.fromisoformat(m.zaman)
                except Exception:
                    zaman_dt = datetime.now()
                gun = zaman_dt.date()
                if gun != son_gun:
                    son_gun = gun
                    gun_str = "BUGÜN" if gun == datetime.now().date() else ("DÜN" if gun == datetime.now().date()-timedelta(days=1) else zaman_dt.strftime("%d.%m.%Y"))
                    dr = tk.Frame(new_inner, bg=WA_BG)
                    dr.pack(fill=tk.X, pady=(11,7))
                    pill = ctk.CTkLabel(dr, text=gun_str, fg_color="#ffffff", text_color="#54656f", corner_radius=14, font=("Segoe UI",7,"bold"), padx=12, pady=4)
                    pill.pack()

                if m.gonderen == SISTEM_GONDEREN:
                    row = tk.Frame(new_inner, bg=WA_BG)
                    row.pack(fill=tk.X, padx=18, pady=5)
                    ctk.CTkLabel(row, text=kayit["metin"], fg_color="#ffffff", text_color="#667781", corner_radius=12, font=("Segoe UI",8), padx=12, pady=6, wraplength=520).pack(anchor="center")
                    continue

                ben = m.gonderen.casefold() == KULLANICI.casefold()
                row = tk.Frame(new_inner, bg=WA_BG, bd=0, highlightthickness=0)
                row._enctakip_mesaj_id = str(m.id)
                row.pack(fill=tk.X, padx=13, pady=1)
                anchor = "e" if ben else "w"
                sidepad = (100,5) if ben else (5,100)
                if not ben:
                    avatar_photo = self._profil_avatar_gorseli(str(m.gonderen), 42)
                    avatar = tk.Label(
                        row,
                        image=avatar_photo,
                        bg=WA_BG,
                        bd=0,
                        cursor="hand2",
                    )
                    avatar.image = avatar_photo
                    avatar.pack(side=tk.LEFT, padx=(2, 7), pady=(7, 1), anchor="n")
                    avatar.bind("<Button-1>", lambda _e, k=str(m.gonderen): self._kullanici_profil_penceresi(k))

                secili_arama = bool(
                    (getattr(self, "_chat_search_focus_id", None) and str(getattr(self, "_chat_search_focus_id")) == str(m.id))
                    or (getattr(self, "_chat_local_search_focus_id", None) and str(getattr(self, "_chat_local_search_focus_id")) == str(m.id))
                )
                bubble = ctk.CTkFrame(
                    row,
                    fg_color="#d9fdd3" if ben else "#ffffff",
                    corner_radius=18,
                    border_width=2 if secili_arama else 0,
                    border_color="#00a884" if secili_arama else ("#d9fdd3" if ben else "#ffffff"),
                )
                if ben:
                    bubble.pack(anchor=anchor, padx=sidepad)
                else:
                    bubble.pack(side=tk.LEFT, anchor="w", padx=sidepad)

                if not ben:
                    profil = self._kullanici_profili(str(m.gonderen))
                    sender_name = profil.gorunen_ad if profil else str(m.gonderen)
                    sender_label = tk.Label(bubble, text=sender_name, bg="#ffffff", fg=self._profil_renk(str(m.gonderen)), font=("Segoe UI",8,"bold"), anchor="w", cursor="hand2")
                    sender_label.pack(fill=tk.X, padx=11, pady=(7,0))
                    sender_label.bind("<Button-1>", lambda _e, k=str(m.gonderen): self._kullanici_profil_penceresi(k))

                content = tk.Frame(bubble, bg="#d9fdd3" if ben else "#ffffff", bd=0, highlightthickness=0)
                content.pack(fill=tk.X, padx=11, pady=(5 if ben or self.sohbet_hedef not in ("ODA_ECED","ODA_DILEK","GENEL") else 2,0))

                if kayit.get("silindi"):
                    tk.Label(
                        content,
                        text="Bu mesaj silindi",
                        bg="#d9fdd3" if ben else "#ffffff",
                        fg="#8696a0",
                        font=("Segoe UI", 9, "italic"),
                        anchor="w",
                    ).pack(anchor="e" if ben else "w")
                elif kayit["dosya"]:
                    dosya = kayit["dosya"]
                    ad = str(dosya.get("name") or "Paylaşılan dosya")
                    boyut = int(dosya.get("size", 0) or 0)
                    aciklama = str(dosya.get("caption") or "")
                    suffix = Path(ad).suffix.lower()
                    resim_uzantilari = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".tif", ".tiff"}

                    if suffix in resim_uzantilari:
                        # Resimler artık yalnızca "Aç" ile açılan dosya kartı değil;
                        # sohbetin içinde otomatik küçük önizleme olarak gösterilir.
                        # Büyük ağ dosyası GUI thread'ini kilitlemesin diye yükleme asenkron yapılır.
                        self._mesaj_resim_onizleme(
                            content,
                            dosya,
                            "#d9fdd3" if ben else "#ffffff",
                            ben,
                        )
                    else:
                        card_bg = "#cdecc7" if ben else "#f3f4f4"
                        card = tk.Frame(content, bg=card_bg, bd=0, highlightthickness=1, highlightbackground="#d0d7da")
                        card.pack(anchor="w", fill=tk.X)
                        tk.Label(card, text="📎", bg=card_bg, fg="#111b21", font=("Segoe UI Emoji",17)).pack(side=tk.LEFT, padx=(10,6), pady=8)
                        info = tk.Frame(card, bg=card_bg)
                        info.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, pady=7)
                        tk.Label(info, text=ad, bg=card_bg, fg="#111b21", font=("Segoe UI",9,"bold"), anchor="w").pack(fill=tk.X)
                        tk.Label(info, text=self._dosya_boyutu_metin(boyut), bg=card_bg, fg="#667781", font=("Segoe UI",8), anchor="w").pack(fill=tk.X)
                        actions = tk.Frame(card, bg=card_bg)
                        actions.pack(side=tk.RIGHT, padx=6, pady=5)
                        tk.Button(actions, text="Aç", bg=card_bg, fg="#00a884", activebackground=card_bg, activeforeground="#008f72", bd=0, relief=tk.FLAT, font=("Segoe UI",8,"bold"), command=lambda data=dosya:self._dosya_ekini_ac(data), cursor="hand2").pack(side=tk.LEFT, padx=3)
                        tk.Button(actions, text="İndir", bg=card_bg, fg="#54656f", activebackground=card_bg, activeforeground="#111b21", bd=0, relief=tk.FLAT, font=("Segoe UI",8,"bold"), command=lambda data=dosya:self._dosya_ekini_indir(data), cursor="hand2").pack(side=tk.LEFT, padx=3)

                    if aciklama:
                        rich = self._mesaj_zengin_icerik_olustur(
                            content, aciklama,
                            bg="#d9fdd3" if ben else "#ffffff", fg="#111b21",
                            max_width=max(240, min(560, int(max(320, self.ms_canvas.winfo_width() or 900) * 0.68))),
                            emoji_size=20,
                        )
                        rich.pack(fill=tk.X, pady=(5,0))
                else:
                    metin = str(kayit["metin"])
                    emoji_tokens = sorted(set(self._emoji_listesi()), key=len, reverse=True)
                    emoji_var = any(e in metin for e in emoji_tokens)
                    mention_var = self._mesaj_etiket_var(metin)
                    if emoji_var or mention_var:
                        rich = self._mesaj_zengin_icerik_olustur(
                            content,
                            metin,
                            bg="#d9fdd3" if ben else "#ffffff",
                            fg="#111b21",
                            max_width=max(240, min(560, int(max(320, self.ms_canvas.winfo_width() or 900) * 0.68))),
                            emoji_size=22,
                        )
                        rich.pack(anchor="e" if ben else "w")
                    else:
                        lines = metin.splitlines() or [""]
                        fnt = tkfont.Font(family="Segoe UI", size=10)
                        canvas_w = max(320, int(self.ms_canvas.winfo_width() or 900))
                        max_bubble_px = max(260, min(620, int(canvas_w * 0.72)))
                        natural_px = max((fnt.measure(line) for line in lines), default=fnt.measure(metin))
                        wrap_needed = natural_px > max_bubble_px or len(lines) > 1
                        lbl = tk.Label(
                            content, text=metin,
                            bg="#d9fdd3" if ben else "#ffffff", fg="#111b21",
                            font=("Segoe UI", 10), justify="left", anchor="nw",
                            wraplength=max_bubble_px if wrap_needed else 0,
                            padx=0, pady=0, bd=0,
                        )
                        lbl.pack(anchor="e" if ben else "w")

                footer = tk.Frame(bubble, bg="#d9fdd3" if ben else "#ffffff")
                footer.pack(fill=tk.X, padx=10, pady=(2,4))
                if kayit["duzenlendi"]:
                    tk.Label(footer, text="düzenlendi", bg="#d9fdd3" if ben else "#ffffff", fg="#667781", font=("Segoe UI",7)).pack(side=tk.RIGHT,padx=(0,7))
                if kayit.get("pending"):
                    tick_text, tick_color = "◷", "#8696a0"
                else:
                    tick_text, tick_color = self._mesaj_tick_metin(kayit)
                tick = tk.Label(footer, text=tick_text, bg="#d9fdd3" if ben else "#ffffff", fg=tick_color, font=("Segoe UI Symbol",8,"bold"))
                tick.pack(side=tk.RIGHT,padx=(4,0))
                if ben:
                    self._chat_tick_widgets[m.id] = tick
                    tk.Label(footer, text=zaman_dt.strftime("%H:%M"), bg="#d9fdd3", fg="#667781", font=("Segoe UI",7)).pack(side=tk.RIGHT)
                    if not kayit.get("silindi"):
                        tk.Button(footer, text="✎", bg="#d9fdd3", fg="#667781", activebackground="#d9fdd3", activeforeground="#111b21", bd=0, relief=tk.FLAT, font=("Segoe UI Symbol",9), command=lambda mid=m.id, txt=kayit["metin"]: self._mesaj_duzenle_penceresi(mid,txt)).pack(side=tk.LEFT)
                else:
                    tk.Label(footer, text=zaman_dt.strftime("%H:%M"), bg="#ffffff", fg="#667781", font=("Segoe UI",7)).pack(side=tk.RIGHT)

                # Sağ tık; balonun ve içindeki tüm child widget'ların üzerinde çalışır.
                self._mesaj_sag_tik_bind(row, kayit)

        self.ms_inner = new_inner
        self.ms_canvas_window = new_item
        try:
            self.ms_canvas.itemconfigure(new_item, state="normal")
            self.ms_canvas.update_idletasks()
            self._chat_scrollregion_guncelle()

            # Tek Canvas sahnesi: eski sohbeti gizlemek yerine tamamen kaldır.
            # Böylece eski sahnenin image/thread callback'leri ortak scrollregion'ı
            # değiştiremez.
            if old_item is not None and old_item != new_item:
                try:
                    self.ms_canvas.delete(old_item)
                except Exception:
                    pass
            if old_inner is not None and old_inner is not new_inner:
                try:
                    old_inner.destroy()
                except Exception:
                    pass

            # Arama/odak için daha sonra özel konumlandırma yapılabilir; normal
            # sohbet açılışında her zaman son mesaja git.
            should_follow_tail = bool(target_changed or (at_bottom and getattr(self, "_chat_follow_tail", True)))
            if should_follow_tail:
                self._chat_scroll_cache[target] = 1.0
                self.root.after_idle(lambda: self.ms_canvas.yview_moveto(1.0))
                self.root.after(35, lambda: self.ms_canvas.yview_moveto(1.0))
            else:
                try:
                    new_bbox = self.ms_canvas.bbox(self.ms_canvas_window)
                    new_total_h = max(1, (new_bbox[3] - new_bbox[1]) if new_bbox else 1)
                    view_h = max(1, self.ms_canvas.winfo_height())
                    if getattr(self, "_chat_scroll_preserve_mode", "normal") == "prepend":
                        eklenen_ust = max(0, new_total_h - old_total_h)
                        hedef_px = old_scroll_px + eklenen_ust
                    else:
                        # Yeni mesaj/fotoğraf aşağıya eklendiğinde okuduğun yeri
                        # yukarı/aşağı itme; yalnızca gerçekten en alttaysan sona git.
                        hedef_px = old_scroll_px
                    frac = max(0.0, min(1.0, hedef_px / max(1, new_total_h - view_h)))
                except Exception:
                    frac = old_y
                self._chat_scroll_cache[target] = frac
                self.root.after_idle(lambda yy=frac: self.ms_canvas.yview_moveto(yy))

            # Cache artık yalnızca aktif sahneyenin referansını tutar.
            self._chat_scene_cache.clear()
            self._chat_scene_cache[target] = {
                "signature": base_signature,
                "inner": new_inner,
                "item": new_item,
                "ticks": dict(self._chat_tick_widgets),
                "image_refs": scene_image_refs,
            }
            self._chat_current_target = target
        except Exception:
            pass
        finally:
            self._chat_scroll_preserve_mode = "normal"
            self._chat_rendering = False

        self._chat_composer_garantile()
        if should_follow_tail or self._chat_kullanici_altta_mi():
            self._mesaj_okundu_isaretle(gorunumler)
        self._chat_tail_butonu_guncelle()

    def _chat_eski_sahneyi_sil(self, item_id, frame):
