    def _emoji_font_yolu(self):
        adaylar = [
            Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts" / "seguiemj.ttf",
            Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts" / "Segoe UI Emoji.ttf",
        ]
        for p in adaylar:
            if p.exists():
                return p
        return None

    def _emoji_gorseli_getir(self, emoji: str, boyut: int = 24):
        """Yerel renkli emoji asset'ini kullanır; fallback olarak Windows emoji fontunu dener."""
        key = (str(emoji), int(boyut))
        cache = getattr(self, "_emoji_cache", {})
        if key in cache:
            return cache[key]

        try:
            yol = _emoji_asset_yolu(emoji)
            if yol.exists():
                with Image.open(yol) as im:
                    im = im.convert("RGBA")
                    # Asset'ler 48px'tir; panel/chat boyutuna hızlı ve deterministik küçült.
                    im.thumbnail((int(boyut), int(boyut)), Image.Resampling.LANCZOS)
                    photo = ImageTk.PhotoImage(im.copy())
                cache[key] = photo
                self._emoji_cache = cache
                self._emoji_image_refs.append(photo)
                return photo
        except Exception:
            pass

        # Fallback: sistemde asset bulunmuyorsa mevcut Windows emoji fontu kullanılabilir.
        font_yolu = self._emoji_font_yolu()
        if not font_yolu:
            return None
        try:
            font = ImageFont.truetype(str(font_yolu), max(16, int(boyut * 1.55)))
            bbox = font.getbbox(emoji)
            w = max(1, bbox[2] - bbox[0] + 12)
            h = max(1, bbox[3] - bbox[1] + 12)
            img = Image.new("RGBA", (w, h), (0, 0, 0, 0))
            draw = ImageDraw.Draw(img)
            draw.text((6 - bbox[0], 6 - bbox[1]), emoji, font=font, fill=(255, 255, 255, 255), embedded_color=True)
            scale = min((boyut + 4) / max(1, w), (boyut + 4) / max(1, h), 1.0)
            if scale < 1.0:
                img = img.resize((max(1, int(w * scale)), max(1, int(h * scale))), Image.Resampling.LANCZOS)
            photo = ImageTk.PhotoImage(img)
            cache[key] = photo
            self._emoji_cache = cache
            self._emoji_image_refs.append(photo)
            return photo
        except Exception:
            return None

    def _emoji_paleti_ac(self) -> None:
        """Kaydırılabilir, animasyonlu ve tekrar tıklamayla kapanan emoji popover."""
        mevcut = getattr(self, "_emoji_popup", None)
        if mevcut is not None:
            try:
                if mevcut.winfo_exists():
                    self._emoji_popover_kapat(mevcut)
                    return
            except Exception:
                self._emoji_popup = None

        emojis = self._emoji_listesi()
        pen = tk.Toplevel(self.root)
        self._emoji_popup = pen
        self._emoji_popup_load_generation += 1
        generation = self._emoji_popup_load_generation
        pen.overrideredirect(True)
        pen.withdraw()
        pen.configure(bg="#dfe5e7")
        try:
            pen.transient(self.root)
            pen.attributes("-topmost", True)
        except Exception:
            pass

        shell = tk.Frame(pen, bg="#ffffff", bd=0, highlightthickness=1, highlightbackground="#dfe5e7")
        shell.pack(fill=tk.BOTH, expand=True, padx=1, pady=1)
        top = tk.Frame(shell, bg="#ffffff", height=48)
        top.pack(fill=tk.X, padx=8, pady=(6, 0))
        top.pack_propagate(False)
        tk.Label(top, text="Emojiler", bg="#ffffff", fg="#111b21", font=("Segoe UI", 11, "bold")).pack(side=tk.LEFT, padx=7)
        tk.Label(top, text="Dokun / tıkla • birden fazla seç", bg="#ffffff", fg="#667781", font=("Segoe UI", 8)).pack(side=tk.LEFT, padx=(6, 0))
        close = tk.Button(top, text="×", bg="#ffffff", activebackground="#f0f2f5", fg="#667781", activeforeground="#111b21", bd=0, relief=tk.FLAT, font=("Segoe UI", 17), cursor="hand2", command=lambda: self._emoji_popover_kapat(pen))
        close.pack(side=tk.RIGHT, padx=2)

        wrap = tk.Frame(shell, bg="#ffffff")
        wrap.pack(fill=tk.BOTH, expand=True, padx=8, pady=(1, 8))
        canvas = tk.Canvas(wrap, bg="#ffffff", bd=0, highlightthickness=0, yscrollincrement=2)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sb = tk.Scrollbar(wrap, command=canvas.yview, width=6, bd=0, relief=tk.FLAT, troughcolor="#ffffff", bg="#d7dfe2", activebackground="#aebbc0")
        sb.pack(side=tk.RIGHT, fill=tk.Y)
        canvas.configure(yscrollcommand=sb.set)
        inner = tk.Frame(canvas, bg="#ffffff")
        win = canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda _e: canvas.configure(scrollregion=canvas.bbox("all")))

        def wheel(event):
            try:
                delta = int(-event.delta / 120) or (-1 if event.delta < 0 else 1)
                canvas.yview_scroll(delta * 2, "units")
            except Exception:
                pass
            return "break"

        canvas.bind("<MouseWheel>", wheel)
        inner.bind("<MouseWheel>", wheel)

        # 7 sütun: emojiler okunabilir boyutta; panel kaydırılabilir.
        cols = 7
        buttons = []
        for i, emoji in enumerate(emojis):
            btn = tk.Button(
                inner, text="", bg="#ffffff", activebackground="#eef2f3",
                fg="#111b21", bd=0, relief=tk.FLAT, width=4, height=2,
                font=("Segoe UI Emoji", 20), cursor="hand2", highlightthickness=0,
                command=lambda e=emoji: self._emoji_ekle(e),
            )
            btn.grid(row=i // cols, column=i % cols, padx=2, pady=2, ipadx=3, ipady=2, sticky="nsew")
            btn.bind("<MouseWheel>", wheel)
            buttons.append((btn, emoji))

        for col in range(cols):
            inner.grid_columnconfigure(col, weight=1, minsize=48)

        try:
            bx = self._emoji_button.winfo_rootx()
            by = self._emoji_button.winfo_rooty()
            bh = self._emoji_button.winfo_height()
            x = max(8, bx - 92)
            target_y = by - 395
            if target_y < 8:
                target_y = by + bh + 8
        except Exception:
            x, target_y = 40, 40

        target_w, target_h = 438, 444
        pen.geometry(f"{target_w}x1+{x}+{target_y+target_h//2}")
        pen.deiconify()

        def animate(height=1):
            try:
                if generation != self._emoji_popup_load_generation or not pen.winfo_exists():
                    return
                if height >= target_h:
                    pen.geometry(f"{target_w}x{target_h}+{x}+{target_y}")
                    return
                next_h = min(target_h, height + max(22, int((target_h - height) * 0.28)))
                y = target_y + (target_h - next_h) // 2
                pen.geometry(f"{target_w}x{next_h}+{x}+{y}")
                pen.after(10, lambda: animate(next_h))
            except Exception:
                pass

        def load_batch(offset=0):
            try:
                if generation != self._emoji_popup_load_generation or not pen.winfo_exists():
                    return
                for btn, emoji in buttons[offset:offset+24]:
                    photo = self._emoji_gorseli_getir(emoji, 34)
                    if photo is not None:
                        btn.configure(image=photo, text="")
                        btn.image = photo
                    else:
                        btn.configure(text=emoji, font=("Segoe UI Emoji", 17))
                nxt = offset + 24
                if nxt < len(buttons):
                    pen.after(1, lambda: load_batch(nxt))
            except Exception:
                pass

        pen.bind("<Destroy>", lambda _e: self._emoji_popup_destroyed(pen), add="+")
        self._emoji_global_bind_id = self.root.bind_all("<Button-1>", self._emoji_disaridan_tiklama, add="+")
        self._emoji_escape_bind_id = self.root.bind_all("<Escape>", lambda _e: self._emoji_popover_kapat(), add="+")
        pen.lift()
        pen.after(1, animate)
        pen.after(1, load_batch)

    def _emoji_popup_destroyed(self, pen) -> None:
        try:
            if self._emoji_popup is pen:
                self._emoji_popup = None
        except Exception:
            pass

    def _emoji_disaridan_tiklama(self, event) -> None:
        pen = getattr(self, "_emoji_popup", None)
        if pen is None:
            return
        try:
            if not pen.winfo_exists():
                return
            widget = self.root.winfo_containing(event.x_root, event.y_root)
            if widget is None:
                self._emoji_popover_kapat(pen)
                return
            w = widget
            while w is not None:
                if w == pen:
                    return
                try:
                    w = w.master
                except Exception:
                    break
            self._emoji_popover_kapat(pen)
        except Exception:
            pass

    def _emoji_popover_kapat(self, pen=None) -> None:
        self._emoji_popup_load_generation += 1
        try:
            bid = getattr(self, "_emoji_global_bind_id", None)
            if bid:
                self.root.unbind_class("all", "<Button-1>", bid)
            bid = getattr(self, "_emoji_escape_bind_id", None)
            if bid:
                self.root.unbind_class("all", "<Escape>", bid)
        except Exception:
            pass
        self._emoji_global_bind_id = None
        self._emoji_escape_bind_id = None
        try:
            target = pen or getattr(self, "_emoji_popup", None)
            if target is not None and target.winfo_exists():
                target.destroy()
        except Exception:
            pass
        self._emoji_popup = None

