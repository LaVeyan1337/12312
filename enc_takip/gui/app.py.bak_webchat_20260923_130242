    def _composer_ctrl_v(self, _event=None):
        """Metin yapıştırmasını Tk'ye bırak; görsel/dosya panosunu ek olarak destekle."""
        # Normal metin: native Tk paste -> sıfır ek gecikme.
        try:
            try:
                text = self.root.clipboard_get()
            except Exception:
                text = None
            if text:
                self.ms_entry.event_generate("<<Paste>>")
                return "break"
        except Exception:
            pass

        # Metin yoksa görsel/dosya panosunu worker'a bırak.
        def worker():
            try:
                clip = ImageGrab.grabclipboard()
                paths = []
                image = None
                if isinstance(clip, (list, tuple)):
                    paths = [str(x) for x in clip if str(x)]
                elif isinstance(clip, Image.Image):
                    image = clip.copy()
                if paths:
                    self.root.after(0, self._dosyalari_onizlemeye_ekle, paths)
                    return
                if image is None:
                    return
                paste_dir = Path(os.environ.get("LOCALAPPDATA") or Path.home()) / "ENÇEV" / "ENCTakip" / "clipboard_paste"
                paste_dir.mkdir(parents=True, exist_ok=True)
                path = paste_dir / f"clipboard_{datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}.png"
                image.save(path, "PNG", optimize=True)
                self.root.after(0, self._dosyalari_onizlemeye_ekle, [str(path)])
            except Exception:
                pass
        threading.Thread(target=worker, daemon=True, name="ENCTakip-ClipboardPaste").start()
        return "break"

