        profil = self._mevcut_kullanici_profili()
        if profil is None:
            messagebox.showwarning("Profil", "Bu bilgisayar için kullanıcı eşleştirmesi bulunamadı.", parent=self.root)
            return
        path = filedialog.askopenfilename(parent=self.root, title="Profil fotoğrafı seç", filetypes=[("Resim", "*.jpg *.jpeg *.png *.webp *.bmp")])
