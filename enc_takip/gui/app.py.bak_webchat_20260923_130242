    def _gunlugu_goster(self) -> None:
        self.gunluk_text.configure(
            state=tk.NORMAL
        )

        self.gunluk_text.delete(
            "1.0",
            tk.END,
        )

        filtre = (
            self.gunluk_filtre_var.get()
            if hasattr(
                self,
                "gunluk_filtre_var",
            )
            else ""
        ).strip().lower()

        kayitlar = self._log_kayitlari_cache

        if filtre:
            kayitlar = [
                k
                for k in kayitlar
                if filtre
                in (
                    f"{k.kullanici} "
                    f"{k.bilgisayar} "
                    f"{k.olay} "
                    f"{k.detay}"
                ).lower()
            ]

        if not kayitlar:
            self.gunluk_text.insert(
                tk.END,
                (
                    "Kayıt bulunamadı."
                    if filtre
                    else "Henüz kayıt yok."
                ),
            )

        for k in kayitlar:
            renk_tag = (
                k.olay
                if k.olay in _LOG_RENK
                else "zaman"
            )

            self.gunluk_text.insert(
                tk.END,
                f"{k.zaman}  ",
                "zaman",
            )

            self.gunluk_text.insert(
                tk.END,
                f"{k.kullanici:<12} ",
                "kul",
            )

            self.gunluk_text.insert(
                tk.END,
                f"{k.olay:<20} ",
                renk_tag,
            )

            self.gunluk_text.insert(
                tk.END,
                f"{k.detay}\n",
            )

        self.gunluk_text.configure(
