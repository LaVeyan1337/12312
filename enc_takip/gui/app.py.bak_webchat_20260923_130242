def _bildirim_ayarlari_yukle() -> dict:
    ayar = dict(_BILDIRIM_AYAR_VARSAYILAN)
    try:
        if _BILDIRIM_AYAR_DOSYASI.exists():
            veri = json.loads(_BILDIRIM_AYAR_DOSYASI.read_text(encoding="utf-8"))
            if isinstance(veri, dict):
                for anahtar in ayar:
                    if anahtar in veri:
                        ayar[anahtar] = bool(veri[anahtar])
    except Exception as exc:
        print(f"[BİLDİRİM AYAR] Okunamadı: {exc}")
    return ayar


def _bildirim_ayarlari_kaydet(ayar: dict) -> bool:
    try:
        _BILDIRIM_AYAR_DOSYASI.parent.mkdir(parents=True, exist_ok=True)
        gecici = _BILDIRIM_AYAR_DOSYASI.with_suffix(".tmp")
        gecici.write_text(json.dumps(ayar, ensure_ascii=False, indent=2), encoding="utf-8")
        gecici.replace(_BILDIRIM_AYAR_DOSYASI)
        return True
    except Exception as exc:
        print(f"[BİLDİRİM AYAR] Kaydedilemedi: {exc}")
        return False


def _kaynak_yolu(dosya_adi: str) -> Path:
    """PyInstaller onefile ve normal çalıştırma için ortak kaynak yolu."""
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS"):
        return Path(sys._MEIPASS) / "assets" / dosya_adi

    return Path(__file__).resolve().parents[2] / "assets" / dosya_adi


def _emoji_asset_adi(emoji: str) -> str:
    return hashlib.sha1(str(emoji).encode("utf-8")).hexdigest() + ".png"


def _emoji_asset_yolu(emoji: str) -> Path:
    # Kaynak çalıştırmada assets enc_takip/assets altında tutulur;
    # eski/alternatif bundle düzenlerinde kök assets fallback'i de destekle.
    adaylar = [
        Path(__file__).resolve().parents[1] / "assets" / "emojis" / _emoji_asset_adi(emoji),
        _kaynak_yolu("emojis") / _emoji_asset_adi(emoji),
    ]
    for yol in adaylar:
        if yol.exists():
            return yol
    return adaylar[0]


class Toast:
    """Modern Windows-style desktop toast; independent from the app window."""

    _aktif_bildirimler = []
    _MAX_TOASTS = 5
    GENISLIK = 390
    KENAR = 18
    ALT = 24
    BOSLUK = 10

    RENKLER = {
        "basari": ("#F2FBF6", "#15803D"),
        "success": ("#F2FBF6", "#15803D"),
        "uyari": ("#FFF9ED", "#B45309"),
        "warning": ("#FFF9ED", "#B45309"),
        "hata": ("#FFF5F5", "#B91C1C"),
        "error": ("#FFF5F5", "#B91C1C"),
        "destructive": ("#FFF5F5", "#B91C1C"),
        "bilgi": ("#F3F8FF", "#1D4ED8"),
        "info": ("#F3F8FF", "#1D4ED8"),
        "primary": ("#F3F8FF", "#1D4ED8"),
        "mesaj": ("#F6F3FF", "#6D28D9"),
        "secondary": ("#F5F7FA", "#475569"),
        "mono": ("#F4F4F5", "#27272A"),
    }

    IKONLAR = {
        "basari": "✓", "success": "✓", "uyari": "!", "warning": "!",
        "hata": "×", "error": "×", "destructive": "×",
        "bilgi": "i", "info": "i", "primary": "i", "mesaj": "•",
        "secondary": "•", "mono": "•",
    }

    def __init__(self, root, baslik, mesaj, tip="bilgi", sure=5000, *,
                 important=False, action=None, cancel=None, progress=True,
                 pause_on_hover=True, position="bottom-end", appearance="solid",
                 size="md", dismiss=True):
        self.root = root
        self.baslik = str(baslik)
        self.mesaj = str(mesaj)
        self.tip = tip if tip in self.RENKLER else "bilgi"
        self.important = bool(important)
        self.duration_ms = max(0, int(sure))
        self.remaining_ms = self.duration_ms
        self.progress_enabled = bool(progress and not self.important and self.duration_ms > 0)
        self.pause_on_hover = bool(pause_on_hover)
        self.action = action
        self.cancel = cancel
        self.position = position
        self.appearance = appearance
        self.size = size
        self.dismiss_enabled = bool(dismiss)
        self.pen = None
        self.progress = None
        self._after_id = None
        self._paused = False
        self._closing = False
        self._last_tick_ms = None
        self.id = f"toast_{id(self)}"
        self._show()

    @classmethod
    def show(cls, root, baslik, mesaj, tip="bilgi", sure=5000, *,
             important=False, action=None, cancel=None, progress=True,
             pause_on_hover=True, position="bottom-end", appearance="solid",
             size="md", dismiss=True):
        return cls(root, baslik, mesaj, tip, sure, important=important,
                   action=action, cancel=cancel, progress=progress,
                   pause_on_hover=pause_on_hover, position=position,
                   appearance=appearance, size=size, dismiss=dismiss)

    def _font(self):
        try:
            return T.FONT
        except Exception:
            return "Segoe UI Variable"

    def _colors(self):
        return self.RENKLER.get(self.tip, self.RENKLER["bilgi"])

    def _height(self):
        h = 88
        if len(self.mesaj) > 70:
            h += 18
        if len(self.mesaj) > 150:
            h += 18
        if self.action is not None or self.cancel is not None:
            h += 42
        return min(185, h)

    def _work_area(self):
        try:
            if os.name == "nt":
                import ctypes
                from ctypes import wintypes
                user32 = ctypes.windll.user32
                hwnd = self.root.winfo_id()
                mon = user32.MonitorFromWindow(hwnd, 2)

                class RECT(ctypes.Structure):
                    _fields_ = [("left", wintypes.LONG), ("top", wintypes.LONG),
                                ("right", wintypes.LONG), ("bottom", wintypes.LONG)]

                class MONITORINFO(ctypes.Structure):
                    _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", RECT),
                                ("rcWork", RECT), ("dwFlags", wintypes.DWORD)]

                mi = MONITORINFO()
                mi.cbSize = ctypes.sizeof(MONITORINFO)
                if mon and user32.GetMonitorInfoW(mon, ctypes.byref(mi)):
                    r = mi.rcWork
                    return int(r.left), int(r.top), int(r.right), int(r.bottom)
        except Exception:
            pass
        try:
            return (0, 0, self.root.winfo_screenwidth(), self.root.winfo_screenheight())
        except Exception:
            return (0, 0, 1280, 720)

    def _toast_rich_mesaj(self, parent, text, bg):
        """Toast metninde yaygın emojileri yerel renkli asset olarak göster."""
        common = [
            "😀","😂","🤣","😊","😇","😍","🥰","😘","😎","🤩","🥳","🤔","😐","😒","😔","😢","😭","😤","😡","🤯","👍","👎","👌","✌️","🤞","👏","🙏","💪","🤝","👋","❤️","🧡","💛","💚","💙","💜","🖤","🤍","🤎","💔","💯","🔥","⭐","✨","⚡","🎉","🎊","✅","❌","⚠️","❗","❓","📌","📎","💡","🌿","🌳","🐾","🦅","☀️","🌧️","☕","🍕","🍔","🎵","🚀","🎯","🏆","🎁"
        ]
        pattern = re.compile("|".join(re.escape(x) for x in sorted(common, key=len, reverse=True)))
        pos = 0
        for match in pattern.finditer(str(text)):
            if match.start() > pos:
                tk.Label(parent, text=str(text)[pos:match.start()], bg=bg, fg="#475569", font=(self._font(),9), anchor="w", justify="left", wraplength=332).pack(side=tk.LEFT)
            photo = self._toast_emoji_photo(match.group(0), 18)
            if photo is not None:
                lab = tk.Label(parent, image=photo, bg=bg, bd=0, padx=0, pady=0)
                lab.image = photo
                lab.pack(side=tk.LEFT, padx=(1,1))
            else:
                tk.Label(parent, text=match.group(0), bg=bg, fg="#475569", font=(self._font(),9)).pack(side=tk.LEFT)
            pos = match.end()
        if pos < len(str(text)):
            tk.Label(parent, text=str(text)[pos:], bg=bg, fg="#475569", font=(self._font(),9), anchor="w", justify="left", wraplength=332).pack(side=tk.LEFT)

    def _toast_emoji_photo(self, emoji, size=18):
        cache = getattr(self, "_toast_emoji_cache", {})
        key = (emoji, int(size))
        if key in cache:
            return cache[key]
        try:
            path = _emoji_asset_yolu(emoji)
            if path.exists():
                with Image.open(path) as im:
                    im = im.convert("RGBA")
                    im.thumbnail((size,size), Image.Resampling.LANCZOS)
                    photo = ImageTk.PhotoImage(im.copy())
                cache[key] = photo
                self._toast_emoji_cache = cache
                return photo
        except Exception:
            pass
        return None

