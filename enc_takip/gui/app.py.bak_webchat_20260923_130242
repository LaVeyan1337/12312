    def _mesaj_receiptleri_getir(self, mesaj_id: str):
        """Lokal cache'teki gerçek teslim/okundu markerlarını kullanıcı ve zamanla döndürür."""
        sonuc = {"delivered": {}, "read": {}}
        try:
            for m in self._mesaj_local_cache.markerleri(mesaj_id):
                kind, data = self._mesaj_marker_coz(m.metin)
                if kind not in ("delivered", "read"):
                    continue
                user = str((data or {}).get("user", "")).strip()
                if not user:
                    continue
                sonuc["read" if kind == "read" else "delivered"][user.casefold()] = {
                    "user": user,
                    "time": str(getattr(m, "zaman", "") or ""),
                }
        except Exception:
            pass
        return sonuc

