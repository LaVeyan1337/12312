    def _word_sahibini_durum_kartina_uygula(self, d=None) -> None:
        """Dışarıdan açılmış Word dosyasının owner bilgisini durum kartına uygular."""
        try:
            durum = getattr(d, "durum", None) if d is not None else None
            durum_adi = str(getattr(durum, "name", durum)).upper()
            if durum_adi not in {"KULLANIMDA_BASKASI", "BELIRSIZ"}:
                return

            sahibi = str(getattr(d, "kullanici", "") or "").strip()
            if not sahibi:
                kilit = getattr(getattr(self, "servis", None), "kilit", None)
                fn = getattr(kilit, "word_kilit_sahibi", None)
                if callable(fn):
                    sahibi = str(fn() or "").strip()

            self.iz_durum_var.set("KULLANIMDA")
            if sahibi:
                detay = "Dosya Word / Windows tarafından kullanımda.\nKullanan: " + sahibi
                bilgisayar = str(getattr(d, "bilgisayar", "") or "").strip()
                if bilgisayar:
                    detay += f"\n{bilgisayar}"
                try:
                    acik_sure = getattr(d, "acik_sure_sn", None)
                    if acik_sure is not None:
                        try:
                            self._dosya_sure_referansi = datetime.now() - timedelta(seconds=max(0, int(acik_sure)))
                        except Exception:
                            self._dosya_sure_referansi = None
                        detay += f"\nAçık süre: {sure_metni(acik_sure)}"
                except Exception:
                    pass
            else:
                detay = "Dosya Word / Windows tarafından kullanımda.\nKullanıcı adı alınamadı."
            self.iz_detay_var.set(detay)
            self.iz_ikon_var.set("●")

            try:
                self.iz_ac_btn.configure(
                    fg_color=T.HATA if durum_adi == "KULLANIMDA_BASKASI" else T.UYARI,
                    text="Dosya Kullanımda",
                )
            except Exception:
                pass
        except Exception as exc:
            print(f"[OWNER GUI] {exc}")

    def _dosya_kullanim_suresi_yenile(self) -> None:
        """Kullanım süresini servis heartbeat/tarama bilgisinden yeniler.

        Böylece ağdaki başka bir kullanıcı dosyayı açık tuttuğunda yerel
        sayaç tahmini yapmak yerine servisin son ölçtüğü gerçek açılış
        süresi kullanılır. GUI'de yalnızca 30 saniyede bir güncellenir.
        """
        try:
            d = getattr(self, "_son_durum", None)
            durum = getattr(getattr(d, "durum", None), "name", "") if d is not None else ""
            if d is not None and durum in {"KULLANIMDA_BASKASI", "BELIRSIZ", "KULLANIMDA_BENDE"}:
                acik_sn = max(0, int(getattr(d, "acik_sure_sn", 0) or 0))
                sahibi = str(getattr(d, "kullanici", "") or "").strip()
                bilgisayar = str(getattr(d, "bilgisayar", "") or "").strip()
                if durum == "KULLANIMDA_BENDE":
                    detay = f"Açık süre: {sure_metni(acik_sn)}\n\nİşiniz bitince 'Kapattım' butonuna basın"
                else:
                    detay = "Dosya Word / Windows tarafından kullanımda."
                    if sahibi:
                        detay += f"\nKullanan: {sahibi}"
                    if bilgisayar:
                        detay += f"\n{bilgisayar}"
                    detay += f"\nAçık süre: {sure_metni(acik_sn)}"
                self.iz_durum_var.set("KULLANIMDA" if durum != "KULLANIMDA_BENDE" else "SİZDE AÇIK")
                self.iz_detay_var.set(detay)
        except Exception:
            pass
        finally:
            try:
                self.root.after(30000, self._dosya_kullanim_suresi_yenile)
            except Exception:
                pass

