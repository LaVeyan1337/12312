    def _composer_ctrl_backspace(self, _event=None):
        """Ctrl+Backspace: solundaki kelimeyi ve bitişik boşlukları tek hamlede sil."""
        try:
            insert = self.ms_entry.index("insert")
            before = self.ms_entry.get("1.0", insert)
            if not before:
                return "break"
            i = len(before)
            while i > 0 and before[i - 1].isspace():
                i -= 1
            while i > 0 and not before[i - 1].isspace():
                i -= 1
            self.ms_entry.delete(f"1.0 + {i} chars", insert)
        except Exception:
            pass
        return "break"

    def _composer_ctrl_delete(self, _event=None):
        """Ctrl+Delete: sağdaki boşluk + kelimeyi sil."""
        try:
            insert = self.ms_entry.index("insert")
            after = self.ms_entry.get(insert, "end-1c")
            i = 0
            while i < len(after) and after[i].isspace():
                i += 1
            while i < len(after) and not after[i].isspace():
                i += 1
            self.ms_entry.delete(insert, f"insert + {i} chars")
        except Exception:
            pass
        return "break"

