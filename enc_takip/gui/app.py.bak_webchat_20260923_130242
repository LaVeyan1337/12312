    def _bildirim_rozetini_guncelle(self) -> None:
        if not hasattr(self, "_bildirim_btn"):
            return

        metin = "Bildirimler"

        if self._okunmamis_bildirim > 0:
            metin += f"  ({self._okunmamis_bildirim})"

        mention_active = any(
            bool(getattr(x, "important", False))
            and not bool(getattr(x, "_closing", False))
            and str(getattr(x, "tip", "")) == "hata"
            for x in getattr(Toast, "_aktif_bildirimler", [])
        )
        try:
            self._bildirim_btn.configure(
                text=metin,
                text_color="#DC2626" if mention_active else T.SB_METIN2,
            )
        except Exception:
            self._bildirim_btn.configure(text=metin)

