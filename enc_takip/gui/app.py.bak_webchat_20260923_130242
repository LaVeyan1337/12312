    def _composer_metin_al(self) -> str:
        """Composer metnini, renkli gömülü emoji görsellerini de koruyarak üretir."""
        try:
            parcalar = []
            for kind, value, _index in self.ms_entry.dump("1.0", "end-1c", text=True, image=True):
                if kind == "text":
                    parcalar.append(value)
                elif kind == "image":
                    parcalar.append(self._composer_emoji_map.get(str(value), ""))
            return "".join(parcalar).strip()
        except Exception:
            try:
                return self.ms_entry.get("1.0", "end-1c").strip()
            except Exception:
                return ""

    def _mention_cache_guncelle(self, force: bool = False) -> None:
        """Mention snapshot'ını yalnızca bellekten alır; yazarken ağ I/O yoktur."""
        try:
            if not force and getattr(self, "_mention_usernames_cache", None):
                return
            profiller = [
                p for p in self._kullanici_rehberi.cache_tumu()
                if p.kullanici_adi.casefold() != KULLANICI.casefold()
            ]
            self._mention_profiles_cache = {p.kullanici_adi.casefold(): p for p in profiller}
            self._mention_usernames_cache = [p.kullanici_adi for p in profiller]
        except Exception:
            self._mention_profiles_cache = {}
            self._mention_usernames_cache = []

    def _mention_kullanici_adlari(self) -> list[str]:
        """Sıcak bellek önbelleğinden mention adaylarını döndürür."""
        self._mention_cache_guncelle(force=False)
        profiller = list(self._mention_profiles_cache.values())
        online_keys = set(getattr(self, "_mention_online_keys", set()))
        profiller.sort(key=lambda p: (p.kullanici_adi.casefold() not in online_keys, p.ad_soyad.casefold()))
        return [p.kullanici_adi for p in profiller]

    def _mention_token(self):
        """Caret'in hemen önündeki @token'ı ve başlangıç indexini döndürür."""
        try:
            text = self.ms_entry.get("1.0", "insert")
            if not text:
                return None, None
            start = len(text)
            while start > 0 and not text[start - 1].isspace():
                start -= 1
            token = text[start:]
            if not token.startswith("@"):
                return None, None
            if len(token) > 64 or "@" in token[1:]:
                return None, None
            if any(ch in token for ch in "\\/,:;!?()[]{}\"'"):
                return None, None
            return token, f"insert-{len(token)}c"
        except Exception:
            return None, None

    def _mention_popup_kapat(self, _event=None):
        try:
            pen = getattr(self, "_mention_popup", None)
            if pen is not None and pen.winfo_exists():
                pen.withdraw()
        except Exception:
            pass
        self._mention_candidates = []
        self._mention_index = 0
        self._mention_popup_usernames = []
        return "break"

    def _mention_sec(self, username: str) -> None:
        try:
            token, start_idx = self._mention_token()
            if not token or not start_idx:
                return
            self.ms_entry.delete(start_idx, "insert")
            self.ms_entry.insert("insert", "@" + username + " ")
            self.ms_entry.focus_set()
        except Exception:
            pass
        finally:
            self._mention_popup_kapat()

    def _mention_popup_goster(self, adaylar):
        """Mention popup'ını tek Toplevel olarak tutar; yalnızca içeriği günceller."""
        adaylar = [str(x).strip() for x in (adaylar or []) if str(x).strip()]
        if not adaylar:
            self._mention_popup_kapat()
            return

        try:
            pen = getattr(self, "_mention_popup", None)
            if pen is None or not pen.winfo_exists():
                pen = tk.Toplevel(self.root)
                self._mention_popup = pen
                pen.overrideredirect(True)
                pen.transient(self.root)
                pen.attributes("-topmost", True)
                shell = tk.Frame(
                    pen, bg="#ffffff", bd=0,
                    highlightthickness=1, highlightbackground="#d9e0e3"
                )
                shell.pack(fill=tk.BOTH, expand=True)
                self._mention_popup_shell = shell
            else:
                shell = self._mention_popup_shell

            # Liste değiştiyse satırları yeniden kur; aynı liste içinde yalnızca seçim değişir.
            usernames = adaylar[:8]
            if usernames != getattr(self, "_mention_popup_usernames", []):
                for child in shell.winfo_children():
                    child.destroy()
                self._mention_popup_rows = {}
                self._mention_popup_avatar_refs = []
                self._mention_popup_usernames = list(usernames)

                self._mention_cache_guncelle(force=False)
                for i, username in enumerate(usernames):
                    profil = self._mention_profiles_cache.get(username.casefold())
                    if profil is None:
                        continue
                    row = tk.Frame(shell, bg="#ffffff", height=52, cursor="hand2")
                    row.pack(fill=tk.X)
                    row.pack_propagate(False)
                    img = self._profil_avatar_gorseli(username, 34)
                    self._mention_popup_avatar_refs.append(img)
                    av = tk.Label(row, image=img, bg="#ffffff", bd=0)
                    av.image = img
                    av.pack(side=tk.LEFT, padx=(8, 8), pady=8)
                    info = tk.Frame(row, bg="#ffffff")
                    info.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, pady=7)
                    tk.Label(
                        info, text=profil.gorunen_ad, bg="#ffffff", fg="#111b21",
                        font=("Segoe UI", 9, "bold"), anchor="w"
                    ).pack(fill=tk.X)
                    tk.Label(
                        info, text=f"@{profil.kullanici_adi}", bg="#ffffff", fg="#667781",
                        font=("Segoe UI", 8), anchor="w"
                    ).pack(fill=tk.X, pady=(1, 0))
                    self._mention_popup_rows[username.casefold()] = row
                    for child in (row, av, info):
                        child.bind("<Button-1>", lambda _e, name=username: self._mention_sec(name))
                    for child in info.winfo_children():
                        child.bind("<Button-1>", lambda _e, name=username: self._mention_sec(name))

            # Online snapshot arka planda yenilenir; popup açılırken UNC okunmaz.
            online_keys = set(getattr(self, "_mention_online_keys", set()))
            for i, username in enumerate(usernames):
                row = self._mention_popup_rows.get(username.casefold())
                if row is None:
                    continue
                selected = i == getattr(self, "_mention_index", 0)
                bg = "#f0f2f5" if selected else "#ffffff"
                row.configure(bg=bg)
                for child in row.winfo_children():
                    child.configure(bg=bg)
                    if isinstance(child, tk.Frame):
                        for sub in child.winfo_children():
                            try: sub.configure(bg=bg)
                            except Exception: pass

            pen.update_idletasks()
            entry_x = self.ms_entry.winfo_rootx()
            entry_y = self.ms_entry.winfo_rooty()
            entry_w = max(280, self.ms_entry.winfo_width())
            entry_h = max(36, self.ms_entry.winfo_height())
            try:
                bbox = self.ms_entry.bbox("insert")
            except Exception:
                bbox = None
            ex = entry_x + int(bbox[0]) if bbox else entry_x + 10
            below_y = entry_y + int(bbox[1] + bbox[3] + 4) if bbox else entry_y + entry_h + 4
            w = max(290, min(390, pen.winfo_reqwidth(), entry_w + 70))
            h = max(52 * len(usernames), pen.winfo_reqheight())
            screen_w = self.root.winfo_screenwidth()
            screen_h = self.root.winfo_screenheight()
            x = max(4, min(screen_w - w - 4, ex - 4))
            y = below_y
            if y + h > screen_h - 48:
                y = max(4, entry_y - h - 4)
            pen.geometry(f"{w}x{h}+{x}+{y}")
            pen.deiconify()
            pen.lift()
        except Exception as exc:
            self._mention_popup_kapat()
            try:
                print(f"[MENTION POPUP] {exc}")
            except Exception:
                pass

    def _mention_iptucu_tetikle(self, _event=None):
        try:
            token, _ = self._mention_token()
            if not token:
                self._mention_popup_kapat()
                return
            query = token[1:].casefold()
            usernames = self._mention_kullanici_adlari()
            if query:
                matched = []
                for username in usernames:
                    profil = self._mention_profiles_cache.get(username.casefold())
                    if profil is None:
                        continue
                    if query in username.casefold() or query in profil.ad_soyad.casefold():
                        matched.append(username)
                usernames = matched
            self._mention_candidates = usernames[:8]
            self._mention_index = 0
            if not self._mention_candidates:
                self._mention_popup_kapat()
                return
            self._mention_popup_goster(self._mention_candidates)
        except Exception:
            self._mention_popup_kapat()

    def _mention_yukari(self, _event=None):
        if not getattr(self, "_mention_candidates", []):
            return None
        self._mention_index = max(0, self._mention_index - 1)
        self._mention_popup_goster(self._mention_candidates)
        return "break"

    def _mention_asagi(self, _event=None):
        if not getattr(self, "_mention_candidates", []):
            return None
        self._mention_index = min(len(self._mention_candidates) - 1, self._mention_index + 1)
        self._mention_popup_goster(self._mention_candidates)
        return "break"

    def _mention_enter_sec(self) -> bool:
        adaylar = getattr(self, "_mention_candidates", [])
        if not adaylar:
            return False
        idx = max(0, min(getattr(self, "_mention_index", 0), len(adaylar) - 1))
        self._mention_sec(adaylar[idx])
        return True

    def _chat_composer_garantile(self) -> None:
        """Render/resize işlemleri composer'ı hiçbir durumda görünmez bırakamaz."""
        try:
            composer = getattr(self, "ms_composer", None)
            right = getattr(self, "_chat_right", None)
            if composer is None or not composer.winfo_exists():
                return
            if right is not None and right.winfo_exists():
                right.grid_rowconfigure(1, weight=1)
                right.grid_rowconfigure(2, weight=0, minsize=max(70, int(composer.cget("height") or 70)))
            info = composer.grid_info()
            if not info:
                composer.grid(row=2, column=0, sticky="ew")
            composer.lift()
            composer.update_idletasks()
        except Exception:
            pass

    def _mesaj_gonder(self) -> None:
        """Mesajı anında UI'da göster; ağ yazımını sıradaki worker'a bırak."""
        metin = self._composer_metin_al()
        ekler = list(getattr(self, "_pending_attachments", []))
        if ekler:
            self._bekleyen_ekleri_gonder_async(metin)
            self.ms_entry.delete("1.0", tk.END)
            self._composer_emoji_map.clear()
            self._composer_emoji_image_refs = []
            return
        if not metin:
            return

        hedef = self.sohbet_hedef
        temp_id = "pending-" + uuid.uuid4().hex
        pending = SimpleNamespace(
            id=temp_id, gonderen=KULLANICI, hedef=hedef, metin=metin,
            zaman=datetime.now().isoformat(timespec="microseconds"),
        )
        self._mesaj_pending.append(pending)
        self._mesaj_data_epoch += 1
        self._mesaj_view_cache.clear()
        self.ms_entry.delete("1.0", tk.END)
        self._composer_emoji_map.clear()
        self._composer_emoji_image_refs = []
        self._emoji_image_refs = []
        self._chat_base_signature = None
        self._mesaj_send_queue.put((temp_id, metin, hedef))
        try:
            self._mesaj_render_planla(0)
        except Exception as exc:
            print(f"[CHAT RENDER] Gönderim sonrası render hatası: {exc}")
        finally:
            self._chat_composer_garantile()

