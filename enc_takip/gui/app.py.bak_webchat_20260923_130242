    def _dosyalari_onizlemeye_ekle(self, yollar) -> None:
        """Seçilen/sürüklenen dosyaları gönderilmeden önce composer'da göster."""
        mevcut = {str(Path(x["path"]).resolve()).casefold() for x in getattr(self, "_pending_attachments", [])}
        for yol in yollar:
            try:
                kaynak = Path(str(yol)).resolve()
                if not kaynak.is_file() or str(kaynak).casefold() in mevcut:
                    continue
                boyut = kaynak.stat().st_size
                if boyut > 100 * 1024 * 1024:
                    self._bildirim_goster("Dosya çok büyük", f"{kaynak.name} 100 MB sınırını aşıyor.", "uyari", 4500)
                    continue
                self._pending_attachments.append({"path": str(kaynak), "name": kaynak.name, "size": boyut})
                mevcut.add(str(kaynak).casefold())
            except OSError:
                continue
        self._attachment_preview_guncelle()

    def _attachment_preview_guncelle(self) -> None:
        frame = getattr(self, "_attachment_preview_frame", None)
        if frame is None:
            return

        self._attachment_preview_serial = getattr(self, "_attachment_preview_serial", 0) + 1
        serial = self._attachment_preview_serial
        for w in frame.winfo_children():
            w.destroy()
        self._attachment_preview_refs = []
        ekler = list(getattr(self, "_pending_attachments", []))
        if not ekler:
            frame.configure(height=0)
            self.ms_composer.configure(height=70)
            return

        frame.configure(height=62)
        self.ms_composer.configure(height=132)

        for idx, veri in enumerate(ekler):
            card = tk.Frame(
                frame,
                bg="#ffffff",
                bd=0,
                highlightthickness=1,
                highlightbackground="#d9e0e3",
            )
            card.pack(
                side=tk.LEFT,
                padx=(2 if idx == 0 else 5, 0),
                pady=3,
                fill=tk.Y,
            )

            suffix = Path(veri["path"]).suffix.lower()
            is_image = suffix in {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".tif", ".tiff"}
            thumb_holder = tk.Frame(card, bg="#eef1f2", width=52, height=52)
            thumb_holder.pack(side=tk.LEFT, padx=(5, 3), pady=4)
            thumb_holder.pack_propagate(False)
            placeholder = tk.Label(
                thumb_holder,
                text="🖼️" if is_image else "📎",
                bg="#eef1f2",
                fg="#667781",
                font=("Segoe UI Emoji", 17),
                bd=0,
            )
            placeholder.pack(expand=True)

            info = tk.Frame(card, bg="#ffffff")
            info.pack(side=tk.LEFT, fill=tk.Y, pady=5)
            tk.Label(
                info,
                text=veri["name"],
                bg="#ffffff",
                fg="#111b21",
                font=("Segoe UI", 8, "bold"),
                anchor="w",
                width=22,
            ).pack(fill=tk.X)
            tk.Label(
                info,
                text=self._dosya_boyutu_metin(veri["size"]),
                bg="#ffffff",
                fg="#667781",
                font=("Segoe UI", 7),
                anchor="w",
            ).pack(fill=tk.X)
            tk.Button(
                card,
                text="×",
                bg="#ffffff",
                activebackground="#f0f2f5",
                fg="#667781",
                bd=0,
                relief=tk.FLAT,
                font=("Segoe UI", 13),
                command=lambda i=idx: self._attachment_sil(i),
            ).pack(side=tk.RIGHT, padx=(2, 4))

            if not is_image:
                continue

            kaynak = Path(veri["path"])

            def worker(ref_source=kaynak, ref_veri=dict(veri), ref_placeholder=placeholder, ref_serial=serial, ref_card=card):
                try:
                    with Image.open(ref_source) as im:
                        try:
                            im.draft("RGB", (64, 64))
                        except Exception:
                            pass
                        if im.mode not in ("RGB", "RGBA"):
                            im = im.convert("RGB")
                        else:
                            im = im.copy()
                        im.thumbnail((50, 50), Image.Resampling.LANCZOS)
                        preview = im.copy()

                    def apply_preview():
                        try:
                            if ref_serial != getattr(self, "_attachment_preview_serial", 0):
                                return
                            if not ref_placeholder.winfo_exists() or not ref_card.winfo_exists():
                                return
                            photo = ImageTk.PhotoImage(preview)
                            self._attachment_preview_refs.append(photo)
                            ref_placeholder.configure(image=photo, text="", bg="#ffffff")
                            ref_placeholder.image = photo
                        except Exception:
                            pass

                    self.root.after(0, apply_preview)
                except Exception:
                    pass

            self._chat_preview_executor.submit(worker)

    def _attachment_sil(self, index: int) -> None:
        try:
            self._pending_attachments.pop(index)
        except (IndexError, AttributeError):
            return
        self._attachment_preview_guncelle()

    def _bekleyen_ekleri_gonder_async(self, caption: str) -> None:
        ekler = list(getattr(self, "_pending_attachments", []))
        if not ekler:
            return
        self._pending_attachments.clear()
        self._attachment_preview_guncelle()

        def worker(items=ekler, aciklama=caption, hedef=self.sohbet_hedef):
            try:
                hedef_klasor = self._mesaj_dosyalari_klasoru()
                for sira_no, item in enumerate(items):
                    kaynak = Path(item["path"])
                    if not kaynak.exists():
                        raise FileNotFoundError(f"Dosya bulunamadı: {kaynak.name}")
                    guvenli = re.sub(r"[^A-Za-z0-9ÇĞİÖŞÜçğıöşü._() \-]", "_", kaynak.name).strip() or "dosya"
                    hedef_dosya = hedef_klasor / f"{datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}_{guvenli}"
                    shutil.copy2(kaynak, hedef_dosya)
                    veri = {
                        "name": kaynak.name,
                        "rel": str(hedef_dosya.relative_to(Path(self.s.sistem_klasoru))),
                        "size": kaynak.stat().st_size,
                        "caption": aciklama if sira_no == 0 else "",
                    }
                    marker = "__ENCTAKIP_FILE__" + json.dumps(veri, ensure_ascii=False, separators=(",", ":"))
                    if not self.servis.mesaj_gonder(marker, hedef):
                        try:
                            hedef_dosya.unlink(missing_ok=True)
                        except Exception:
                            pass
                        raise OSError(f"{kaynak.name} için mesaj kaydı oluşturulamadı.")
                self.kuyruk.put(("MESAJ_EK_GONDERILDI", {"target": hedef}))
            except Exception as exc:
                self.kuyruk.put(("MESAJ_GONDERILEMEDI", {"temp_id": "", "error": str(exc)}))

        threading.Thread(target=worker, daemon=True, name="ENCTakip-EkGonder").start()

    def _bekleyen_ekleri_gonder(self, caption: str) -> bool:
        ekler = list(getattr(self, "_pending_attachments", []))
        if not ekler:
            return False
        try:
            hedef_klasor = self._mesaj_dosyalari_klasoru()
            gonderilen = 0
            for item in ekler:
                kaynak = Path(item["path"])
                if not kaynak.exists():
                    raise FileNotFoundError(f"Dosya bulunamadı: {kaynak.name}")
                guvenli = re.sub(r"[^A-Za-z0-9ÇĞİÖŞÜçğıöşü._() \-]", "_", kaynak.name).strip() or "dosya"
                hedef = hedef_klasor / f"{datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}_{guvenli}"
                shutil.copy2(kaynak, hedef)
                veri = {
                    "name": kaynak.name,
                    "rel": str(hedef.relative_to(Path(self.s.sistem_klasoru))),
                    "size": kaynak.stat().st_size,
                    "caption": caption if gonderilen == 0 else "",
                }
                marker = "__ENCTAKIP_FILE__" + json.dumps(veri, ensure_ascii=False, separators=(",", ":"))
                if not self.servis.mesaj_gonder(marker, self.sohbet_hedef):
                    try: hedef.unlink()
                    except Exception: pass
                    raise OSError(f"{kaynak.name} için mesaj kaydı oluşturulamadı.")
                gonderilen += 1
            self._pending_attachments.clear()
            self._attachment_preview_guncelle()
            self._mesaj_yeni_senkron_baslat()
            return True
        except Exception as exc:
            messagebox.showerror("Dosya Paylaşımı", f"Dosya paylaşılırken hata oluştu:\n{exc}", parent=self.root)
            return False

    def _windows_surukle_birak_kur(self) -> None:
        """Windows WM_DROPFILES ile harici dosyaları doğrudan sohbet penceresine bırakmayı sağlar."""
        if sys.platform != "win32":
            return
        try:
            hwnd = int(self.root.winfo_id())
            user32 = ctypes.windll.user32
            shell32 = ctypes.windll.shell32
            shell32.DragAcceptFiles(hwnd, True)
            WNDPROC = ctypes.WINFUNCTYPE(ctypes.c_longlong, wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM)
            call = user32.CallWindowProcW
            call.argtypes = [ctypes.c_void_p, wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM]
            call.restype = ctypes.c_longlong
            setproc = user32.SetWindowLongPtrW
            setproc.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_void_p]
            setproc.restype = ctypes.c_void_p
            drag_query = shell32.DragQueryFileW
            drag_query.argtypes = [wintypes.HANDLE, wintypes.UINT, wintypes.LPWSTR, wintypes.UINT]
            drag_query.restype = wintypes.UINT
            drag_finish = shell32.DragFinish
            drag_finish.argtypes = [wintypes.HANDLE]
            WM_DROPFILES = 0x0233
            GWLP_WNDPROC = -4

            def proc(h, msg, wparam, lparam):
                try:
                    if msg == WM_DROPFILES:
                        count = drag_query(wparam, 0xFFFFFFFF, None, 0)
                        paths = []
                        for i in range(count):
                            n = drag_query(wparam, i, None, 0)
                            buf = ctypes.create_unicode_buffer(n + 1)
                            drag_query(wparam, i, buf, n + 1)
                            paths.append(buf.value)
                        drag_finish(wparam)
                        if paths:
                            self.root.after(0, self._dosyalari_onizlemeye_ekle, paths)
                        return 0
                except Exception:
                    pass
                return call(self._drop_old_proc, h, msg, wparam, lparam)

            self._drop_proc_ref = WNDPROC(proc)
            self._drop_old_proc = setproc(hwnd, GWLP_WNDPROC, self._drop_proc_ref)
            self._drop_hwnd = hwnd
        except Exception as exc:
            print(f"[DRAG DROP] {exc}")

    def _dosya_ekini_indir(self, veri: dict) -> None:
        """Dosyayı yalnızca kullanıcı isterse yerel bilgisayara kopyalar."""
        try:
            rel = Path(str(veri.get("rel", "")))
            root = Path(self.s.sistem_klasoru).resolve()
            kaynak = (root / rel).resolve()
            if root not in kaynak.parents and kaynak != root:
                raise ValueError("Geçersiz paylaşım yolu.")
            if not kaynak.exists():
                raise FileNotFoundError("Paylaşılan dosya artık bulunamıyor.")

            hedef_klasor = Path(os.environ.get("USERPROFILE") or Path.home()) / "Downloads"
            hedef_klasor.mkdir(parents=True, exist_ok=True)
            ad = str(veri.get("name") or kaynak.name)
            hedef = hedef_klasor / ad
            if hedef.exists():
                hedef = hedef_klasor / f"{hedef.stem} ({datetime.now():%Y%m%d_%H%M%S}){hedef.suffix}"
            shutil.copy2(kaynak, hedef)
            messagebox.showinfo("Dosya İndirildi", f"Dosya İndirilenler klasörüne kaydedildi:\n{hedef}", parent=self.root)
        except Exception as exc:
            messagebox.showerror("Dosya İndirme", f"Dosya indirilemedi:\n{exc}", parent=self.root)

    def _dosya_ekini_ac(self, veri: dict) -> None:
        try:
            rel = Path(str(veri.get("rel", "")))
            root = Path(self.s.sistem_klasoru).resolve()
            hedef = (root / rel).resolve()

            # Paylaşım dışına çıkmayı engelle.
            if root not in hedef.parents and hedef != root:
                raise ValueError("Geçersiz paylaşım yolu.")
            if not hedef.exists():
                raise FileNotFoundError("Paylaşılan dosya artık bulunamıyor.")

            os.startfile(str(hedef))  # type: ignore[attr-defined]

        except Exception as exc:
            messagebox.showerror(
                "Dosya Paylaşımı",
                f"Dosya açılamadı:\n{exc}",
                parent=self.root,
            )

