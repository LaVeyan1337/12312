    def _mesaj_receipt_hedefi(self, m) -> str:
        # Özel mesajda teslim/okundu onayı doğrudan mesajın sahibine gider.
        if m.hedef not in ("ODA_ECED", "ODA_DILEK", "GENEL"):
            if m.gonderen.casefold() != KULLANICI.casefold():
                return m.gonderen
            return m.hedef
        return m.hedef

    def _mesaj_teslim_onayi_gonder(self, m) -> None:
        if m.gonderen.casefold() == KULLANICI.casefold():
            return
        sent = getattr(self, "_chat_delivery_sent", set())
        if m.id in sent:
            return
        self._chat_delivery_sent = sent
        payload = "__ENCTAKIP_DELIVERED__" + json.dumps({"id": m.id, "user": KULLANICI}, ensure_ascii=False)
        self._mesaj_receipt_queue.put((payload, self._mesaj_receipt_hedefi(m), "delivered", str(m.id)))

    def _mesaj_okundu_isaretle(self, gorunumler) -> None:
        sent = getattr(self, "_chat_read_sent", set())
        self._chat_read_sent = sent
        for kayit in gorunumler:
            m = kayit["m"]
            if m.gonderen.casefold() == KULLANICI.casefold():
                continue
            if m.id in sent:
                continue
            # Önce yerel olarak işaretle; ağ yazımı arkada yapılsın.
            sent.add(m.id)
            payload = "__ENCTAKIP_READ__" + json.dumps({"id": m.id, "user": KULLANICI}, ensure_ascii=False)
            self._mesaj_receipt_queue.put((payload, self._mesaj_receipt_hedefi(m), "read", str(m.id)))

    def _mesaj_tick_metin(self, kayit):
        if not kayit["m"].gonderen.casefold() == KULLANICI.casefold():
            return "", "#000000"
        if kayit.get("okundu"):
            return "✓✓", "#53bdeb"
        if kayit.get("teslim_edildi"):
            return "✓✓", "#8696a0"
        return "✓", "#8696a0"

    def _mesaj_receipt_etiketlerini_guncelle(self) -> None:
        if not hasattr(self, "_chat_tick_widgets"):
            return
        try:
            gorunumler = [x for x in self._mesaj_gorunumleri_hazirla() if self._mesaj_gorunumune_uyuyor_mu(x)]
            by_id = {x["m"].id: x for x in gorunumler}
            for mid, widget in list(self._chat_tick_widgets.items()):
                kayit = by_id.get(mid)
                if kayit is None:
                    continue
                metin, renk = self._mesaj_tick_metin(kayit)
                widget.configure(text=metin, fg=renk)
        except Exception:
            pass

