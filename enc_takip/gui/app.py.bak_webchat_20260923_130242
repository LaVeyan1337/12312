    def _sira_button_guncelle(self) -> None:
        try:
            sirada = bool(self.servis.sirada_miyim())
        except Exception:
            sirada = False
        btn = getattr(self, "sira_btn", None)
        if btn is not None:
            try:
                if sirada:
                    fg = T.HATA[0] if isinstance(T.HATA, tuple) else T.HATA
                    hv = T.HATA[1] if isinstance(T.HATA, tuple) and len(T.HATA) > 1 else fg
                    btn.configure(text="Sıradan Çık", fg_color=fg, hover_color=hv, text_color="#FFFFFF")
                else:
                    btn.configure(text="Sıraya Gir", fg_color=T.ANA, hover_color=T.ANA_HOVER, text_color="#FFFFFF")
            except Exception:
                pass
        var = getattr(self, "sira_var", None)
        if var is not None:
            try:
                sira = list(self.servis.sira_listesi())
            except Exception:
                sira = []
            if sirada:
                me = str(globals().get("KULLANICI", "")).casefold()
                try:
                    no = [str(x).casefold() for x in sira].index(me) + 1
                    var.set(f"Sıradasınız • {no}. kişi")
                except Exception:
                    var.set("Sıradasınız")
            elif sira:
                var.set(f"{len(sira)} kişi bekliyor")
            else:
                var.set("Sıra boş")

    def _sira_sana_geldi_popup(self) -> None:
        """Sıra geldiğinde popup yerine doğrudan action/cancel toast göster."""
        if getattr(self, "_sira_popup_acik", False):
            return

        self._sira_popup_acik = True
        try:
            self.root.deiconify()
            self.root.lift()
        except Exception:
            pass

        def ac():
            try:
                self._dosya_ac()
                try:
                    self.servis.siradan_cik()
                except Exception:
                    pass
                try:
                    self._sira_button_guncelle()
                except Exception:
                    pass
                try:
                    self._sira_panel_guncelle()
                except Exception:
                    pass
            finally:
                self._sira_popup_acik = False

        def sonra():
            try:
                self._sira_button_guncelle()
            except Exception:
                pass
            self._sira_popup_acik = False

        self._sira_toast = Toast.show(
            self.root,
            "Dilekçe Sırası",
            "Sıra size geldi — dosya artık müsait.",
            "success",
            0,
            important=True,
            progress=False,
            pause_on_hover=False,
            action=("Dosyayı Aç", ac),
            cancel=("Daha Sonra", sonra),
        )

