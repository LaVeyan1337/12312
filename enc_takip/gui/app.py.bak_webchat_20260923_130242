    def _kuyruk_isle(self) -> None:
        try:
            while True:
                tip, veri = self.kuyruk.get_nowait()
                if tip == "UYARI_HAREKETSIZLIK_TOAST":
                    self._hareketsizlik_tekrar_toast(veri)
                    continue

                if tip == "KULLANICI_REHBER_HAZIR":
                    self._mention_online_keys = set(veri.get("online_keys", set()))
                    self._mention_cache_guncelle(force=True)
                    self._chat_list_signature = None
                    self._durum_panel_guncelle()
                    if hasattr(self, "kisi_container") and self.aktif_sekme == "mesaj":
                        self._kisi_listesini_yukle(force=True)
                    continue

                if tip == "MESAJ_GONDERILDI":
                    temp_id = str(veri.get("temp_id", ""))
                    self._mesaj_pending = [x for x in self._mesaj_pending if str(getattr(x, "id", "")) != temp_id]
                    self._mesaj_data_epoch += 1
                    self._mesaj_view_cache.clear()
                    mesaj = veri.get("message")
                    if mesaj is not None:
                        self._mesaj_cache_ekle(mesaj)
                    self._chat_base_signature = None
                    self._mesaj_render_planla(50)
                    continue

                if tip == "MESAJ_GONDERILEMEDI":
                    temp_id = str(veri.get("temp_id", ""))
                    if temp_id:
                        self._mesaj_pending = [x for x in self._mesaj_pending if str(getattr(x, "id", "")) != temp_id]
                        self._mesaj_data_epoch += 1
                        self._mesaj_view_cache.clear()
                        self._chat_base_signature = None
                        self._mesaj_render_planla(0)
                    self._bildirim_goster("Mesaj gönderilemedi", veri.get("error", "Ağ bağlantısı kurulamadı."), "hata", 5000)
                    continue

                if tip == "MESAJ_EK_GONDERILDI":
                    if self.aktif_sekme == "mesaj":
                        self._chat_base_signature = None
                        self._mesaj_yeni_senkron_baslat()
                    continue

                if tip == "MESAJ_CACHE_HAZIR":
                    self._mesaj_ham_cache = self._mesaj_local_cache.all()
                    self._mesaj_ham_cache_ids = {str(getattr(x, "id", "")) for x in self._mesaj_ham_cache}
                    self._mesaj_ham_cache_hazir = True
                    self._mesaj_sync_hazir = True
                    self._mesaj_data_epoch += 1
                    self._mesaj_view_cache.clear()

                    # Background ağ okuması başarısız olduysa, yalnızca bu ilk
                    # kurulum anında GUI thread'inde tek seferlik kurtarma yap.
                    # Sonraki mesaj güncellemeleri yine queue/cache üzerinden akar.
                    if not self._mesaj_ham_cache and veri.get("fallback"):
                        try:
                            ham = list(self.servis.mesaj_gecmisi_son(1500))
                            self._mesaj_local_cache.upsert_many(ham)
                            self._mesaj_ham_cache = ham
                            self._mesaj_ham_cache_ids = {str(getattr(x, "id", "")) for x in ham}
                        except Exception as exc:
                            print(f"[MESAJ SYNC] GUI fallback başarısız: {exc}")

                    if self.aktif_sekme == "mesaj":
                        self._chat_base_signature = None
                        self._mesajlari_yukle(force=True)

                elif tip == "MESAJ_GECMIS_HAZIR":
                    hedef = veri.get("target") or self.sohbet_hedef
                    if veri.get("complete"):
                        self._chat_history_complete[hedef] = True
                    self._mesaj_ham_cache_hazir = True
                    self._mesaj_data_epoch += 1
                    self._mesaj_view_cache.clear()
                    if self.aktif_sekme == "mesaj" and hedef == self.sohbet_hedef:
                        try:
                            penceredeki = self._mesaj_local_cache.sohbet_mesajlari(hedef, limit=180)
                            if penceredeki:
                                self._chat_oldest_loaded[hedef] = penceredeki[0].zaman
                        except Exception:
                            pass
                        self._chat_base_signature = None
                        self._chat_scroll_preserve_mode = "prepend"
                        self._mesajlari_yukle(force=True)

                elif tip == "MESAJ_SOHBET_ARAMA_HAZIR":
                    if veri.get("serial") != getattr(self, "_chat_local_search_serial", 0):
                        continue
                    if str(veri.get("target")) != str(self.sohbet_hedef):
                        continue
                    results = veri.get("results") or []
                    # Server sonucu authoritative olsun; markerlar gösterilmez.
                    temiz = [m for m in results if self._mesaj_marker_coz(str(getattr(m, "metin", "") or ""))[0] is None]
                    self._mesaj_local_cache.upsert_many(temiz)
                    self._chat_local_search_results = list(temiz)
                    self._chat_local_search_index = 0 if temiz else -1
                    self._chat_local_search_focus_id = str(temiz[0].id) if temiz else None
                    self._sohbet_ici_arama_sayac_guncelle()
                    if self.aktif_sekme == "mesaj":
                        self._chat_base_signature = None
                        self._mesajlari_yukle(force=True)
                        if temiz:
                            self.root.after_idle(lambda mid=str(temiz[0].id): self._sohbet_ici_arama_mesaja_git(mid))

                elif tip == "MESAJ_ARAMA_HAZIR":
                    self._chat_server_search_pending = False
                    if veri.get("serial") != getattr(self, "_chat_server_search_serial", 0):
                        continue
                    results = veri.get("results") or []
                    self._chat_search_results = list(results)
                    self._chat_search_index = 0 if results else -1
                    if results:
                        self._mesaj_local_cache.upsert_many(results)
                    self._chat_search_server_targets = {
                        str(x.hedef) for x in results
                    }
                    for x in results:
                        if str(x.hedef) == KULLANICI:
                            self._chat_search_server_targets.add(str(x.gonderen))
                    if self.aktif_sekme == "mesaj":
                        self._kisi_listesini_yukle(force=True)
                        self._mesaj_arama_nav_guncelle()
                        self._chat_base_signature = None
                        self._mesajlari_yukle(force=True)

                elif tip == "DURUM":
                    self._son_durum = veri
                    self._durum_goster(veri)
                    self._word_sahibini_durum_kartina_uygula(veri)

                    if self.aktif_sekme == "mesaj":
                        self._kisi_listesini_yukle(force=False)

                    if self.aktif_sekme == "izleme":
                        self._sira_gostergesini_guncelle()

                elif tip == "HATA":
                    self.sb_durum_var.set("Hata")
                    self.sb_ikon.configure(text_color=r(T.HATA))

                elif tip == "OLAY":
                    self._olay_bildirimi(veri)

                elif tip == "YENI_MESAJ":
                    self._yeni_mesaj_geldi(veri)

                elif tip == "UYARI_HAREKETSIZLIK":
                    self._hareketsizlik_uyarisi_goster(
                        veri
                    )

        except queue.Empty:
            pass

        if self.root.winfo_exists():
            self.root.after(
                150,
                self._kuyruk_isle,
            )

    def _olay_bildirimi(
        self,
        olay: dict,
    ) -> None:
        tip_ham = olay.get(
            "tip",
            "",
        )

        if tip_ham == "acildi" and not self._bildirim_ayarlari.get("dosya_acildi", True):
            return


        baslik, tip = _OLAY_TOAST.get(
            tip_ham,
            (
                olay.get(
                    "msg",
                    "",
                ),
                "bilgi",
            ),
        )

        self._bildirim_goster(
            baslik,
            olay.get("msg", ""),
            tip,
            8000,
        )

    def _mention_bildirimi(self, gonderen: str, metin: str, hedef: str, mesaj_id: str) -> None:
        """@mention için görev çubuğunun hemen üstünde kalan kalıcı kırmızı toast."""
        try:
            def sohbet_ac():
                self.aktif_sekme = "mesaj"
                hedef_local = hedef
                self._chat_search_focus_id = str(mesaj_id)
                try:
                    self._chat_focus_timestamp[hedef_local] = ""
                except Exception:
                    pass
                self._sohbet_sec(hedef_local, hedef_local)
                self._chat_base_signature = None
                self._mesajlari_yukle(force=True)
                self.root.after(140, lambda mid=str(mesaj_id): self._mesaj_arama_mesaja_git(mid))

            # Important toast süresizdir; yalnızca X veya "Mesaja git" ile kapanır.
            Toast.show(
                self.root,
                f"@{KULLANICI} etiketlendi",
                f"{gonderen}: {metin[:150]}",
                "hata",
                0,
                important=True,
                action=("Mesaja git", sohbet_ac),
                progress=False,
                pause_on_hover=False,
                position="bottom-end",
                dismiss=True,
            )

            self._bildirim_gecmisi.insert(0, {
                "zaman": datetime.now(),
                "baslik": f"@{KULLANICI} etiketlendi",
                "mesaj": f"{gonderen}: {metin[:150]}",
                "tip": "mention",
                "mention": True,
                "mesaj_id": str(mesaj_id),
                "hedef": hedef,
            })
            del self._bildirim_gecmisi[_BILDIRIM_GECMISI_AZAMI:]
            self._okunmamis_bildirim += 1
            self._bildirim_rozetini_guncelle()
            self._ses_calar("hata")
        except Exception as exc:
            print(f"[MENTION BILDIRIM] {exc}")


    def _yeni_mesaj_geldi(self, m) -> None:
        # Kuyruktan gelen kayıt artık veri kaynağının kendisi: GUI'nin yeniden
        # ağ klasörünü taramasına gerek yok. Önce yerel cache'e ekle, sonra UI'yı
        # yalnızca gerçekten değişen sohbet için güncelle.
        self._mesaj_cache_ekle(m)
        marker_kind, marker_data = self._mesaj_marker_coz(m.metin)

        if marker_kind in ("edit", "delete", "delivered", "read"):
            if marker_kind in ("edit", "delete") and self.aktif_sekme == "mesaj":
                self._mesajlari_yukle(force=True)
            elif marker_kind in ("delivered", "read") and self.aktif_sekme == "mesaj":
                self._mesaj_receipt_etiketlerini_guncelle()
            self._menu_rozet_guncelle()
            return

        if m.gonderen == SISTEM_GONDEREN:
            self._bildirim_goster("Sistem Bildirimi", m.metin, "sistem_mesaj", 10000)
            if self.aktif_sekme == "izleme" and hasattr(self, "sira_panel_container"):
                self._sira_panel_guncelle()
            if self.aktif_sekme == "mesaj":
                self._mesaj_render_planla(25)
            return

        self._mesaj_teslim_onayi_gonder(m)
        mention_source = str(m.metin or "")
        if marker_kind == "file" and marker_data:
            mention_source = str(marker_data.get("caption") or "")
        mention = bool(
            m.gonderen.casefold() != KULLANICI.casefold()
            and re.search(
                r"@" + re.escape(KULLANICI) + r"(?![A-Za-z0-9_.-])",
                mention_source,
                re.IGNORECASE,
            )
        )
        mesaj_on_yazi=m.metin
        if marker_kind=="file" and marker_data:
            mesaj_on_yazi=f"📎 {marker_data.get('name','Dosya')}"

        if m.hedef in ("ODA_ECED","ODA_DILEK","GENEL"):
            oda=m.hedef
            acik=self.aktif_sekme=="mesaj" and self.sohbet_hedef==oda
            try:
                aktif_altta = acik and self._chat_kullanici_altta_mi()
            except Exception:
                aktif_altta = False
            if (not acik or not aktif_altta) and oda in getattr(self,"okunmayan_odalar",{}):
                self.okunmayan_odalar[oda]=self.okunmayan_odalar.get(oda,0)+1
            oda_adi={"ODA_ECED":"EÇED KOD","ODA_DILEK":"DİLEKÇELER","GENEL":"Genel Sohbet"}[oda]
            if mention:
                self._mention_bildirimi(m.gonderen, mention_source or mesaj_on_yazi, m.gonderen, str(m.id))
            else:
                self._bildirim_goster(f"{oda_adi} • {m.gonderen}",mesaj_on_yazi[:90],"mesaj",8000)
        elif m.hedef == KULLANICI:
            try:
                aktif_ozel = self.aktif_sekme=="mesaj" and self.sohbet_hedef==m.gonderen
                aktif_altta = aktif_ozel and self._chat_kullanici_altta_mi()
            except Exception:
                aktif_altta = False
            if not aktif_altta:
                self.okunmayan_ozel[m.gonderen]=self.okunmayan_ozel.get(m.gonderen,0)+1
            if mention:
                self._mention_bildirimi(m.gonderen, mention_source or mesaj_on_yazi, m.hedef, str(m.id))
            else:
                self._bildirim_goster(f"{m.gonderen} — Özel",mesaj_on_yazi[:90],"mesaj",8000)

        if self.aktif_sekme=="mesaj":
            try:
                if m.hedef in ("ODA_ECED", "ODA_DILEK", "GENEL"):
                    aktif_sohbet = self.sohbet_hedef == m.hedef
                else:
                    aktif_hedef = m.hedef if m.gonderen.casefold() == KULLANICI.casefold() else m.gonderen
                    aktif_sohbet = self.sohbet_hedef == aktif_hedef
                if aktif_sohbet:
                    altta = self._chat_kullanici_altta_mi()
                    kendi_mesajim = m.gonderen.casefold() == KULLANICI.casefold()
                    if altta or kendi_mesajim:
                        self._chat_follow_tail = True
                        self._chat_new_message_count = 0
                    else:
                        self._chat_follow_tail = False
                        self._chat_new_message_count = int(getattr(self, "_chat_new_message_count", 0) or 0) + 1
            except Exception:
                pass
            self._mesaj_render_planla(50)
            self._mesaj_oda_rozetlerini_guncelle()
            self.root.after_idle(self._chat_tail_butonu_guncelle)
        self._menu_rozet_guncelle()

