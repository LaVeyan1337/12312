    def _mesaj_arama_gezin(self, adim: int) -> None:
        results = getattr(self, "_chat_search_results", []) or []
        if not results:
            return
        self._chat_search_index = (getattr(self, "_chat_search_index", 0) + adim) % len(results)
        self._mesaj_arama_nav_guncelle()
        self._mesaj_arama_sonuc_sec(self._chat_search_index)

    def _mesaj_arama_sonuc_sec(self, index: int) -> None:
        results = getattr(self, "_chat_search_results", []) or []
        if not results or index < 0 or index >= len(results):
            return
        m = results[index]
        hedef = str(m.hedef)
        if hedef == KULLANICI:
            hedef = str(m.gonderen)
        self._chat_search_index = index
        self._chat_search_focus_id = str(m.id)
        self._chat_focus_timestamp[hedef] = str(m.zaman)
        self._sohbet_sec(hedef, hedef)
        self._chat_base_signature = None
        self._mesajlari_yukle(force=True)
        self.root.after(120, lambda mid=str(m.id): self._mesaj_arama_mesaja_git(mid))

    def _mesaj_arama_mesaja_git(self, mesaj_id: str) -> None:
        """Arama sonucunu sohbet viewportunun mümkün olduğunca tam ortasına alır."""
        self._mesaj_arama_mesaji_ortala(mesaj_id)

    def _mesaj_arama_mesaji_ortala(self, mesaj_id: str) -> bool:
        """Mesaj balonunu viewport'un tam merkezine getirir.

        Tk widget geometrisi render anında henüz kesinleşmemiş olabildiği için
        çağrı yalnızca tek bir idle turuna bırakılmaz; üst çağrı bunu birkaç
        tur boyunca tekrar deneyebilir. Scroll yüzdesi yerine gerçek Canvas
        koordinatları kullanılır."""
        try:
            self.ms_canvas.update_idletasks()
            self.ms_inner.update_idletasks()
            canvas_h = max(1, self.ms_canvas.winfo_height())
            bbox = self.ms_canvas.bbox("all")
            if not bbox:
                return False
            top, bottom = float(bbox[1]), float(bbox[3])
            content_h = max(1.0, bottom - top)
            viewport_h = float(canvas_h)
            for row in self.ms_inner.winfo_children():
                if str(getattr(row, "_enctakip_mesaj_id", "")) != str(mesaj_id):
                    continue
                y = float(row.winfo_y())
                h = float(max(1, row.winfo_height()))
                # Canvas scrollregion içindeki hedef merkez.
                desired_top = y + (h / 2.0) - (viewport_h / 2.0)
                max_top = max(0.0, content_h - viewport_h)
                desired_top = max(0.0, min(max_top, desired_top))
                frac = desired_top / max_top if max_top > 0 else 0.0
                self.ms_canvas.yview_moveto(frac)
                self._chat_scroll_cache[self.sohbet_hedef] = frac
                return True
        except Exception:
            pass
        return False

    def _sohbet_ici_arama_ac(self) -> None:
        try:
            self.ms_header_title_label.place_forget()
            self.ms_header_alt_label.place_forget()
            self._chat_local_search_frame.place(relx=1.0, x=-92, y=5, relwidth=0.62, width=-105, height=66, anchor="ne")
            self._chat_local_search_entry.delete(0, tk.END)
            self._chat_local_search_entry.focus_set()
            self._chat_local_search_entry.select_range(0, tk.END)
            self._chat_local_search_results = []
            self._chat_local_search_index = -1
            self._chat_local_search_focus_id = None
            self._mesajlari_yukle(force=True)
        except Exception:
            pass

    def _sohbet_ici_arama_kapat(self) -> None:
        try:
            if self._chat_local_search_after_id:
                self.root.after_cancel(self._chat_local_search_after_id)
        except Exception:
            pass
        self._chat_local_search_after_id = None
        self._chat_local_search_serial += 1
        self._chat_local_search_query = ""
        self._chat_local_search_results = []
        self._chat_local_search_index = -1
        self._chat_local_search_focus_id = None
        try:
            self._chat_local_search_frame.place_forget()
            self.ms_header_title_label.place(x=73, y=16)
            self.ms_header_alt_label.place(x=73, y=39)
            self._mesajlari_yukle(force=True)
        except Exception:
            pass

    def _sohbet_ici_arama_tetikle(self) -> None:
        q = self._chat_local_search_entry.get().strip().casefold()
        self._chat_local_search_query = q
        self._chat_local_search_serial += 1
        token = self._chat_local_search_serial
        try:
            if self._chat_local_search_after_id:
                self.root.after_cancel(self._chat_local_search_after_id)
        except Exception:
            pass
        if not q:
            self._chat_local_search_results = []
            self._chat_local_search_index = -1
            self._chat_local_search_focus_id = None
            self._sohbet_ici_arama_sayac_guncelle()
            self._mesajlari_yukle(force=True)
            return
        # Kullanıcı yazarken HİÇBİR sorgu çalıştırma. Önceki sürümde burada
        # lokal cache'i hemen taramak bile yüz binlerce kaydı ana Tk thread'inde
        # filtreleyebildiği için yazarken takılmaya neden oluyordu.
        # Kullanıcı yazmayı bıraktıktan sonra tek kez çalıştır.
        self._chat_local_search_after_id = self.root.after(450, lambda: self._sohbet_ici_arama_baslat(q, token))

    def _sohbet_ici_arama_baslat(self, q: str, token: int) -> None:
        if token != self._chat_local_search_serial or q != self._chat_local_search_query:
            return
        self._chat_local_search_after_id = None
        # Önce lokal cache'ten sonucu oluştur. Ağ taraması bunun ardından
        # aynı sorgu için arka planda çalışır.
        self._sohbet_ici_arama_lokal(q)
        self._sohbet_ici_arama_server(q, token)

    def _sohbet_ici_arama_lokal(self, q: str) -> None:
        try:
            hedef = self.sohbet_hedef
            # SQLite sorgusu yalnızca eşleşen satırları getirir; 100.000 kaydı
            # Python tarafına taşımıyoruz.
            rows = self._mesaj_local_cache.sohbet_ici_ara(hedef, q, limit=5000)
            self._chat_local_search_results = [m for m in rows if self._mesaj_marker_coz(str(m.metin or ""))[0] is None]
            self._chat_local_search_index = 0 if self._chat_local_search_results else -1
            self._chat_local_search_focus_id = str(self._chat_local_search_results[0].id) if self._chat_local_search_results else None
            self._sohbet_ici_arama_sayac_guncelle()
            self._mesajlari_yukle(force=True)
            if self._chat_local_search_results:
                self.root.after_idle(lambda: self._sohbet_ici_arama_mesaja_git(self._chat_local_search_results[0].id))
        except Exception:
            pass

    def _sohbet_ici_arama_server(self, q: str, token: int) -> None:
        if token != self._chat_local_search_serial or q != self._chat_local_search_query:
            return
        hedef = self.sohbet_hedef
        def worker():
            try:
                results = self.servis.mesaj_ara_sohbet(q, hedef, 5000)
                self.kuyruk.put(("MESAJ_SOHBET_ARAMA_HAZIR", {"results": results, "target": hedef, "serial": token}))
            except Exception:
                self.kuyruk.put(("MESAJ_SOHBET_ARAMA_HAZIR", {"results": [], "target": hedef, "serial": token}))
        threading.Thread(target=worker, name="ENCTakip-ChatSearch", daemon=True).start()

    def _sohbet_ici_arama_sayac_guncelle(self) -> None:
        try:
            rs = self._chat_local_search_results or []
            if not rs:
                self._chat_local_search_count.configure(text="")
            else:
                self._chat_local_search_count.configure(text=f"{self._chat_local_search_index + 1}/{len(rs)}")
        except Exception:
            pass

    def _sohbet_ici_arama_gezin(self, adim: int) -> None:
        rs = self._chat_local_search_results or []
        if not rs:
            return
        self._chat_local_search_index = (self._chat_local_search_index + adim) % len(rs)
        m = rs[self._chat_local_search_index]
        self._chat_local_search_focus_id = str(m.id)
        self._sohbet_ici_arama_sayac_guncelle()
        self._mesajlari_yukle(force=True)
        self.root.after(0, lambda mid=str(m.id): self._sohbet_ici_arama_mesaja_git(mid))

    def _sohbet_ici_arama_mesaja_git(self, mesaj_id: str, deneme: int = 0) -> None:
        """Seçilen arama sonucunu gerçekten ortalar; geometri hazır değilse
        birkaç kısa tur boyunca tekrar dener. Her ↑/↓ geçişi kendi sonucuna
        ayrı ayrı uygulanır."""
        try:
            if self._mesaj_arama_mesaji_ortala(mesaj_id):
                return
            if deneme < 6:
                gecikme = (0, 25, 60, 120, 220, 400)[deneme]
                self.root.after(gecikme, lambda mid=str(mesaj_id), n=deneme + 1: self._sohbet_ici_arama_mesaja_git(mid, n))
                return
            # Hâlâ bulunamadıysa arama sonucunun çevresindeki geçmiş penceresini
            # kur ve geometri tamamlandıktan sonra yeniden dene.
            for m in self._chat_local_search_results:
                if str(m.id) == str(mesaj_id):
                    self._chat_focus_timestamp[self.sohbet_hedef] = str(m.zaman)
                    self._mesajlari_yukle(force=True)
                    self.root.after(60, lambda mid=str(mesaj_id): self._sohbet_ici_arama_mesaja_git(mid))
                    return
        except Exception:
            pass

    def _mesaj_sohbet_ara(self) -> None:
        try:
            q = self.ms_search_entry.get().strip()
            if q == getattr(self, "_chat_search_placeholder", "Ara veya yeni sohbet başlat"):
                q = ""
            self._chat_search_filter = q.casefold()
            # Boşaltıldığı anda arama sonuçlarını temizle ve normal sohbet
            # listesini hemen geri getir. FocusOut beklemiyoruz; kullanıcı
            # arama kutusundayken Backspace ile de temizleyebilmelidir.
            if not q:
                self._chat_search_server_targets = set()
                self._chat_search_results = []
                self._chat_search_index = -1
                self._chat_search_focus_id = None
                self._chat_focus_timestamp = {}
                self._chat_server_search_pending = False
                pending = getattr(self, "_chat_search_after_id", None)
                if pending:
                    try:
                        self.root.after_cancel(pending)
                    except Exception:
                        pass
                    self._chat_search_after_id = None
                self._kisi_listesini_yukle(force=True)
                self._mesaj_arama_nav_guncelle()
                self._chat_base_signature = None
                self._mesajlari_yukle(force=True)
                return

            self._kisi_listesini_yukle(force=True)
            # Her tuş vuruşunda ağdaki JSONL'yi taramak yerine kısa bir debounce
            # kullanıyoruz. Kullanıcı yazmayı bıraktığında tek arama çalışır.
            old_after = getattr(self, "_chat_search_after_id", None)
            if old_after:
                try:
                    self.root.after_cancel(old_after)
                except Exception:
                    pass
                self._chat_search_after_id = None
            if q:
                self._chat_search_after_id = self.root.after(350, self._mesaj_arama_tam_gecmis)
            else:
                self._chat_search_server_targets = set()
                self._chat_search_results = []
                self._chat_search_index = -1
                self._chat_search_focus_id = None
                self._chat_server_search_pending = False
        except Exception:
            pass

    def _kullanici_rehberi_dongusu(self) -> None:
        """Kullanıcı rehberi ve presence yenilemesini GUI thread'inden çıkarır."""
        if not getattr(self, "_kullanici_refresh_in_progress", False):
            self._kullanici_refresh_in_progress = True

            def worker():
                try:
                    self._kullanici_rehberi.yenile()
                    online_keys = set()
                    try:
                        for a in self.servis.aktif_kullanicilar():
                            raw = str(a.kullanici)
                            resolved = self._kullanici_rehberi.cache_profili(raw)
                            online_keys.add((resolved.kullanici_adi if resolved else raw).casefold())
                    except Exception:
                        pass
                    self.kuyruk.put(("KULLANICI_REHBER_HAZIR", {"online_keys": online_keys}))
                except Exception:
                    self.kuyruk.put(("KULLANICI_REHBER_HAZIR", {"online_keys": set(getattr(self, "_mention_online_keys", set()))}))
                finally:
                    self._kullanici_refresh_in_progress = False

            threading.Thread(target=worker, daemon=True, name="ENCTakip-KullaniciRefresh").start()

        try:
            self.root.after(5000, self._kullanici_rehberi_dongusu)
        except Exception:
            pass

    def _kisi_listesini_yukle(self, force: bool = False) -> None:
        if not hasattr(self, "kisi_container"):
            return

        mevcut_profil = self._kullanici_rehberi.cache_profili(KULLANICI) or self._mevcut_kullanici_profili()
        kendi_anahtar = mevcut_profil.kullanici_adi.casefold() if mevcut_profil else KULLANICI.casefold()
        profiller = [p for p in self._kullanici_rehberi.cache_tumu() if p.kullanici_adi.casefold() != kendi_anahtar]
        profil_map = {p.kullanici_adi.casefold(): p for p in profiller}
        # Presence snapshot arka planda yenilenir; kişi listesi çizilirken UNC okunmaz.
        aktif_map = {str(k).casefold(): str(k) for k in getattr(self, "_mention_online_keys", set())}

        q = getattr(self, "_chat_search_filter", "").strip().casefold()
        matched_targets = set(getattr(self, "_chat_search_server_targets", set()))
        if q:
            try:
                for mm in self._mesaj_local_cache.search(q):
                    hedef = str(mm.hedef)
                    if hedef == KULLANICI:
                        hedef = str(mm.gonderen)
                    matched_targets.add(hedef)
            except Exception:
                pass

        sig = (
            tuple((p.kullanici_adi.casefold(), p.ad_soyad, p.unvan, p.profil_fotografi, p.durum, p.bilgisayarlar, p.kullanici_aliaslari) for p in profiller),
            tuple(sorted(aktif_map)),
            q,
            tuple(sorted(matched_targets)),
            tuple(sorted(getattr(self, "okunmayan_odalar", {}).items())),
            tuple(sorted(getattr(self, "okunmayan_ozel", {}).items())),
            self.sohbet_hedef,
        )
        if not force and sig == getattr(self, "_chat_list_signature", None):
            self._mesaj_oda_rozetlerini_guncelle()
            return
        self._chat_list_signature = sig

        for w in self.kisi_container.winfo_children():
            w.destroy()

        self._chat_rows = {}
        self._chat_badges = {}
        WHITE = "#ffffff"
        ACTIVE = "#f2f5f5"
        TEXT = "#111b21"
        MUTED = "#667781"
        GREEN = "#00a884"

        def bind_all(widget, command):
            widget.bind("<Button-1>", command)
            for child in widget.winfo_children():
                bind_all(child, command)

        def profil_satiri(profil: KullaniciProfili, cevrimici: bool):
            hedef = profil.kullanici_adi
            secili = self.sohbet_hedef.casefold() == hedef.casefold()
            bg = ACTIVE if secili else WHITE
            row = tk.Frame(self.kisi_container, bg=bg, height=70, bd=0, highlightthickness=0)
            row.pack(fill=tk.X)
            row.pack_propagate(False)
            av_img = self._profil_avatar_gorseli(hedef, 46)
            av = tk.Label(row, image=av_img, bg=bg, bd=0, cursor="hand2")
            av.image = av_img
            av.pack(side=tk.LEFT, padx=(12, 10), pady=11)
            av.bind("<Button-1>", lambda _e, k=hedef: self._kullanici_profil_penceresi(k))

            info = tk.Frame(row, bg=bg)
            info.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, pady=10)
            isim = tk.Label(info, text=profil.gorunen_ad, bg=bg, fg=TEXT, font=("Segoe UI", 9, "bold"), anchor="w", cursor="hand2")
            isim.pack(fill=tk.X)
            isim.bind("<Button-1>", lambda _e, k=hedef: self._kullanici_profil_penceresi(k))
            alt = f"@{profil.kullanici_adi}"
            tk.Label(info, text=alt, bg=bg, fg=MUTED, font=("Segoe UI", 8), anchor="w").pack(fill=tk.X, pady=(1, 0))

            durum_adi = profil.durum_adi if cevrimici else "Çevrimdışı"
            durum_renk = profil.durum_rengi if cevrimici else "#aeb7bd"
            durum = tk.Label(row, text="●", bg=bg, fg=durum_renk, font=("Segoe UI", 10, "bold"))
            durum.pack(side=tk.RIGHT, padx=(2, 2))
            durum_metni = tk.Label(row, text=durum_adi, bg=bg, fg=durum_renk, font=("Segoe UI", 7), anchor="e")
            durum_metni.pack(side=tk.RIGHT, padx=(0, 8))
            durum_metni.bind("<Button-1>", lambda _e, k=hedef: self._kullanici_profil_penceresi(k))
            adet = int(self.okunmayan_ozel.get(hedef, 0))
            if adet:
                badge = tk.Label(row, text=str(adet), bg=GREEN, fg="#ffffff", font=("Segoe UI", 7, "bold"), padx=5, pady=2)
                badge.pack(side=tk.RIGHT, padx=(4, 4))

            bind_all(row, lambda _e, k=hedef, a=profil.gorunen_ad: self._sohbet_sec(k, a))
            av.bind("<Button-1>", lambda _e, k=hedef: self._kullanici_profil_penceresi(k))
            isim.bind("<Button-1>", lambda _e, k=hedef: self._kullanici_profil_penceresi(k))
            self._chat_rows[hedef] = row
            return row

        def sohbet_satiri(hedef, baslik, alt, renk, harf):
            secili = self.sohbet_hedef == hedef
            bg = ACTIVE if secili else WHITE
            row = tk.Frame(self.kisi_container, bg=bg, height=72, bd=0, highlightthickness=0)
            row.pack(fill=tk.X)
            row.pack_propagate(False)
