            stripe = tk.Frame(outer, bg=accent, width=4)
            stripe.pack(side="left", fill="y")

            body = tk.Frame(outer, bg=bg, bd=0, highlightthickness=0)
            body.pack(side="left", fill="both", expand=True, padx=(13, 12), pady=11)
            header = tk.Frame(body, bg=bg, bd=0, highlightthickness=0)
            header.pack(fill="x")

            tk.Label(header, text=self.IKONLAR.get(self.tip, "i"),
                     font=(self._font(), 11, "bold"), bg=bg, fg=accent,
                     width=2).pack(side="left", padx=(0, 6))
            tk.Label(header, text=self.baslik, font=(self._font(), 10, "bold"),
                     bg=bg, fg="#111827", anchor="w", justify="left") \
                .pack(side="left", fill="x", expand=True)
            if self.dismiss_enabled:
                tk.Button(header, text="×", command=self._kapat,
                          bg=bg, fg="#64748B", activebackground=bg,
                          activeforeground="#111827", relief=tk.FLAT, bd=0,
                          highlightthickness=0, font=(self._font(), 13),
                          cursor="hand2", width=2).pack(side="right")

            if self.mesaj.strip():
                msg_frame = tk.Frame(body, bg=bg, bd=0, highlightthickness=0)
                msg_frame.pack(fill="x", pady=(3, 0))
                self._toast_rich_mesaj(msg_frame, self.mesaj, bg)

            if self.action is not None or self.cancel is not None:
                actions = tk.Frame(body, bg=bg, bd=0, highlightthickness=0)
                actions.pack(fill="x", pady=(9, 0))
                if self.action is not None:
                    label, callback = self.action
                    tk.Button(actions, text=str(label),
                              command=lambda cb=callback: self._action_call(cb),
                              bg=accent, fg="#FFFFFF", activebackground=accent,
                              activeforeground="#FFFFFF", relief=tk.FLAT, bd=0,
                              cursor="hand2", font=(self._font(), 8, "bold"),
                              padx=10, pady=4).pack(side="left")
                if self.cancel is not None:
                    label, callback = self.cancel
                    tk.Button(actions, text=str(label),
                              command=lambda cb=callback: self._action_call(cb),
                              bg="#EEF2F7", fg="#334155",
                              activebackground="#E2E8F0", activeforeground="#111827",
                              relief=tk.FLAT, bd=0, cursor="hand2",
                              font=(self._font(), 8, "bold"),
                              padx=10, pady=4).pack(side="left", padx=(7, 0))

            if self.progress_enabled:
                self.progress = tk.Canvas(body, height=3, bg=bg,
                                          highlightthickness=0, bd=0)
                self.progress.pack(fill="x", pady=(9, 0))
                self.progress.bind("<Configure>", lambda _e: self._progress_draw())

            self.pen.update_idletasks()
            left, top, right, bottom = self._work_area()
            x = max(left + 1, right - self.GENISLIK - self.KENAR)
            y = max(top + 1, bottom - self._height() - self.ALT)
            self.pen.geometry(f"{self.GENISLIK}x{self._height()}+{x}+{y}")
            Toast._aktif_bildirimler.append(self)
            self.pen.deiconify()
            try:
                self.pen.lift(); self.pen.attributes("-topmost", True)
            except Exception:
                pass
            self._bind_hover_recursive(self.pen)
            if self.progress_enabled:
                self._start_timer()
            self._reposition_all()
        except Exception as exc:
            print(f"[TOAST HATA] {exc}")
            try:
                if self.pen is not None:
                    self.pen.destroy()
            except Exception:
                pass

    def _clock_ms(self):
        try:
            return int(self.root.tk.call("clock", "milliseconds"))
        except Exception:
            return int(datetime.now().timestamp() * 1000)

    def _start_timer(self):
        self._cancel_timer()
        if self._closing or self.remaining_ms <= 0:
            return
        self._last_tick_ms = self._clock_ms()
        self._after_id = self.pen.after(40, self._timer_tick)

    def _timer_tick(self):
        if self._closing or self._paused:
            return
        try:
            now = self._clock_ms()
            elapsed = max(0, now - int(self._last_tick_ms or now))
            self.remaining_ms = max(0, self.remaining_ms - elapsed)
            self._last_tick_ms = now
            self._progress_draw()
            if self.remaining_ms <= 0:
                self._kapat()
            else:
                self._after_id = self.pen.after(40, self._timer_tick)
        except Exception:
            pass

    def _progress_draw(self):
        if self.progress is None:
            return
        try:
            self.progress.delete("all")
            w = self.progress.winfo_width()
            ratio = 0 if self.duration_ms <= 0 else self.remaining_ms / self.duration_ms
            self.progress.create_rectangle(0, 0,
                                           int(max(0, min(1, ratio)) * max(1, w)), 3,
                                           fill=self._colors()[1], outline="")
        except Exception:
            pass

    def _cancel_timer(self):
        if self.pen is None or self._after_id is None:
            return
        try:
            self.pen.after_cancel(self._after_id)
        except Exception:
            pass
        self._after_id = None

    def _bind_hover_recursive(self, widget):
        try:
            widget.bind("<Enter>", self._hover_enter, add="+")
            widget.bind("<Leave>", self._hover_leave, add="+")
            for child in widget.winfo_children():
                self._bind_hover_recursive(child)
        except Exception:
            pass

    def _hover_enter(self, _event=None):
        if not self.pause_on_hover or self.important or self._closing or self._paused:
            return
        self._paused = True
        self._cancel_timer()

    def _hover_leave(self, _event=None):
        if not self.pause_on_hover or self.important or self._closing or not self._paused:
            return
        self._paused = False
        self._start_timer()

    def _action_call(self, callback):
        try:
            if callable(callback):
                callback()
        finally:
            self._kapat()

    def _kapat(self):
        if self._closing:
            return
        self._closing = True
        self._cancel_timer()
        try:
            if self in Toast._aktif_bildirimler:
                Toast._aktif_bildirimler.remove(self)
        except Exception:
            pass
        try:
            if self.pen is not None and self.pen.winfo_exists():
                self.pen.destroy()
        except Exception:
            pass
        Toast._reposition_all()

    @classmethod
    def _limit_visible_toasts(cls):
        normal = [x for x in cls._aktif_bildirimler if not getattr(x, "important", False)]
        while len(normal) >= cls._MAX_TOASTS:
            try:
                normal.pop(0)._kapat()
            except Exception:
                break

    @classmethod
    def _reposition_all(cls):
        active = [x for x in cls._aktif_bildirimler
                  if getattr(x, "pen", None) is not None and not getattr(x, "_closing", True)]
        for i, toast in enumerate(active):
            try:
                left, top, right, bottom = toast._work_area()
                y = bottom - toast._height() - cls.ALT
                for other in active[:i]:
                    y -= other._height() + cls.BOSLUK
                x = right - cls.GENISLIK - cls.KENAR
                toast.pen.geometry(
                    f"{cls.GENISLIK}x{toast._height()}+{max(left, x)}+{max(top, y)}"
                )
            except Exception:
                pass

    @classmethod
    def clear_all(cls):
        for toast in list(cls._aktif_bildirimler):
            try:
                toast._kapat()
            except Exception:
                pass


class YerelMesajCache:
    """Her bilgisayarda tutulan, yalnızca mesaj METADATA/metinlerini içeren SQLite cache.

    Medya/dosya içeriği burada tutulmaz. Dosya mesajlarında yalnızca ağdaki
    ortak dosyanın göreli yolu, adı ve boyutu gibi küçük metadata bulunur.
    Böylece GUI normal kullanımda ağdaki mesaj klasörünü taramaz.
    """

    # Mesaj metni/metadatası hafiftir; geçmişi uzun süre tutabilmek için
    # lokal DB sınırını yüksek tutuyoruz. Medya dosyalarının kendisi burada yok.
    MAX_KAYIT = 100000

    def __init__(self, kullanici: str):
        kok = Path(os.environ.get("LOCALAPPDATA") or Path.home()) / "ENÇEV" / "ENCTakip"
        kok.mkdir(parents=True, exist_ok=True)
        self.yol = kok / f"mesaj_cache_{re.sub(r'[^A-Za-z0-9_.-]', '_', str(kullanici))}.db"
        self._lock = threading.RLock()
        self._db = sqlite3.connect(str(self.yol), timeout=10, check_same_thread=False)
        self._db.execute("PRAGMA journal_mode=WAL")
        self._db.execute("PRAGMA synchronous=NORMAL")
        self._db.execute("PRAGMA temp_store=MEMORY")
        self._db.execute("""
            CREATE TABLE IF NOT EXISTS messages (
                id TEXT PRIMARY KEY,
                sender TEXT NOT NULL,
                target TEXT NOT NULL,
                text TEXT NOT NULL,
                timestamp TEXT NOT NULL
            )
        """)
        self._db.execute("CREATE INDEX IF NOT EXISTS idx_messages_timestamp ON messages(timestamp)")
        self._db.execute("CREATE INDEX IF NOT EXISTS idx_messages_target_timestamp ON messages(target, timestamp)")
        self._db.execute("CREATE INDEX IF NOT EXISTS idx_messages_sender ON messages(sender)")
        self._db.commit()

    def upsert_many(self, messages) -> int:
        rows = []
        for m in messages:
            mid = str(getattr(m, "id", "") or "")
            if not mid:
                continue
            rows.append((
                mid,
                str(getattr(m, "gonderen", "") or ""),
                str(getattr(m, "hedef", "") or ""),
                str(getattr(m, "metin", "") or ""),
                str(getattr(m, "zaman", "") or ""),
            ))
        if not rows:
            return 0
        with self._lock:
            self._db.executemany(
                "INSERT OR REPLACE INTO messages(id,sender,target,text,timestamp) VALUES(?,?,?,?,?)",
                rows,
            )
            self._db.execute(
                """DELETE FROM messages WHERE id NOT IN (
                    SELECT id FROM messages ORDER BY timestamp DESC, rowid DESC LIMIT ?
                )""",
                (self.MAX_KAYIT,),
            )
            self._db.commit()
        return len(rows)

    def add(self, m) -> bool:
        mid = str(getattr(m, "id", "") or "")
        if not mid:
            return False
        with self._lock:
            cur = self._db.execute("SELECT 1 FROM messages WHERE id=?", (mid,))
            if cur.fetchone() is not None:
                return False
        self.upsert_many([m])
        return True

    def all(self):
        with self._lock:
            rows = self._db.execute(
                "SELECT id,sender,target,text,timestamp FROM messages ORDER BY timestamp ASC, rowid ASC"
            ).fetchall()
        return [SimpleNamespace(id=r[0], gonderen=r[1], hedef=r[2], metin=r[3], zaman=r[4]) for r in rows]

    def sohbet_mesajlari(self, hedef: str, limit: int = 500, before: str = ""):
        """Aktif sohbetin yalnızca gereken penceresini döndürür.

        Böylece 100.000 kayıtlık lokal cache olsa bile GUI her render'da
        100.000 Tk widget oluşturmaya çalışmaz.
        """
        hedef = str(hedef or "")
        limit = max(1, int(limit))
        with self._lock:
            if hedef in ("GENEL", "ODA_ECED", "ODA_DILEK"):
                if before:
                    rows = self._db.execute(
                        "SELECT id,sender,target,text,timestamp FROM messages WHERE target=? AND timestamp < ? ORDER BY timestamp DESC, rowid DESC LIMIT ?",
                        (hedef, before, limit),
                    ).fetchall()
                else:
                    rows = self._db.execute(
                        "SELECT id,sender,target,text,timestamp FROM messages WHERE target=? ORDER BY timestamp DESC, rowid DESC LIMIT ?",
                        (hedef, limit),
                    ).fetchall()
            else:
                if before:
                    rows = self._db.execute(
                        "SELECT id,sender,target,text,timestamp FROM messages WHERE ((sender=? AND target=?) OR (sender=? AND target=?)) AND timestamp < ? ORDER BY timestamp DESC, rowid DESC LIMIT ?",
                        (KULLANICI, hedef, hedef, KULLANICI, before, limit),
                    ).fetchall()
                else:
                    rows = self._db.execute(
                        "SELECT id,sender,target,text,timestamp FROM messages WHERE ((sender=? AND target=?) OR (sender=? AND target=?)) ORDER BY timestamp DESC, rowid DESC LIMIT ?",
                        (KULLANICI, hedef, hedef, KULLANICI, limit),
                    ).fetchall()
        rows.reverse()
        return [SimpleNamespace(id=r[0], gonderen=r[1], hedef=r[2], metin=r[3], zaman=r[4]) for r in rows]

    def sohbet_en_eski_zaman(self, hedef: str):
        with self._lock:
            if hedef in ("GENEL", "ODA_ECED", "ODA_DILEK"):
                row = self._db.execute("SELECT MIN(timestamp) FROM messages WHERE target=?", (hedef,)).fetchone()
            else:
                row = self._db.execute(
                    "SELECT MIN(timestamp) FROM messages WHERE ((sender=? AND target=?) OR (sender=? AND target=?))",
                    (KULLANICI, hedef, hedef, KULLANICI),
                ).fetchone()
        return row[0] if row and row[0] else None

    def sohbet_mesaj_penceresi(self, hedef: str, merkez_zaman: str, limit: int = 200):
        """Belirli bir zamanın çevresindeki mesajları getirir.

        Arama sonucuna atlamak için kullanılır; normal sohbet render'ı bundan
        etkilenmez. Böylece 100.000 kayıt içinde bulunan eski bir mesajı da
        2.000 kayıtlık son pencereye sığmasını beklemeden gösterebiliriz.
        """
        hedef = str(hedef or "")
        merkez_zaman = str(merkez_zaman or "")
        limit = max(20, int(limit))
        sol = limit // 2
        sag = limit - sol
        with self._lock:
            if hedef in ("GENEL", "ODA_ECED", "ODA_DILEK"):
                rows_before = self._db.execute(
                    "SELECT id,sender,target,text,timestamp FROM messages WHERE target=? AND timestamp <= ? ORDER BY timestamp DESC, rowid DESC LIMIT ?",
                    (hedef, merkez_zaman, sol),
                ).fetchall()
                rows_after = self._db.execute(
                    "SELECT id,sender,target,text,timestamp FROM messages WHERE target=? AND timestamp > ? ORDER BY timestamp ASC, rowid ASC LIMIT ?",
                    (hedef, merkez_zaman, sag),
                ).fetchall()
            else:
                where = "((sender=? AND target=?) OR (sender=? AND target=?))"
                args = (KULLANICI, hedef, hedef, KULLANICI)
                rows_before = self._db.execute(
                    f"SELECT id,sender,target,text,timestamp FROM messages WHERE {where} AND timestamp <= ? ORDER BY timestamp DESC, rowid DESC LIMIT ?",
                    args + (merkez_zaman, sol),
                ).fetchall()
                rows_after = self._db.execute(
                    f"SELECT id,sender,target,text,timestamp FROM messages WHERE {where} AND timestamp > ? ORDER BY timestamp ASC, rowid ASC LIMIT ?",
                    args + (merkez_zaman, sag),
                ).fetchall()
        rows = list(reversed(rows_before)) + rows_after
        return [SimpleNamespace(id=r[0], gonderen=r[1], hedef=r[2], metin=r[3], zaman=r[4]) for r in rows]

    def sohbet_ici_ara(self, hedef: str, query: str, limit: int = 5000):
        """Aktif sohbeti SQLite tarafında doğrudan arar; tüm kayıtları Python
        tarafına çekmez. Böylece yazarken ana Tk thread'i yüz binlerce kaydı
        filtrelemek zorunda kalmaz."""
        hedef = str(hedef or "")
        q = str(query or "").strip().casefold()
        if not q:
            return []
        limit = max(1, int(limit))
        like = f"%{q}%"
        with self._lock:
            if hedef in ("GENEL", "ODA_ECED", "ODA_DILEK"):
                rows = self._db.execute(
                    """SELECT id,sender,target,text,timestamp FROM messages
                       WHERE target=? AND lower(text) LIKE ?
                       ORDER BY timestamp ASC, rowid ASC LIMIT ?""",
                    (hedef, like, limit),
                ).fetchall()
            else:
                rows = self._db.execute(
                    """SELECT id,sender,target,text,timestamp FROM messages
                       WHERE ((sender=? AND target=?) OR (sender=? AND target=?))
                         AND lower(text) LIKE ?
                       ORDER BY timestamp ASC, rowid ASC LIMIT ?""",
                    (KULLANICI, hedef, hedef, KULLANICI, like, limit),
                ).fetchall()
        return [SimpleNamespace(id=r[0], gonderen=r[1], hedef=r[2], metin=r[3], zaman=r[4]) for r in rows]

    def search(self, query: str):
        q = str(query or "").strip().casefold()
        if not q:
            return []
        like = f"%{q}%"
        with self._lock:
            rows = self._db.execute(
                """SELECT id,sender,target,text,timestamp FROM messages
                   WHERE (lower(text) LIKE ? OR lower(sender) LIKE ? OR lower(target) LIKE ?)
                     AND text NOT GLOB '__ENCTAKIP_*'
                   ORDER BY timestamp DESC, rowid DESC""",
                (like, like, like),
            ).fetchall()
        return [SimpleNamespace(id=r[0], gonderen=r[1], hedef=r[2], metin=r[3], zaman=r[4]) for r in rows]

    def markerleri(self, mesaj_id: str):
        """Belirli bir mesaj için teslim/okundu markerlarını lokal SQLite'tan getirir."""
        mid = str(mesaj_id or "")
        if not mid:
            return []
        prefixes = ("__ENCTAKIP_DELIVERED__%", "__ENCTAKIP_READ__%")
        with self._lock:
            rows = self._db.execute(
                "SELECT id,sender,target,text,timestamp FROM messages WHERE (text GLOB ? OR text GLOB ?) ORDER BY timestamp ASC, rowid ASC",
                ("__ENCTAKIP_DELIVERED__*", "__ENCTAKIP_READ__*"),
            ).fetchall()
        out = []
        for r in rows:
            text = str(r[3] or "")
            try:
                raw = text.split("}", 1)[0] + "}"
                # Prefix sonrası JSON'daki id alanını hızlıca doğrula; tam parse GUI tarafında yapılır.
                data = json.loads(text[text.find("{"):]) if "{" in text else {}
                if str(data.get("id", "")) != mid:
                    continue
            except Exception:
                continue
            out.append(SimpleNamespace(id=r[0], gonderen=r[1], hedef=r[2], metin=r[3], zaman=r[4]))
        return out

    def kullanici_adlari(self, limit: int = 200):
        """@mention autocomplete için kullanıcı adlarını SQLite'tan doğrudan getirir."""
        limit = max(1, int(limit))
        try:
            with self._lock:
                rows = self._db.execute(
                    """SELECT sender AS name FROM messages
                       WHERE sender <> ''
                       UNION
                       SELECT target AS name FROM messages
                       WHERE target <> ''
                       ORDER BY name COLLATE NOCASE
                       LIMIT ?""",
                    (limit,),
                ).fetchall()
            return [str(r[0]) for r in rows]
        except Exception:
            return []

    def ids(self):
        with self._lock:
            return {str(r[0]) for r in self._db.execute("SELECT id FROM messages")}

    def count(self) -> int:
        with self._lock:
            return int(self._db.execute("SELECT COUNT(*) FROM messages").fetchone()[0])

    def close(self):
        try:
            with self._lock:
                self._db.commit()
                self._db.close()
        except Exception:
            pass


