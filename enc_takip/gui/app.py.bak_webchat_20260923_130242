    def _bildirim_goster(self, baslik: str, mesaj: str, tip: str = "bilgi", sure_ms: int = 5000) -> None:
        """Tek giriş noktası: toast + geçmiş + ses."""

        if not self._bildirim_ayarlari.get("bildirimler_acik", True):
            return
        # Toast'ların gereğinden uzun ekranda kalmasını engelle.
        sure_ms = max(3000, min(sure_ms, 5000))

        Toast(self.root, baslik, mesaj, tip, sure_ms)
        self._ses_calar(tip)

        self._bildirim_gecmisi.insert(0, {
            "zaman": datetime.now(),
            "baslik": baslik,
            "mesaj": mesaj,
            "tip": tip,
        })
        del self._bildirim_gecmisi[_BILDIRIM_GECMISI_AZAMI:]
        self._okunmamis_bildirim += 1
        self._bildirim_rozetini_guncelle()

