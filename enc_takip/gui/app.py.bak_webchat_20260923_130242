    def _gunlugu_disa_aktar(self) -> None:
        yol = filedialog.asksaveasfilename(
            title="Erişim Geçmişini Dışa Aktar",
            defaultextension=".csv",
            filetypes=[
                ("CSV (Excel)", "*.csv")
            ],
            initialfile="erisim_gecmisi.csv",
        )

        if not yol:
            return

        try:
            with open(
                yol,
                "w",
                newline="",
                encoding="utf-8-sig",
            ) as fp:
                yazici = csv.writer(
                    fp,
                    delimiter=";",
                )

                yazici.writerow(
                    [
                        "Zaman",
                        "Kullanıcı",
                        "Bilgisayar",
                        "Olay",
                        "Süre (sn)",
                        "Detay",
                    ]
                )

                for k in reversed(
                    self._log_kayitlari_cache
                ):
                    yazici.writerow(
                        [
                            k.zaman,
                            k.kullanici,
                            k.bilgisayar,
                            k.olay,
                            k.sure_sn,
                            k.detay,
                        ]
                    )

            self._bildirim_goster(
                "Dışa Aktarıldı",
                yol,
                "basari",
                6000,
            )

        except OSError as e:
            messagebox.showerror(
                "Hata",
                f"Dosya yazılamadı: {e}",
            )

