    def _sohbet_sec(self, hedef, ad) -> None:
        try:
            mevcut = getattr(self, "_chat_current_target", None)
            if mevcut is not None and hasattr(self, "ms_canvas"):
                self._chat_scroll_cache[mevcut] = self.ms_canvas.yview()[0]
        except Exception:
            pass
        self.sohbet_hedef = hedef
        # Sohbet değişiminde yeni sohbet her zaman en son mesaja açılır.
        # Önceki ziyaretin yüzdelik scroll konumu artık yeni sohbete taşınmaz.
        self._chat_scroll_cache[hedef] = 1.0

        if hedef in ("ODA_ECED", "ODA_DILEK", "GENEL"):
            if hasattr(self, "okunmayan_odalar"):
                self.okunmayan_odalar[hedef] = 0
            basliklar = {
                "ODA_ECED": ("EÇED KOD", "Ekip sohbeti"),
                "ODA_DILEK": ("DİLEKÇELER", "Ekip sohbeti"),
                "GENEL": ("Genel Sohbet", "Tüm ENÇEV ekibi"),
            }
            baslik, alt = basliklar[hedef]
        else:
            self.okunmayan_ozel.pop(hedef, None)
            baslik, alt = str(ad), "Özel sohbet"

        self.ms_baslik_var.set(baslik)
        self.ms_alt_var.set(alt)
        try:
            if hedef in ("ODA_ECED", "ODA_DILEK", "GENEL"):
                harf = {"ODA_ECED":"E","ODA_DILEK":"D","GENEL":"G"}[hedef]
                renk = {"ODA_ECED":"#6b5dd3","ODA_DILEK":"#00a884","GENEL":"#3b82f6"}[hedef]
            else:
                harf = str(ad or "?")[:1].upper()
                renk = "#8b98a5"
            photo = self._avatar_gorseli(harf, renk, 46)
            self.ms_avatar.configure(image=photo, bg=self.ms_header.cget("bg"))
            self.ms_avatar.image = photo
        except Exception:
            pass

        self._menu_rozet_guncelle()
        self._kisi_listesini_yukle()
        self._mesajlari_yukle(force=False)
        self.ms_entry.focus_set()
    def _mesaj_cache_write_worker(self) -> None:
        while True:
            item = self._mesaj_cache_write_queue.get()
            try:
                if item is None:
                    return
                self._mesaj_local_cache.add(item)
            except Exception:
                pass
            finally:
                self._mesaj_cache_write_queue.task_done()

    def _mesaj_receipt_worker(self) -> None:
        while True:
            item = self._mesaj_receipt_queue.get()
            if item is None:
                self._mesaj_receipt_queue.task_done()
                return
            try:
                payload, hedef, kind, mesaj_id = item
                ok = self.servis.mesaj_gonder(payload, hedef)
                if ok:
                    if kind == "delivered":
                        self._chat_delivery_sent.add(mesaj_id)
                    elif kind == "read":
                        self._chat_read_sent.add(mesaj_id)
            except Exception:
                pass
            finally:
                self._mesaj_receipt_queue.task_done()

    def _mesaj_gonder_worker(self) -> None:
        while True:
            item = self._mesaj_send_queue.get()
            if item is None:
                self._mesaj_send_queue.task_done()
                return
            temp_id, metin, hedef = item
            try:
                mesaj = self.servis.mesaj_gonder_mesaj(metin, hedef)
                if mesaj is None:
                    raise OSError("Ağdaki mesaj kaydı oluşturulamadı.")
                self.kuyruk.put(("MESAJ_GONDERILDI", {"temp_id": temp_id, "message": mesaj}))
            except Exception as exc:
                self.kuyruk.put(("MESAJ_GONDERILEMEDI", {"temp_id": temp_id, "error": str(exc)}))
            finally:
                self._mesaj_send_queue.task_done()

    def _mesaj_render_planla(self, gecikme_ms: int = 50) -> None:
        """Chat render'larını kısa bir pencere içinde birleştirir.

        Ağ watcher aynı anda birkaç mesaj getirirse her mesaj için 500 Tk widget
        yeniden üretmek yerine tek render yapılır.
        """
        if self.aktif_sekme != "mesaj" or not hasattr(self, "ms_canvas"):
            return
        if getattr(self, "_mesaj_render_planlandi", False):
            return
        self._mesaj_render_planlandi = True

        def run():
            self._mesaj_render_planlandi = False
            if self.aktif_sekme == "mesaj":
                self._chat_base_signature = None
                self._mesajlari_yukle(force=False)

        try:
            self.root.after(max(0, int(gecikme_ms)), run)
        except Exception:
            self._mesaj_render_planlandi = False

    def _mesaj_marker_coz(self, metin: str):
        if not isinstance(metin, str):
            return None, None

        for prefix, kind in (
            ("__ENCTAKIP_EDIT__", "edit"),
            ("__ENCTAKIP_FILE__", "file"),
            ("__ENCTAKIP_DELETE__", "delete"),
            ("__ENCTAKIP_DELIVERED__", "delivered"),
            ("__ENCTAKIP_READ__", "read"),
        ):
            if metin.startswith(prefix):
                try:
                    data = json.loads(metin[len(prefix):])
                    if isinstance(data, dict):
                        return kind, data
                except Exception:
                    return None, None
        return None, None
    def _mesaj_yeni_senkron_baslat(self):
        """Kendi gönderdiğimiz mesajı server taraması beklemeden lokal cache'e al."""
        try:
            m = getattr(self.servis, "son_gonderilen_mesaj_al", lambda: None)()
            if m is not None:
                self._mesaj_cache_ekle(m)
                self._chat_base_signature = None
                if self.aktif_sekme == "mesaj":
                    self._mesajlari_yukle(force=True)
        except Exception as exc:
            print(f"[MESAJ GÖNDERİCİ CACHE] {exc}")

    def _mesaj_gecmis_sync_baslat(self, neden="scroll", tam=False):
        """Aktif sohbet için yalnızca eksik eski mesajları ağdan getirir.

        İstekler sohbet anahtarına göre kilitlenir; başka bir sohbete geçmek
        devam eden ağ isteği yüzünden yeni sohbeti kilitlemez.
        """
        hedef = self.sohbet_hedef
        aktif_istekler = getattr(self, "_mesaj_history_sync_targets", set())
        if hedef in aktif_istekler:
            return
        if self._chat_history_complete.get(hedef, False):
            return

        before = self._chat_oldest_loaded.get(hedef)
        if not before:
            before = self._mesaj_local_cache.sohbet_en_eski_zaman(hedef)
        if not before:
            return

        aktif_istekler.add(hedef)
        self._mesaj_history_sync_targets = aktif_istekler
        self._mesaj_history_sync_calisiyor = True
        self._mesaj_history_request_kind = neden

        def worker(target=hedef, before_zaman=before):
            try:
                batch = self.servis.mesaj_gecmisi_onceki(before_zaman, 300, target)
                if batch:
                    self._mesaj_local_cache.upsert_many(batch)
                complete = len(batch) < 300
                self.kuyruk.put(("MESAJ_GECMIS_HAZIR", {
                    "count": len(batch), "complete": complete, "target": target,
                    "before": before_zaman, "kind": neden,
                }))
            except Exception as exc:
                self.kuyruk.put(("MESAJ_GECMIS_HAZIR", {"error": str(exc), "target": target}))
            finally:
                # Bu değişiklik GUI thread'i dışında yapılabildiği için
                # yalnızca kendi hedefimizi serbest bırakıyoruz.
                self._mesaj_history_sync_targets.discard(target)
                self._mesaj_history_sync_calisiyor = bool(self._mesaj_history_sync_targets)

        threading.Thread(target=worker, name=f"ENCTakip-MesajHistory-{hedef}", daemon=True).start()

    def _mesaj_eski_gecmisi_yukle(self):
        if not hasattr(self, "ms_canvas") or getattr(self, "_mesaj_history_sync_calisiyor", False):
            return
        try:
            first, _ = self.ms_canvas.yview()
        except Exception:
            first = 1.0
        if first <= 0.03:
            self._mesaj_gecmis_sync_baslat("scroll", tam=False)

    def _mesaj_arama_tam_gecmis(self):
        """Aramayı gerçek server geçmişine de taşır; yalnızca kullanıcı arama yapınca çalışır."""
        q = getattr(self, "_chat_search_filter", "").strip()
        if not q or getattr(self, "_chat_search_server_pending", False):
            return
        self._chat_search_server_pending = True
        self._chat_server_search_serial += 1
        serial = self._chat_server_search_serial

        def worker(query=q, token=serial):
            try:
                results = self.servis.mesaj_ara(query, 5000)
                self.kuyruk.put(("MESAJ_ARAMA_HAZIR", {"query": query, "results": results, "serial": token}))
            except Exception as exc:
                self.kuyruk.put(("MESAJ_ARAMA_HAZIR", {"query": query, "results": [], "serial": token, "error": str(exc)}))

        threading.Thread(target=worker, name="ENCTakip-MesajSearch", daemon=True).start()

    def _mesaj_sync_baslat(self, force=False):
        """Açılış senkronu: yalnızca server'ın son 1500 mesajını bir kez lokal cache'e alır."""
        if getattr(self, "_mesaj_sync_calisiyor", False) and not force:
            return
        self._mesaj_sync_calisiyor = True

        def worker():
            try:
                ham = list(self.servis.mesaj_gecmisi_son(1500))
                self._mesaj_local_cache.upsert_many(ham)
                self.kuyruk.put(("MESAJ_CACHE_HAZIR", {"count": len(ham)}))
            except Exception as exc:
                print(f"[MESAJ SYNC] Başarısız: {exc}")
                self.kuyruk.put(("MESAJ_CACHE_HAZIR", {"count": 0, "error": str(exc), "fallback": True}))
            finally:
                self._mesaj_sync_calisiyor = False

        threading.Thread(target=worker, name="ENCTakip-MesajSync", daemon=True).start()

    def _mesaj_cache_yukle(self, force=False):
        """Mesajları önce lokal SQLite cache'ten verir.

        Cache boşsa ilk kurulum/onarım için ağdaki mevcut mesajları bir kez
        alır. Bu fallback yalnızca cache gerçekten boşken çalışır; normal
        kullanımda GUI hiçbir şekilde server taraması yapmaz.
        """
        try:
            ham = self._mesaj_local_cache.all()

            # İlk açılışta background senkronizasyon henüz bitmemiş olabilir.
            # force ile gelen çağrıda ayrıca senkronizasyonu başlat; GUI'yi
            # boş bırakmamak için senkron tamamlandığında MESAJ_CACHE_HAZIR
            # olayı yeniden render edecektir.
            if force and not getattr(self, "_mesaj_sync_calisiyor", False):
                self._mesaj_sync_baslat(force=True)

            if ham:
                self._mesaj_ham_cache = ham
                self._mesaj_ham_cache_ids = {str(getattr(m, "id", "")) for m in ham}
                self._mesaj_ham_cache_hazir = True
                return self._mesaj_ham_cache

            # Cache boş ve senkronizasyon çalışmıyorsa, bunun gerçekten ilk
            # kurulum olduğunu kabul et. Bir defalık fallback yapıyoruz.
            # Böylece eski kurulumlarda/bozuk cache'te mesaj ekranı boş kalmaz.
            if not getattr(self, "_mesaj_sync_calisiyor", False) and not getattr(self, "_mesaj_sync_hazir", False):
                try:
                    ham = list(self.servis.mesaj_gecmisi_son(1500))
                    if ham:
                        self._mesaj_local_cache.upsert_many(ham)
                        self._mesaj_ham_cache = ham
                        self._mesaj_ham_cache_ids = {str(getattr(m, "id", "")) for m in ham}
                        self._mesaj_ham_cache_hazir = True
                        self._mesaj_sync_hazir = True
                        return self._mesaj_ham_cache
                except Exception as exc:
                    print(f"[MESAJ CACHE] İlk senkron fallback başarısız: {exc}")

            self._mesaj_ham_cache = []
            self._mesaj_ham_cache_ids = set()
            self._mesaj_ham_cache_hazir = True
            return self._mesaj_ham_cache
        except Exception as exc:
            print(f"[MESAJ CACHE] Lokal cache okunamadı: {exc}")
            return getattr(self, "_mesaj_ham_cache", [])

    def _mesaj_cache_ekle(self, m):
        """Yeni mesajı GUI RAM cache'ine anında ekler; SQLite yazımını worker'a bırakır."""
        try:
            mid = str(getattr(m, "id", ""))
            if not mid or mid in getattr(self, "_mesaj_ham_cache_ids", set()):
                return
            self._mesaj_ham_cache.append(m)
            self._mesaj_ham_cache_ids.add(mid)
            self._mesaj_ham_cache_hazir = True
            self._mesaj_data_epoch += 1
            self._mesaj_view_cache.clear()
            if len(self._mesaj_ham_cache) > self._mesaj_local_cache.MAX_KAYIT:
                self._mesaj_ham_cache = self._mesaj_ham_cache[-self._mesaj_local_cache.MAX_KAYIT:]
                self._mesaj_ham_cache_ids = {str(getattr(x, "id", "")) for x in self._mesaj_ham_cache}
            try:
                self._mesaj_cache_write_queue.put_nowait(m)
            except Exception:
                pass
        except Exception as exc:
            print(f"[MESAJ CACHE] RAM kaydı eklenemedi: {exc}")

    def _mesaj_etiket_kullanici_adlari(self) -> list[str]:
        """Mesaj gövdesinde tanınacak mention kullanıcı adlarını RAM cache'ten döndür."""
        cached = getattr(self, "_mention_usernames_cache", None)
        if cached is not None:
            return list(cached)
        try:
            self._mention_cache_guncelle(force=True)
            cached = getattr(self, "_mention_usernames_cache", []) or []
            if cached:
                return list(cached)
        except Exception:
            pass
        return [x for x in ("burak", "tuğçe") if x.casefold() != KULLANICI.casefold()]

    def _mesaj_etiket_var(self, metin: str) -> bool:
        """Mesajda gerçek bir @mention bulunup bulunmadığını hızlıca belirle."""
        text = str(metin or "")
        if "@" not in text:
            return False
        for username in self._mesaj_etiket_kullanici_adlari():
            if re.search(
                r"@" + re.escape(username) + r"(?![A-Za-z0-9_.-])",
                text,
                flags=re.IGNORECASE,
            ):
                return True
        return False

    def _mesaj_rich_text_ekle(self, widget, metin: str, emoji_boyut: int = 22) -> None:
        """Metni ve tıklanabilir @mention etiketlerini Text widget'ına ekler.

        Emoji'leri Text içine PhotoImage olarak gömmeyiz; Unicode olarak bırakırız.
        Böylece Tk'nin image line-height davranışı dikey sündürme oluşturmaz.
        """
        text = str(metin or "")
        usernames = sorted(
            self._mesaj_etiket_kullanici_adlari(),
            key=len,
            reverse=True,
        )
        if not text:
            return
        if not usernames:
            widget.insert(tk.END, text)
            return

        pattern = re.compile(
            "|".join(
                r"@" + re.escape(x) + r"(?![A-Za-z0-9_.-])"
                for x in usernames
            ),
            re.IGNORECASE,
        )
        pos = 0
        for match in pattern.finditer(text):
            if match.start() > pos:
                widget.insert(tk.END, text[pos:match.start()])
            token = match.group(0)
            username = next(
                (
                    candidate
                    for candidate in usernames
                    if token.casefold() == ("@" + candidate).casefold()
                ),
                None,
            )
            if username:
                tag = (
                    "mention_"
                    + re.sub(r"[^A-Za-z0-9_]", "_", username)
                    + "_"
                    + uuid.uuid4().hex[:8]
                )
                widget.insert(tk.END, token, (tag,))
                widget.tag_configure(tag, foreground="#027eb5", underline=True)
                widget.tag_bind(
                    tag,
                    "<Button-1>",
                    lambda _e, name=username: self._kullanici_profil_penceresi(name),
                )
                widget.tag_bind(tag, "<Enter>", lambda _e: widget.configure(cursor="hand2"))
                widget.tag_bind(tag, "<Leave>", lambda _e: widget.configure(cursor="arrow"))
            else:
                widget.insert(tk.END, token)
            pos = match.end()
        if pos < len(text):
            widget.insert(tk.END, text[pos:])

    def _mesaj_zengin_icerik_olustur(self, parent, metin: str, bg: str, fg: str, max_width: int = 540, emoji_size: int = 22):
        """Emoji/mention içeren mesajı gerçek satır bileşenleriyle çizer.

        Tk Text içine image_create kullanmıyoruz: emoji image'ları Text satır yüksekliğini
        bozup balonu aşağı doğru sündürebiliyordu. Bu renderer her satırı fiziksel olarak
        oluşturduğu için yüksekliği deterministiktir.
        """
        container = tk.Frame(parent, bg=bg, bd=0, highlightthickness=0)
        font = tkfont.Font(family="Segoe UI", size=10)
        emoji_list = sorted(set(self._emoji_listesi()), key=len, reverse=True)
        mention_names = sorted(self._mesaj_etiket_kullanici_adlari(), key=len, reverse=True)
        parts_re = []
        if emoji_list:
            parts_re.append("(?P<emoji>" + "|".join(re.escape(e) for e in emoji_list) + ")")
        if mention_names:
            parts_re.append("(?P<mention>@(?:" + "|".join(re.escape(e) for e in mention_names) + "))(?=$|[^A-Za-z0-9_.-])")
        token_re = re.compile("|".join(parts_re), re.IGNORECASE) if parts_re else None

        current = {"frame": None, "used": 0, "has": False}

        def new_line():
            frame = tk.Frame(container, bg=bg, bd=0, highlightthickness=0)
            frame.pack(fill=tk.X, anchor="w")
            current["frame"] = frame
            current["used"] = 0
            current["has"] = False

        def add_piece(text_piece: str, kind: str = "text"):
            if not text_piece:
                return
            if current["frame"] is None:
                new_line()
            if kind == "emoji":
                photo = self._emoji_gorseli_getir(text_piece, emoji_size)
                width = photo.width() + 1 if photo is not None else font.measure(text_piece)
                if current["has"] and current["used"] + width > max_width:
                    new_line()
                if photo is not None:
                    lab = tk.Label(current["frame"], image=photo, bg=bg, bd=0, padx=0, pady=0)
                    lab.image = photo
                    lab.pack(side=tk.LEFT, padx=(0,1), pady=0)
                else:
                    lab = tk.Label(current["frame"], text=text_piece, bg=bg, fg=fg, font=("Segoe UI Emoji", 12), bd=0, padx=0, pady=0)
                    lab.pack(side=tk.LEFT, padx=(0,1), pady=0)
                current["used"] += width
                current["has"] = True
                return

            if kind == "mention":
                width = font.measure(text_piece)
                if current["has"] and current["used"] + width > max_width:
                    new_line()
                lab = tk.Label(current["frame"], text=text_piece, bg=bg, fg="#027eb5", font=("Segoe UI", 10, "underline"), bd=0, padx=0, pady=0, cursor="hand2")
                username = text_piece[1:]
                lab.bind("<Button-1>", lambda _e, name=username: self._kullanici_profil_penceresi(name))
                lab.pack(side=tk.LEFT, padx=0, pady=0)
                current["used"] += width
                current["has"] = True
                return

            # Normal metni kelime + boşluk parçalarına böl. Çok uzun kelimeyi karakter bazında kır.
            for token in re.findall(r"\s+|\S+", text_piece):
                if token.isspace() and not current["has"]:
                    continue
                width = font.measure(token)
                if width > max_width:
                    for ch in token:
                        cw = font.measure(ch)
                        if current["has"] and current["used"] + cw > max_width:
                            new_line()
                        lab = tk.Label(current["frame"], text=ch, bg=bg, fg=fg, font=("Segoe UI",10), bd=0, padx=0, pady=0)
                        lab.pack(side=tk.LEFT, padx=0, pady=0)
                        current["used"] += cw
                        current["has"] = True
                    continue
                if current["has"] and current["used"] + width > max_width and not token.isspace():
                    new_line()
                lab = tk.Label(current["frame"], text=token, bg=bg, fg=fg, font=("Segoe UI",10), bd=0, padx=0, pady=0)
                lab.pack(side=tk.LEFT, padx=0, pady=0)
                current["used"] += width
                current["has"] = True

        lines = str(metin or "").split("\n")
        for line_index, line in enumerate(lines):
            if current["frame"] is None or (line_index > 0):
                new_line()
            if not line:
                continue
            pos = 0
            if token_re:
                for match in token_re.finditer(line):
                    if match.start() > pos:
                        add_piece(line[pos:match.start()], "text")
                    kind = "emoji" if match.group("emoji") is not None else "mention"
                    add_piece(match.group(0), kind)
                    pos = match.end()
                if pos < len(line):
                    add_piece(line[pos:], "text")
            else:
                add_piece(line, "text")
        if current["frame"] is None:
            new_line()
        return container

    def _mesaj_gorunumleri_hazirla(self):
        """Lokal mesaj kayıtlarını render için tek geçişte değil, marker'ları
        önce toplayıp sonra uygulayacak şekilde hazırlar.

        Böylece düzenleme/silme/teslim/okundu marker'ının orijinal mesajdan
        önce/sonra gelmesi sonucu kayıt sırası artık sonucu bozmaz.
        """
        chat_target = getattr(self, "sohbet_hedef", "GENEL")
        focus_time = getattr(self, "_chat_focus_timestamp", {}).get(chat_target)
        cache_key = (chat_target, int(getattr(self, "_mesaj_data_epoch", 0)), str(focus_time or ""))
        cached = self._mesaj_view_cache.get(cache_key)
        if cached is not None:
            return cached
        if focus_time:
            ham = list(self._mesaj_local_cache.sohbet_mesaj_penceresi(chat_target, focus_time, limit=180))
        else:
            ham = list(self._mesaj_local_cache.sohbet_mesajlari(chat_target, limit=180))

        if not ham:
            ham = [m for m in self._mesaj_cache_yukle() if self._mesaj_gorunumune_uyuyor_mu({"m": m})]

        self._chat_oldest_loaded[chat_target] = ham[0].zaman if ham else self._chat_oldest_loaded.get(chat_target)

        kayitlar = {}
        siralama = []
        editler = {}
        silinenler = {}
        bekleyen_teslim = {}
        bekleyen_okuma = {}

        for m in ham:
            kind, data = self._mesaj_marker_coz(m.metin)
            data = data or {}

            if kind == "edit":
                hedef_id = str(data.get("id", "")).strip()
                if hedef_id:
                    editler.setdefault(hedef_id, []).append((m, data))
                continue

            if kind == "delete":
                hedef_id = str(data.get("id", "")).strip()
                if hedef_id:
                    silinenler.setdefault(hedef_id, []).append((m, data))
                continue

            if kind in ("delivered", "read"):
                hedef_id = str(data.get("id", "")).strip()
                kullanici = str(data.get("user", "")).strip()
                if hedef_id and kullanici:
                    zaman = str(getattr(m, "zaman", "") or "")
                    hedef = kayitlar.get(hedef_id)
                    anahtar = "okuyanlar" if kind == "read" else "teslim_alanlar"
                    if hedef is not None:
                        liste = hedef.setdefault(anahtar, {})
                        liste[kullanici.casefold()] = {"user": kullanici, "time": zaman}
                    else:
                        bekleyen = bekleyen_okuma if kind == "read" else bekleyen_teslim
                        bekleyen.setdefault(hedef_id, {})[kullanici.casefold()] = {
                            "user": kullanici,
                            "time": zaman,
                        }
                continue

            file_data = data if kind == "file" else None
            kayit = {
                "m": m,
                "metin": m.metin,
                "duzenlendi": False,
                "silindi": False,
                "dosya": file_data,
                "teslim_alanlar": {},
                "okuyanlar": {},
            }
            kayitlar[str(m.id)] = kayit
            siralama.append(str(m.id))

        # Marker'lar orijinal kayıttan önce geldiyse de artık uygulanabilir.
        for mid, users in bekleyen_teslim.items():
            if mid in kayitlar:
                kayitlar[mid].setdefault("teslim_alanlar", {}).update(users)
        for mid, users in bekleyen_okuma.items():
            if mid in kayitlar:
                kayitlar[mid].setdefault("okuyanlar", {}).update(users)

        # Düzenleme ve silme yalnızca orijinal mesajın sahibi tarafından
        # oluşturulmuşsa geçerli kabul edilir.
        for mid, entries in editler.items():
            hedef = kayitlar.get(mid)
            if not hedef:
                continue
            kaynak_mesaj = hedef["m"]
            for marker_m, data in entries:
                if str(marker_m.gonderen).casefold() != str(kaynak_mesaj.gonderen).casefold():
                    continue
                hedef["metin"] = str(data.get("text", ""))
                hedef["duzenlendi"] = True
                # Birden fazla edit marker varsa dosyadaki sonuncusu geçerli.

        for mid, entries in silinenler.items():
            hedef = kayitlar.get(mid)
            if not hedef:
                continue
            kaynak_mesaj = hedef["m"]
            for marker_m, _data in entries:
                if str(marker_m.gonderen).casefold() == str(kaynak_mesaj.gonderen).casefold():
                    hedef["silindi"] = True

        for kayit in kayitlar.values():
            if kayit["m"].gonderen.casefold() == KULLANICI.casefold():
                kayit["teslim_edildi"] = bool(kayit.get("teslim_alanlar"))
                kayit["okundu"] = bool(kayit.get("okuyanlar"))
            else:
                kayit["teslim_edildi"] = False
                kayit["okundu"] = False

        # Silinen mesajları sohbetten fiziksel olarak yok etmiyoruz; yerlerine
        # kısa bir "mesaj silindi" satırı bırakıyoruz. Böylece konuşmanın
        # zaman akışı/scroll geometrisi ani şekilde çökmez.
        sonuc = []
        for mid in siralama:
            kayit = kayitlar.get(mid)
            if kayit is None:
                continue
            if kayit.get("silindi"):
                kayit["metin"] = "Bu mesaj silindi"
                kayit["dosya"] = None
            sonuc.append(kayit)

        for pm in list(getattr(self, "_mesaj_pending", [])):
            try:
                if self._mesaj_gorunumune_uyuyor_mu({"m": pm}):
                    sonuc.append({
                        "m": pm, "metin": str(pm.metin), "duzenlendi": False,
                        "silindi": False, "dosya": None, "teslim_alanlar": {},
                        "okuyanlar": {}, "teslim_edildi": False, "okundu": False,
                        "pending": True,
                    })
            except Exception:
                pass
        self._mesaj_view_cache[cache_key] = sonuc
        if len(self._mesaj_view_cache) > 12:
            self._mesaj_view_cache.pop(next(iter(self._mesaj_view_cache)))
        return sonuc

    def _mesaj_gorunumune_uyuyor_mu(self, kayit) -> bool:
        m = kayit["m"]
        hedef = self.sohbet_hedef

        if hedef in ("ODA_ECED", "ODA_DILEK", "GENEL"):
            return m.hedef == hedef

        return (
            (m.gonderen == KULLANICI and m.hedef == hedef)
            or (m.gonderen == hedef and m.hedef == KULLANICI)
        )

    def _dosya_boyutu_metin(self, boyut: int) -> str:
        b = max(0, int(boyut or 0))
        if b < 1024:
            return f"{b} B"
        if b < 1024 ** 2:
            return f"{b / 1024:.0f} KB"
        if b < 1024 ** 3:
            return f"{b / (1024 ** 2):.1f} MB"
        return f"{b / (1024 ** 3):.2f} GB"

    def _mesaj_dosya_yolu_guvenli(self, veri: dict) -> Path:
        """Dosya yolunu GUI thread'inde ağ I/O yapmadan güvenli şekilde oluşturur."""
        rel_text = str(veri.get("rel", "") or "").strip()
        rel = Path(rel_text)
        if not rel_text or rel.is_absolute() or rel.anchor:
            raise ValueError("Geçersiz paylaşım yolu.")
        if any(part in ("..", "") for part in rel.parts):
            raise ValueError("Geçersiz paylaşım yolu.")
        # Burada exists()/resolve() çağırmıyoruz: UNC/SMB üzerinde bunlar GUI'yi bekletebilir.
        return Path(self.s.sistem_klasoru) / rel

    def _mesaj_resim_onizleme(self, parent, veri: dict, bg: str, ben: bool = False) -> None:
        """Yerel thumbnail cache + sınırlı worker ile pürüzsüz resim mesajı."""
        suffix = Path(str(veri.get("name", ""))).suffix.lower()
        if suffix not in {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".tif", ".tiff"}:
            return

        holder = tk.Frame(parent, bg=bg, bd=0, highlightthickness=0)
        holder.pack(anchor="w", pady=(0, 2))

        placeholder = tk.Label(
            holder, text="Resim yükleniyor…", bg="#eef1f2" if not ben else "#cdecc7",
            fg="#667781", font=("Segoe UI", 8), width=22, height=5, bd=0, cursor="watch"
        )
        placeholder.pack(anchor="w", padx=1, pady=1)

        try:
            hedef = self._mesaj_dosya_yolu_guvenli(veri)
        except Exception:
            placeholder.configure(text="Resim kullanılamıyor.", cursor="arrow")
            return

        generation = getattr(self, "_chat_scene_generation", 0)
        target = getattr(self, "sohbet_hedef", "")
        max_w, max_h = 340, 255
        rel = str(veri.get("rel", ""))
        size = int(veri.get("size", 0) or 0)
        cache_key = hashlib.sha1(f"{rel}|{size}".encode("utf-8", "ignore")).hexdigest()
        thumb_path = self._chat_thumb_dir / f"{cache_key}.jpg"

        def decode_or_cache():
            try:
                if not hedef.is_file():
                    return None
                if thumb_path.exists() and thumb_path.stat().st_size > 0:
                    with Image.open(thumb_path) as cached_im:
                        preview = cached_im.convert("RGB").copy()
                    return preview

                with Image.open(hedef) as im:
                    try:
                        im.seek(0)
                    except Exception:
                        pass
                    try:
                        im.draft("RGB", (max_w * 2, max_h * 2))
                    except Exception:
                        pass
                    if im.mode not in ("RGB", "RGBA"):
                        im = im.convert("RGB")
                    else:
                        im = im.copy()
                    im.thumbnail((max_w, max_h), Image.Resampling.LANCZOS)
                    preview = im.convert("RGB").copy()
                try:
                    preview.save(thumb_path, "JPEG", quality=84, optimize=True)
                except Exception:
                    pass
                return preview
            except Exception:
                return None

        future = self._chat_preview_executor.submit(decode_or_cache)

        def tamamlanan(fut):
            try:
                preview = fut.result()
            except Exception:
                preview = None

            def uygula():
                try:
                    if not placeholder.winfo_exists() or not holder.winfo_exists():
                        return
                    if generation != getattr(self, "_chat_scene_generation", 0):
                        return
                    if target != getattr(self, "sohbet_hedef", ""):
                        return
                    if preview is None:
                        placeholder.configure(text="Resim önizlemesi yüklenemedi.", cursor="arrow")
                        return
                    photo = ImageTk.PhotoImage(preview)
                    refs = getattr(self, "_chat_active_image_refs", [])
                    refs.append(photo)
                    placeholder.configure(image=photo, text="", width=photo.width(), height=photo.height(), cursor="hand2")
                    placeholder.image = photo
                    placeholder.bind("<Button-1>", lambda e, d=dict(veri): self._mesaj_resim_buyut(d))
                    placeholder.bind("<Double-Button-1>", lambda e, d=dict(veri): self._dosya_ekini_ac(d))
                    if not getattr(holder, "_enctakip_dosya_bilgi", None):
                        bilgi = tk.Label(holder, text=f"{veri.get('name','Resim')}  •  {self._dosya_boyutu_metin(size)}", bg=bg, fg="#667781", font=("Segoe UI", 7), anchor="w")
                        bilgi.pack(anchor="w", padx=4, pady=(1, 0))
                        holder._enctakip_dosya_bilgi = True
                    # Çok sayıda fotoğraf aynı anda gelirse her biri ayrı
                    # update_idletasks çağırmasın. Scrollregion tek idle turunda
                    # hesaplanır ve kullanıcı zaten alttaysa en alta bırakılır.
                    was_bottom = False
                    try:
                        was_bottom = self.ms_canvas.yview()[1] >= 0.985
                    except Exception:
                        pass
                    self._chat_scrollregion_planla()
                    if was_bottom:
                        self.root.after_idle(lambda: self.ms_canvas.yview_moveto(1.0))
                except Exception:
                    pass

            try:
                self.root.after(0, uygula)
            except Exception:
                pass

        future.add_done_callback(tamamlanan)

    def _mesaj_resim_buyut(self, veri: dict) -> None:
        """Sohbetteki resme tıklanınca büyük önizlemeyi GUI'yi kilitlemeden açar."""
        pen = None
        try:
            hedef = self._mesaj_dosya_yolu_guvenli(veri)
            ekran_w = max(700, self.root.winfo_screenwidth() - 180)
            ekran_h = max(500, self.root.winfo_screenheight() - 180)

            pen = ctk.CTkToplevel(self.root)
            pen.title(str(veri.get("name") or "Resim önizleme"))
            pen.geometry("760x560")
            pen.minsize(420, 320)
            pen.transient(self.root)

            wrap = ctk.CTkFrame(pen, fg_color="#111b21", corner_radius=0)
            wrap.pack(fill=tk.BOTH, expand=True)
            loading = tk.Label(
                wrap,
                text="Resim yükleniyor…",
                bg="#111b21",
                fg="#d7e0e4",
                font=("Segoe UI", 10),
            )
            loading.pack(expand=True)

            closed = {"value": False}
            pen.protocol("WM_DELETE_WINDOW", lambda: (closed.__setitem__("value", True), pen.destroy()))
            pen.bind("<Escape>", lambda e: pen.destroy())
            pen.focus_force()

            def worker():
                try:
                    with Image.open(hedef) as im:
                        try:
                            im.seek(0)
                        except Exception:
                            pass
                        try:
                            im.draft("RGB", (min(ekran_w, 1800), min(ekran_h, 1200)))
                        except Exception:
                            pass
                        if im.mode not in ("RGB", "RGBA"):
                            im = im.convert("RGB")
                        else:
                            im = im.copy()
                        im.thumbnail((ekran_w, ekran_h), Image.Resampling.LANCZOS)
                        preview = im.copy()

                    def uygula():
                        try:
                            if closed["value"] or not pen.winfo_exists():
                                return
                            photo = ImageTk.PhotoImage(preview)
                            loading.destroy()
                            lab = tk.Label(
                                wrap,
                                image=photo,
                                bg="#111b21",
                                bd=0,
                                cursor="hand2",
                            )
                            lab.image = photo
                            lab.pack(expand=True, padx=12, pady=(12, 4))
                            ctk.CTkLabel(
                                wrap,
                                text=(
                                    f"{veri.get('name', 'Resim')}  •  "
                                    f"{self._dosya_boyutu_metin(int(veri.get('size', 0) or 0))}"
                                ),
                                text_color="#d7e0e4",
                                font=(T.FONT, 9),
                            ).pack(pady=(0, 10))
                            lab.bind("<Button-1>", lambda e: pen.destroy())
                            pen.geometry(
                                f"{min(photo.width() + 40, ekran_w + 40)}x"
                                f"{min(photo.height() + 90, ekran_h + 90)}"
                            )
                        except Exception:
                            pass

                    self.root.after(0, uygula)
                except Exception as exc:
                    try:
                        self.root.after(0, lambda: loading.configure(text=f"Resim önizlenemedi: {exc}"))
                    except Exception:
                        pass

            threading.Thread(
                target=worker,
                daemon=True,
                name="ENCTakip-BuyukResimOnizleme",
            ).start()
        except Exception as exc:
            if pen is not None:
                try:
                    pen.destroy()
                except Exception:
                    pass
            messagebox.showerror(
                "Resim Önizleme",
                f"Resim önizlenemedi:\n{exc}",
                parent=self.root,
            )

    def _mesaj_dosyalari_klasoru(self) -> Path:
        klasor = Path(self.s.sistem_klasoru) / "mesaj_dosyalari"
        klasor.mkdir(parents=True, exist_ok=True)
        return klasor

    def _chat_scrollregion_guncelle(self) -> None:
        """Aktif sohbetin gerçek içeriğine göre Canvas scrollregion'ını günceller."""
        try:
            if not self.ms_canvas.winfo_exists():
                return
            self.ms_canvas.update_idletasks()
            bbox = self.ms_canvas.bbox(self.ms_canvas_window)
            if bbox:
                self.ms_canvas.configure(scrollregion=bbox)
            else:
                self.ms_canvas.configure(scrollregion=(0, 0, 0, 0))
        except Exception:
            pass

    def _chat_scrollregion_planla(self) -> None:
        """Scrollregion hesaplarını aynı event-loop turunda tekilleştirir."""
        if getattr(self, "_chat_scroll_update_pending", False):
            return
        self._chat_scroll_update_pending = True

        def uygula():
            self._chat_scroll_update_pending = False
            self._chat_scrollregion_guncelle()

        try:
            self.root.after_idle(uygula)
        except Exception:
            self._chat_scroll_update_pending = False

    def _chat_canvas_genislik_guncelle(self, event=None) -> None:
        """Aktif Canvas window'unu viewport genişliğine kilitler ve scrollregion'ı yeniler."""
        try:
            width = max(1, int(getattr(event, "width", 0) or self.ms_canvas.winfo_width()))
            self.ms_canvas.itemconfigure(self.ms_canvas_window, width=width)
            self.root.after_idle(self._chat_scrollregion_guncelle)
        except Exception:
            pass

    def _chat_kullanici_altta_mi(self) -> bool:
        try:
            return bool(self.ms_canvas.yview()[1] >= 0.985)
        except Exception:
            return True

    def _chat_tail_butonu_guncelle(self) -> None:
        try:
            btn = getattr(self, "_chat_tail_button", None)
            badge = getattr(self, "_chat_tail_badge", None)
            if btn is None or not btn.winfo_exists():
                return
            if self._chat_kullanici_altta_mi():
                btn.place_forget()
                if badge is not None:
                    badge.place_forget()
                return
            count = int(getattr(self, "_chat_new_message_count", 0) or 0)
            btn.configure(text="↓")
            btn.place(relx=1.0, rely=1.0, anchor="se", x=-18, y=-18)
            if badge is not None and count > 0:
                badge.configure(text=str(min(count, 99)))
                badge.place(relx=1.0, rely=1.0, anchor="ne", x=-7, y=-33)
            elif badge is not None:
                badge.place_forget()
        except Exception:
            pass

    def _chat_sona_git(self) -> None:
        try:
            self._chat_follow_tail = True
            self._chat_new_message_count = 0
            self.root.after_idle(lambda: self.ms_canvas.yview_moveto(1.0))
            self.root.after(35, lambda: self.ms_canvas.yview_moveto(1.0))
            self.root.after(90, self._chat_tail_butonu_guncelle)
            try:
                gorunumler = [x for x in self._mesaj_gorunumleri_hazirla() if self._mesaj_gorunumune_uyuyor_mu(x)]
                self._mesaj_okundu_isaretle(gorunumler)
            except Exception:
                pass
        except Exception:
            pass

    def _chat_scroll_konumu_degerlendir(self) -> None:
        try:
            if self._chat_kullanici_altta_mi():
                self._chat_follow_tail = True
                self._chat_new_message_count = 0
                try:
                    gorunumler = [x for x in self._mesaj_gorunumleri_hazirla() if self._mesaj_gorunumune_uyuyor_mu(x)]
                    self._mesaj_okundu_isaretle(gorunumler)
                except Exception:
                    pass
            else:
                self._chat_follow_tail = False
            self._chat_tail_butonu_guncelle()
        except Exception:
            pass

    def _mesaj_mousewheel(self, event) -> None:
        try:
            delta = int(-1 * (event.delta / 120))
            self.ms_canvas.yview_scroll(delta, "units")
            self.root.after_idle(self._chat_scroll_konumu_degerlendir)
            if delta < 0:
                self.root.after_idle(self._mesaj_eski_gecmisi_yukle)
        except Exception:
            pass

    def _mesaj_scroll_command(self, *args):
        try:
            self.ms_canvas.yview(*args)
            self.root.after_idle(self._chat_scroll_konumu_degerlendir)
            self.root.after_idle(self._mesaj_eski_gecmisi_yukle)
        except Exception:
            pass

