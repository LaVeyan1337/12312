    def _menu_dugmesi_ekle(
        self,
        key: str,
        metin: str,
    ) -> None:
        btn = ctk.CTkButton(
            self.sidebar,
            text=metin,
            font=(T.FONT, T.FONT_NORMAL),
            fg_color="transparent",
            hover_color=T.SB_HOVER,
            text_color="white",
            anchor="w",
            corner_radius=8,
            height=40,
            command=lambda: self._sekme_degistir(key),
        )

        btn.pack(
            fill=tk.X,
            padx=10,
            pady=1,
        )

        self.menu_btns[key] = btn

    def _sekme_degistir(self, key: str) -> None:
        if key not in self.sekmeler:
            return

        self.aktif_sekme = key

        for k, btn in self.menu_btns.items():
            btn.configure(
                fg_color=(
                    T.SB_AKTIF
                    if k == key
                    else "transparent"
                )
            )

        for k, f in self.sekmeler.items():
            if k == key:
                f.pack(
                    fill=tk.BOTH,
                    expand=True,
                )
            else:
                f.pack_forget()

        if key == "mesaj":
            self.okunmayan_genel = 0
            self._menu_rozet_guncelle()
            self._mesajlari_yukle()
            self._kisi_listesini_yukle()

        elif key == "gunluk":
            self._gunlugu_yukle()

    def _menu_rozet_guncelle(self) -> None:
        toplam = (
            self.okunmayan_genel
            + sum(self.okunmayan_ozel.values())
            + sum(getattr(self, "okunmayan_odalar", {}).values())
        )

        btn = self.menu_btns.get("mesaj")

        if not btn:
            return

        metin = "Mesajlar"

        if (
            toplam > 0
            and self.aktif_sekme != "mesaj"
        ):
            metin += f"  ({toplam})"

        btn.configure(text=metin)

