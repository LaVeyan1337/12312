$('search').oninput=()=>renderList();$('searchChat').onclick=()=>{let q=prompt('Bu sohbette ara:',state.search||'');if(q!==null){state.search=q.trim();loadMessages()}};$('infoChat').onclick=()=>{const m=targetMeta(state.target);if(m.kind==='direct')openProfile(m.user.kullanici_adi);else if(m.kind==='group')openGroupInfo(m);else openRoomInfo(m)};
function openProfile(username){const u=person(username);const p=livePresence(u.kullanici_adi);const self=norm(u.kullanici_adi)===norm(state.me.kullanici_adi);const statusBox=self?'<div style="margin-top:14px"><div class="muted-note" style="margin-bottom:7px">Durumun</div><div class="status-menu">'+[['online','Çevrimiçi'],['busy','Meşgul'],['meeting','Toplantıda'],['away','Dışarıda']].map(x=>'<button class="status-choice '+(u.durum===x[0]?'active':'')+'" onclick="setStatusUI('+JSON.stringify(x[0])+')">'+x[1]+'</button>').join('')+'</div></div>':'';$('modal').innerHTML='<div class="profile-top"><div class="profile-avatar" id="profileAvatar"></div><div><h3 style="margin:0">'+esc(u.ad_soyad||u.kullanici_adi)+'</h3><div class="muted-note">@'+esc(u.kullanici_adi)+'</div><div class="status-chip" style="margin-top:7px"><span class="presence '+presenceClass(u)+'" style="position:static;width:8px;height:8px;border:0"></span>'+esc(p.durum_adi||u.durum||'Çevrimdışı')+'</div></div></div><div class="profile-grid"><b>Unvan</b><span>'+esc(u.unvan||'—')+'</span><b>Departman</b><span>'+esc(u.departman||'—')+'</span><b>Telefon</b><span>'+esc(u.telefon||'—')+'</span><b>E-posta</b><span>'+esc(u.eposta||'—')+'</span><b>Son görülme</b><span>'+esc(p.online?'Şimdi':fmtLastSeen(p.last_seen))+'</span></div>'+statusBox+'<div class="modal-actions"><button class="secondary" onclick="closeModal()">Kapat</button>'+(!self?'<button class="primary" onclick="closeModal();openTarget('+JSON.stringify(u.kullanici_adi)+')">Sohbete git</button>':'')+adminEditButton(u.kullanici_adi)+'</div>';$('modalBg').classList.add('show');renderAvatar($('profileAvatar'),u)}
async function setStatusUI(status){closeModal();try{await setStatus(status);showToast('Durum güncellendi')}catch(e){showToast(e.message||'Durum değiştirilemedi')}}window.setStatusUI=setStatusUI;
$('meAvatar').onclick=()=>openProfile(state.me.kullanici_adi);$('meName').onclick=()=>openProfile(state.me.kullanici_adi);$('headAvatar').onclick=()=>{const m=targetMeta(state.target);openProfile(m.kind==='direct'?m.user.kullanici_adi:state.me.kullanici_adi)};
function openGroupInfo(g){$('modal').innerHTML='<h3>'+esc(g.name)+'</h3><p>'+esc(g.description||'Grup')+'</p><div class="member-list">'+(g.members||[]).map(x=>{let u=person(x);return '<div class="member" onclick="openProfile('+JSON.stringify(x)+')"><div class="avatar" style="width:32px;height:32px;flex:0 0 32px">'+esc(initials(u.ad_soyad||x))+'</div><div><b>'+esc(u.ad_soyad||x)+'</b><br><small>@'+esc(x)+'</small></div></div>'}).join('')+'</div><div class="modal-actions"><button class="secondary" onclick="closeModal()">Kapat</button></div>';$('modalBg').classList.add('show')}
function openRoomInfo(r){$('modal').innerHTML='<h3>'+esc(r.name)+'</h3><p>'+esc(r.description||'')+'</p><div class="muted-note">Bu oda tüm aktif ENCTakip kullanıcılarının ortak sohbet alanıdır.</div><div class="modal-actions"><button class="secondary" onclick="closeModal()">Kapat</button></div>';$('modalBg').classList.add('show')}
function closeModal(){$('modalBg').classList.remove('show')}window.closeModal=closeModal;window.openProfile=openProfile;
function openStatusModal(m){const all=[...(m.delivered_to||[])].map(x=>'<div>✓✓ İletildi: <b>'+esc(person(x).ad_soyad||x)+'</b></div>').join('')+[...(m.read_by||[])].map(x=>'<div style="color:#0e9f80">✓✓ Okundu: <b>'+esc(person(x).ad_soyad||x)+'</b></div>').join('');$('modal').innerHTML='<h3>Mesaj durumu</h3><p>'+esc(fmtDay(m.time)+' '+fmtTime(m.time))+'</p><div class="member-list" style="padding:12px;line-height:1.7">'+(all||'<div class="muted-note">Henüz teslim/okundu bilgisi oluşmadı.</div>')+'</div><div class="modal-actions"><button class="secondary" onclick="closeModal()">Kapat</button></div>';$('modalBg').classList.add('show')}
function openReactionPicker(m){const defaults='👍 ❤️ 😂 😮 😢 😡 🎉 🔥 ✅ 👏 🙏'.split(' ');$('modal').innerHTML='<h3>Tepki ekle</h3><div style="display:flex;flex-wrap:wrap;gap:7px;margin-top:13px">'+defaults.map(e=>'<button class="secondary" style="font-size:20px;padding:7px 10px" onclick="reactMessage('+JSON.stringify(m.id)+','+JSON.stringify(e)+');closeModal()">'+e+'</button>').join('')+'</div><div class="modal-actions"><button class="secondary" onclick="closeModal()">Kapat</button></div>';$('modalBg').classList.add('show')}
async function reactMessage(id,emoji){await api('/api/react',{method:'POST',body:JSON.stringify({target:state.target,id,emoji})});await loadMessages()}window.reactMessage=reactMessage;
$('newGroup').onclick=()=>{let users=state.users.filter(u=>norm(u.kullanici_adi)!==norm(state.me.kullanici_adi));$('modal').innerHTML='<h3>Yeni grup</h3><p>Grup adı ve katılımcıları seçin.</p><input id="gName" placeholder="Örn. GES Ekibi"><textarea id="gDesc" rows="3" placeholder="Açıklama (opsiyonel)"></textarea><div class="check-list">'+users.map(u=>'<label class="check"><input type="checkbox" value="'+esc(u.kullanici_adi)+'"> <span><b>'+esc(u.ad_soyad||u.kullanici_adi)+'</b><br><small>'+esc(u.kullanici_adi)+'</small></span></label>').join('')+'</div><div class="modal-actions"><button class="secondary" onclick="closeModal()">İptal</button><button class="primary" onclick="createGroup()">Grubu oluştur</button></div>';$('modalBg').classList.add('show')};window.createGroup=async()=>{let members=[...document.querySelectorAll('#modal .check input:checked')].map(x=>x.value);let name=$('gName').value.trim();if(!name){showToast('Grup adı gerekli.');return}let d=await api('/api/group/create',{method:'POST',body:JSON.stringify({name,members,description:$('gDesc').value.trim()})});state.groups.push(d.group);closeModal();renderList();await openTarget(d.group.id)};
let fileDrag=0;$('drop').ondragover=e=>{e.preventDefault();$('drop').classList.add('show')};$('drop').ondragleave=e=>{if(e.target===$('drop'))$('drop').classList.remove('show')};$('drop').ondrop=e=>{e.preventDefault();$('drop').classList.remove('show');pendingFiles.push(...e.dataTransfer.files);showToast(pendingFiles.length+' dosya hazır')};document.addEventListener('dragenter',e=>{if(e.dataTransfer?.types?.includes('Files'))$('drop').classList.add('show')});document.addEventListener('dragleave',e=>{if(e.clientX<=0||e.clientY<=0)$('drop').classList.remove('show')});
function startPoll(){clearInterval(state.poll);state.poll=setInterval(async()=>{try{const d=await api('/api/messages?target='+encodeURIComponent(state.target)+'&limit=1000'+(state.search?('&q='+encodeURIComponent(state.search)):''));const incoming=d.messages||[];const s=incoming.map(x=>x.id+':'+x.text+':'+x.edited+':'+JSON.stringify(x.read_by||[])+':'+JSON.stringify(x.delivered_to||[])+':'+JSON.stringify(x.reactions||{})).join('|');if(s!==state.lastSignature){state.messages=incoming;state.lastSignature=s;renderMessages()}}catch(e){}},1200)}
function startPresencePoll(){clearInterval(state.presencePoll);state.presencePoll=setInterval(async()=>{try{const d=await api('/api/presence');state.presences=d.presence||{};renderList();updateHead();if(state.targetMeta?.kind==='direct'){} }catch(e){}},1500)}
function startHeartbeat(){const beat=()=>api('/api/heartbeat',{method:'POST',body:JSON.stringify({status:state.manualStatus||'online',typing:!!state.typing})}).catch(()=>{});beat();clearInterval(state.heartbeat);state.heartbeat=setInterval(beat,15000);window.addEventListener('beforeunload',()=>{navigator.sendBeacon('/api/heartbeat',new Blob([JSON.stringify({status:state.manualStatus||'online',offline:true})],{type:'application/json'}))})}
async function refreshBootstrap(){const d=await api('/api/bootstrap?user='+encodeURIComponent(state.me.kullanici_adi));state.admin=!!d.admin;state.users=d.users||[];state.rooms=d.rooms||[];state.groups=d.groups||[];state.me=d.me;state.profileMap=new Map(state.users.map(u=>[norm(u.kullanici_adi),u]));updateMe();updateHead();renderList()}

function adminEditButton(username){return state.admin?'<button class="primary" onclick="closeModal();openAdminProfileEditor('+JSON.stringify(username)+')">Profili düzenle</button>':''}

async function openAdminProfileEditor(username){if(!state.admin){showToast('Yönetici yetkisi gerekli.');return}const u=person(username);if(!u)return;const opts=[['user','Kullanıcı'],['admin','Yönetici'],['yonetici','Yönetici']];$('modal').innerHTML='<h3>Profil düzenle</h3><div class="muted-note" style="margin-bottom:12px">@'+esc(u.kullanici_adi)+' · Kullanıcı adı sistem kimliğidir ve buradan değiştirilemez.</div><div class="admin-form"><label>Ad Soyad<input id="admName" value="'+esc(u.ad_soyad||'')+'"></label><label>Unvan<input id="admTitle" value="'+esc(u.unvan||'')+'"></label><label>Departman<input id="admDept" value="'+esc(u.departman||'')+'"></label><label>Telefon<input id="admPhone" value="'+esc(u.telefon||'')+'"></label><label>E-posta<input id="admMail" value="'+esc(u.eposta||'')+'"></label><label>Durum<select id="admStatus"><option value="online">Çevrimiçi</option><option value="busy">Meşgul</option><option value="meeting">Toplantıda</option><option value="away">Dışarıda</option></select></label><label>Rol<select id="admRole">'+opts.map(x=>'<option value="'+x[0]+'">'+x[1]+'</option>').join('')+'</select></label><label class="check"><input type="checkbox" id="admActive" '+(u.aktif!==false?'checked':'')+'> Aktif kullanıcı</label><label>Profil fotoğrafı<input id="admAvatar" type="file" accept="image/png,image/jpeg,image/webp"></label></div><div class="modal-actions"><button class="secondary" onclick="closeModal()">İptal</button><button class="primary" onclick="saveAdminProfile('+JSON.stringify(u.kullanici_adi)+')">Kaydet</button></div>';$('admStatus').value=u.durum||'online';$('admRole').value=(u.rol||'user').toLowerCase();$('modalBg').classList.add('show')}
window.openAdminProfileEditor=openAdminProfileEditor;

async function saveAdminProfile(username){const img=$('admAvatar').files?.[0];let data={kullanici_adi:username,ad_soyad:$('admName').value,unvan:$('admTitle').value,departman:$('admDept').value,telefon:$('admPhone').value,eposta:$('admMail').value,durum:$('admStatus').value,rol:$('admRole').value,aktif:$('admActive').checked};if(img){data.profil_fotografi={name:img.name,data:(await new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(String(r.result).split(',')[1]);r.onerror=rej;r.readAsDataURL(img)}))}}try{await api('/api/admin/user/save',{method:'POST',body:JSON.stringify(data)});await refreshBootstrap();closeModal();openProfile(username);showToast('Profil güncellendi')}catch(e){showToast(e.message||'Profil güncellenemedi')}}

async function setStatus(status){state.manualStatus=status;await api('/api/status',{method:'POST',body:JSON.stringify({status})});const d=await api('/api/bootstrap?user='+encodeURIComponent(state.me.kullanici_adi));state.users=d.users;state.profileMap=new Map(state.users.map(u=>[norm(u.kullanici_adi),u]));state.me=d.me;renderList();updateMe();updateHead();showToast('Durum: '+(d.me.durum||status))}
function scheduleTyping(){if(state.typingTimer)clearTimeout(state.typingTimer);state.typing=true;clearTimeout(state.typingTimer);state.typingTimer=setTimeout(()=>{state.typing=false},2500)}
async function refreshTyping(){try{const d=await api('/api/presence');const active=Object.values(d.presence||{}).filter(x=>x.typing&&x.kullanici_adi&&norm(x.kullanici_adi)!==norm(state.me.kullanici_adi));$('typing').textContent=active.length?active.map(x=>(x.ad_soyad||x.kullanici_adi)+' yazıyor…').join(', '):''}catch(e){}setTimeout(refreshTyping,1200)}
function markDelivered(id){let k='del_'+id;if(sessionStorage.getItem(k))return;sessionStorage.setItem(k,'1');api('/api/delivered',{method:'POST',body:JSON.stringify({target:state.target,id})}).catch(()=>{})}function markRead(id){let k='read_'+id;if(sessionStorage.getItem(k))return;sessionStorage.setItem(k,'1');api('/api/read',{method:'POST',body:JSON.stringify({target:state.target,id})}).catch(()=>{})}
$('modalBg').onclick=e=>{if(e.target===$('modalBg'))closeModal()};
async function boot(){const d=await api('/api/bootstrap?user='+encodeURIComponent(new URLSearchParams(location.search).get('user')||''));state.admin=!!d.admin;state.me=d.me;state.users=d.users||[];state.rooms=d.rooms||[];state.groups=d.groups||[];state.presences={};state.profileMap=new Map(state.users.map(u=>[norm(u.kullanici_adi),u]));state.manualStatus=state.me.durum||'online';updateMe();renderList();await openTarget('GENEL');startPresencePoll();startHeartbeat();refreshTyping();buildEmojiPicker()}
function showToast(t){$('toast').textContent=t;$('toast').classList.add('show');clearTimeout(showToast.t);showToast.t=setTimeout(()=>$('toast').classList.remove('show'),2300)}
boot().catch(e=>{document.body.innerHTML='<div style="padding:40px;font-family:Segoe UI"><h2>ENCTakip chat başlatılamadı</h2><p>'+esc(e.message)+'</p></div>'});
</script>
</body>
</html>
