function accountBlocked(message){if(state.blocked)return;state.blocked=true;clearInterval(state.poll);clearInterval(state.presencePoll);clearInterval(state.heartbeat);const wrap=document.createElement('div');wrap.style='position:fixed;inset:0;z-index:300;background:rgba(20,29,33,.78);display:grid;place-items:center;padding:20px;font-family:Segoe UI,system-ui,sans-serif';wrap.innerHTML='<div style="width:min(460px,100%);background:#fff;border-radius:18px;padding:24px;box-shadow:0 25px 70px rgba(0,0,0,.25)"><div style="font-size:36px">🔒</div><h2 style="margin:8px 0">Hesap erişimi kapatıldı</h2><p style="color:#647178;font-size:13px;line-height:1.5">'+esc(message||'Bu kullanıcı hesabı pasif durumda.')+'</p><p style="color:#8a969b;font-size:11px">Yönetici hesabı yeniden aktif edene kadar sohbet bağlantısı durduruldu.</p></div>';document.body.appendChild(wrap)}
