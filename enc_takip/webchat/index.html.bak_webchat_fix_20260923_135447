function openProfile(username){const u=person(username),p=livePresence(u.kullanici_adi),self=norm(u.kullanici_adi)===norm(state.me.kullanici_adi);const roleText=u.rol==='user'?'Kullanıcı':'Yönetici';$('modal').innerHTML='<div class="profile-top"><div class="profile-avatar" id="profileAvatar"></div><div style="min-width:0"><h3 style="margin:0">'+esc(u.ad_soyad||u.kullanici_adi)+'</h3><div class="muted-note">@'+esc(u.kullanici_adi)+' · '+esc(roleText)+'</div><div class="status-chip" style="margin-top:7px"><span class="presence '+presenceClass(u)+'" style="position:static;width:8px;height:8px;border:0"></span>'+esc(p.durum_adi||u.durum||'Çevrimdışı')+'</div></div></div><div class="profile-grid"><b>Unvan</b><span>'+esc(u.unvan||'—')+'</span><b>Departman</b><span>'+esc(u.departman||'—')+'</span><b>Telefon</b><span>'+esc(u.telefon||'—')+'</span><b>E-posta</b><span>'+esc(u.eposta||'—')+'</span><b>Durum mesajı</b><span>'+esc(u.durum_mesaji||'—')+'</span><b>Son görülme</b><span>'+esc(p.online?'Şimdi':fmtLastSeen(p.last_seen))+'</span></div><div class="modal-actions" id="profileActions"></div>';$('modalBg').classList.add('show');renderAvatar($('profileAvatar'),u);const actions=$('profileActions');if(!self){const chat=document.createElement('button');chat.className='primary';chat.textContent='Sohbete git';chat.addEventListener('click',()=>{closeModal();openTarget(u.kullanici_adi)});actions.appendChild(chat)}const edit=document.createElement('button');edit.className='primary';edit.textContent='Profili düzenle';edit.addEventListener('click',()=>openProfileEditor(u.kullanici_adi,state.admin&&!self));actions.appendChild(edit);if(self){const stat=document.createElement('button');stat.className='secondary';stat.textContent='Durumunu değiştir';stat.addEventListener('click',()=>openStatusEditor(u));actions.appendChild(stat)}else{const close=document.createElement('button');close.className='secondary';close.textContent='Kapat';close.addEventListener('click',closeModal);actions.appendCh