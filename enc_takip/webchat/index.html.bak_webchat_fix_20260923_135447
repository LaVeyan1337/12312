function openProfileEditor(username,adminMode=false){const u=person(username);const self=norm(username)===norm(state.me.kullanici_adi);if(!self&&!adminMode){showToast('Bu profili düzenlemek için yönetici yetkisi gerekli.');return}const adminFields=adminMode?'<div class="field"><span>Rol</span><select id="pRole"><option value="user">Kullanıcı</option><option value="admin">Yönetici</option><option value="yonetici">Yönetici (uyumluluk)</option></select></div><div class="field"><span>Hesap</span><select id="pActive"><option value="true">Aktif</option><option value="false">Pasif</option></select></div>':'';$('modal').innerHTML='<h3>Profili düzenle</h3><div class="muted-note" style="margin-bottom:10px">@'+esc(u.kullanici_adi)+' · Kullanıcı adı sistem kimliğidir ve değiştirilemez.</div><div class="avatar-editor"><div class="profile-avatar" id="editorAvatar"></div><div><div class="avatar-editor-actions"><button class="small-btn" id="chooseAvatar">Fotoğraf seç</button><button class="small-btn" id="pasteAvatar">Panodan al</button><button class="small-btn" id="removeAvatar">Fotoğrafı kaldır</button></div><div class="muted-note" style="margin-top:6px">PNG/JPG/WEBP · en fazla 8 MB</div><input type="file" id="profileFile" accept="image/png,image/jpeg,image/webp" hidden></div></div><div class="error-box" id="profileErr"></div><div class="field-grid"><div class="field"><span>Ad Soyad</span><input id="pName" maxlength="255"></div><div class="field"><span>Unvan</span><input id="pTitle" maxlength="255"></div><div class="field"><span>Departman</span><input id="pDept" maxlength="255"></div><div class="field"><span>Telefon</span><input id="pPhone" maxlength="255"></div><div class="field"><span>E-posta</span><input id="pMail" maxlength="255" type="email"></div><div class="field"><span>Durum</span><select id="pStatus">'+Object.entries(statusNames).map(([k,v])=>'<option value="'+k+'">'+v+'</option>').join('')+'</select></div><div class="field full"><span>Durum mesajı</span><input id="pStatusMsg" maxlength="120" placeholder="Örn. Toplantıdayım, 14:00 sonrası döneceğim"></div>'+adminFields+'</div><div class="modal-actions"><button class="secondary" id="profileCancel">İptal</button><button class="primary" id="profileSave">Kaydet</button></div>';$('modalBg').classList.add('show');renderAvatar($('editorAvatar'),u);$('pName').value=u.ad_soyad||'';$('pTitle').value=u.unvan||'';$('pDept').value=u.departman||'';$('pPhone').value=u.telefon||'';$('pMail').value=u.eposta||'';$('pStatus').value=u.durum||'online';$('pStatusMsg').value=u.durum_mesaji||'';if(adminMode){$('pRole').value=(u.rol||'user').toLowerCase();$('pActive').value=u.aktif===false?'false':'true'}let avatarData=null,removeAvatar=false;$('chooseAvatar').addEventListener('click',()=>$('profileFile').click());$('removeAvatar').addEventListener('click',()=>{avatarData=null;removeAvatar=true;$('editorAvatar').innerHTML=initials(u.ad_soyad||u.kullanici_adi)});$('profileFile').addEventListener('change',()=>{const f=$('profileFile').files?.[0];if(f)previewProfileImage(f)});$('pasteAvatar').addEventListener('click',async()=>{try{if(!navigator.clipboard?.read)throw new Error('clipboard-read');const items=await navigator.clipboard.read();for(const item of items){const type=item.types.find(x=>x.startsWith('image/'));if(type){const blob=await item.getType(type);previewProfileImage(new File([blob],'clipboard.png',{type}));return}}showToast('Panoda desteklenen bir görsel bulunamadı.')}catch{showToast('Panodan görsel almak için dosyayı doğrudan bu pencereye yapıştırabilirsiniz.')}});
 function previewProfileImage(file){if(file.size>8*1024*1024){showToast('Profil fotoğrafı 8 MB sınırını aşıyor');return}const r=new FileReader();r.onload=()=>{avatarData={name:file.name,data:String(r.result).split(',')[1]};removeAvatar=false;$('editorAvatar').innerHTML='<img alt="">';$('editorAvatar').firstElementChild.src=String(r.result)};r.readAsDataURL(file)}
 $('editorAvatar').addEventListener('paste',e=>{const f=[...(e.clipboardData?.items||[])].map(i=>i.kind==='file'?i.getAsFile():null).find(Boolean);if(f){e.preventDefault();previewProfileImage(f)}});$('profileCancel').addEventListener('click',()=>openProfile(username));$('profileSave').addEventListener('click',async()=>{const btn=$('profileSave'),err=$('profileErr');err.classList.remove('show');if(!$('pName').value.trim()){err.textContent='Ad Soyad boş bırakılamaz.';err.classList.add('show');return}if($('pMail').value && !/^.+@.+\..+$/.test($('pMail').value.trim())){err.textContent='E-posta biçimi geçersiz.';err.classList.add('show');return}const body={kullanici_adi:username,ad_soyad:$('pName').value,unvan:$('pTitle').value,departman:$('pDept').value,telefon:$('pPhone').value,eposta:$('pMail').value,durum:$('pStatus').value,durum_mesaji:$('pStatusMsg').value};if(avatarData)body.profil_fotografi=avatarData;if(removeAvatar)body.profil_fotografi_sil=true;if(adminMode){body.rol=$('pRole').value;body.aktif=$('pActive').value==='true'}btn.classList.add('loading');try{await api(adminMode?'/api/admin/profile/save':'/api/profile/save',{method:'POST',body:JSON.stringify(body)});await refreshBootstrap();if(state.admin&&adminMode){await refreshAdminUsers();closeModal();await openAdminUsers();showToast('Yönetici değişikliği kaydedildi.')}else{closeModal();openProfile(username);showToast('Profil başarıyla güncellendi.')}}catch(e){err.textContent=e.message;err.classList.add('show')}finally{btn.classList.remove('loading')}})}
async function openAdminUsers(){if(!state.admin){showToast('Yönetici yetkisi gerekli.');return}const d=await api('/api/admin/users');adminCache=d.users||[];renderAdminUsers();$('modal').className='modal wide';$('modal').innerHTML='<h3>Kullanıcı yönetimi</h3><div class="admin-note">Buradan tüm profilleri, hesapların aktif/pasif durumunu ve rollerini yönetebilirsiniz. Kullanıcı adı değiştirilemez; mesaj geçmişini korumak için sabit kimliktir.</div><div class="admin-toolbar"><input id="adminSearch" placeholder="Ad, kullanıcı adı, departman…"><select id="adminFilter"><option value="all">Tümü</option><option value="active">Aktif</option><option value="inactive">Pasif</option><option value="admin">Yöneticiler</option></select></div><div class="admin-table" id="adminTable"></div><div class="modal-actions"><button class="secondary" id="adminClose">Kapat</button></div>';$('modalBg').classList.add('show');$('adminSearch').addEventListener('input',renderAdminUsers);$('adminFilter').addEventListener('change',renderAdminUsers);$('adminClose').addEventListener('click',closeModal);renderAdminUsers()}
let adminCache=[];async function refreshAdminUsers(){if(!state.admin)return;try{const d=await api('/api/admin/users');adminCache=d.users||[]}catch(e){showToast(e.message||'Kullanıcılar alınamadı')}}
function renderAdminUsers(){if(!$('adminTable'))return;const q=norm($('adminSearch')?.value),filter=$('adminFilter')?.value||'all';let rows=adminCache.filter(u=>{const text=[u.ad_soyad,u.kullanici_adi,u.departman,u.unvan,u.eposta].map(norm).join(' ');if(q&&!text.includes(q))return false;if(filter==='active'&&!u.aktif)return false;if(filter==='inactive'&&u.aktif)return false;if(filter==='admin'&&!(u.rol==='admin'||u.rol==='yonetici'))return false;return true});const box=$('adminTable');box.innerHTML='';if(!rows.length){box.innerHTML='<div class="muted-note" style="padding:18px">Kayıt bulunamadı.</div>';return}rows.forEach(u=>{const r=document.createElement('div');r.className='user-row';const name=document.createElement('div');name.className='user-name';const av=document.createElement('div');av.className='avatar';av.style.width='34px';av.style.height='34px';av.style.flex='0 0 34px';renderAvatar(av,u);name.appendChild(av);const nt=document.createElement('div');nt.className='user-name-text';nt.innerHTML='<b>'+esc(u.ad_soyad||u.kullanici_adi)+'</b><small>@'+esc(u.kullanici_adi)+' · '+esc(u.departman||u.unvan||'')+'</small>';name.appendChild(nt);r.appendChild(name);const mid=document.createElement('div');mid.className='admin-meta';mid.innerHTML='<span class="tag '+((u.rol==='admin'||u.rol==='yonetici')?'admin':'')+'">'+esc(u.rol==='user'?'Kullanıcı':'Yönetici')+'</span> '+(u.aktif?'<span class="tag">Aktif</span>':'<span class="tag off">Pasif</span>');r.appendChild(mid);const last=document.createElement('div');last.className='admin-meta muted-note';last.textContent=u.online?'Şimdi':fmtLastSeen(u.last_seen);r.appendChild(last);const b=document.createElement('button');b.className='primary';b.textContent='Düzenle';b.addEventListener('click',()=>openProfileEditor(u.kullanici_adi,true));r.appendChild(b);box.appendChild(r)})}
$('adminUsers').addEventListener('click',openAdminUsers);$('meCard').addEventListener('click',e=>{if(!e.target.closest('#meEdit'))openProfile(state.me.kullanici_adi)});$('meEdit').addEventListener('click',e=>{e.stopPropagation();openProfileEditor(state.me.kullanici_adi,false)});$('meName').addEventListener('click',()=>openProfile(state.me.kullanici_adi));$('meAvatar').addEventListener('click',()=>openProfile(state.me.kullanici_adi));$('headAvatar').addEventListener('click',()=>{const m=targetMeta();openProfile(m.kind==='direct'?m.kullanici_adi:state.me.kullanici_adi)});$('search').addEventListener('input',renderList);$('searchChat').addEventListener('click',()=>{const q=prompt('Bu sohbette ara:',state.search||'');if(q!==null){state.search=q.trim();state.lastSignature='';loadMessages()}});$('infoChat').addEventListener('click',()=>{const m=targetMeta();if(m.kind==='direct')openProfile(m.kullanici_adi);else if(m.kind==='group')openGroupInfo(m);else openRoomInfo(m)});
function openGroupInfo(g){$('modal').className='modal';$('modal').innerHTML='<h3>'+esc(g.name)+'</h3><p>'+esc(g.description||'Grup')+'</p><div class="member-list" style="max-height:320px">'+(g.members||[]).map(x=>{const u=person(x);return '<div class="mention-row" data-user="'+esc(x)+'"><div class="avatar" style="width:32px;height:32px;flex:0 0 32px"></div><div><b>'+esc(u.ad_soyad||x)+'</b><br><small>@'+esc(x)+'</small></div></div>'}).join('')+'</div><div class="modal-actions"><button class="secondary" id="groupClose">Kapat</button></div>';$('modalBg').classList.add('show');$('modal').querySelectorAll('[data-user]').forEach(r=>{renderAvatar(r.querySelector('.avatar'),person(r.dataset.user));r.addEventListener('click',()=>openProfile(r.dataset.user))});$('groupClose').addEventListener('click',closeModal)}
function openRoomInfo(r){$('modal').className='modal';$('modal').innerHTML='<h3>'+esc(r.name)+'</h3><p>'+esc(r.description||'')+'</p><div class="admin-note">Bu oda tüm aktif ENCTakip kullanıcılarının ortak çalışma alanıdır. Kullanıcılar @etiket ile birbirlerini doğrudan profilden açabilir.</div><div class="modal-actions"><button class="secondary" id="roomClose">Kapat</button></div>';$('modalBg').classList.add('show');$('roomClose').addEventListener('click',closeModal)}
$('newGroup').addEventListener('click',()=>{const users=state.users.filter(u=>norm(u.kullanici_adi)!==norm(state.me.kullanici_adi));$('modal').className='modal';$('modal').innerHTML='<h3>Yeni grup</h3><p>Grup adı, açıklaması ve katılımcıları seçin.</p><div class="field"><span>Grup adı</span><input id="gName" maxlength="80" placeholder="Örn. GES Ekibi"></div><div class="field" style="margin-top:10px"><span>Açıklama</span><textarea id="gDesc" maxlength="200" placeholder="Kısa açıklama"></textarea></div><div class="check-list" style="max-height:300px;overflow:auto;border:1px solid var(--line);border-radius:12px;margin-top:10px">'+users.map(u=>'<label class="check-row" style="padding:8px 10px"><input type="checkbox" value="'+esc(u.kullanici_adi)+'"><span><b>'+esc(u.ad_soyad||u.kullanici_adi)+'</b><br><small>@'+esc(u.kullanici_adi)+'</small></span></label>').join('')+'</div><div class="modal-actions"><button class="secondary" id="groupCancel">İptal</button><button class="primary" id="groupSave">Grubu oluştur</button></div>';$('modalBg').classList.add('show');$('groupCancel').addEventListener('click',closeModal);$('groupSave').addEventListener('click',async()=>{const members=[...document.querySelectorAll('#modal input[type=checkbox]:checked')].map(x=>x.value),name=$('gName').value.trim();if(!name){showToast('Grup adı gerekli.');return}try{const d=await api('/api/group/create',{method:'POST',body:JSON.stringify({name,members,description:$('gDesc').value.trim()})});state.groups.push(d.group);closeModal();renderList();openTarget(d.group.id);showToast('Grup oluşturuldu')}catch(e){showToast(e.message||'Grup oluşturulamadı')}})});
$('modalBg').addEventListener('click',e=>{if(e.target===$('modalBg'))closeModal()});function closeModal(){$('modalBg').classList.remove('show');$('modal').className='modal'}window.closeModal=closeModal;
