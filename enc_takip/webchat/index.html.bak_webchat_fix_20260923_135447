function openStatusEditor(u){$('modal').innerHTML='<h3>Durumunu güncelle</h3><div class="muted-note" style="margin-bottom:10px">Durum ve kısa durum mesajın diğer çalışanlara gösterilir.</div><div class="field"><span>Durum</span><select id="statusSel">'+Object.entries(statusNames).map(([k,v])=>'<option value="'+k+'">'+v+'</option>').join('')+'</select></div><div class="field" style="margin-top:10px"><span>Durum mesajı</span><input id="statusMsg" maxlength="120" placeholder="Örn. Saha çalışmasındayım" value="'+esc(u.durum_mesaji||'')+'"></div><div class="error-box" id="statusErr"></div><div class="modal-actions"><button class="secondary" id="statusCancel">İptal</button><button class="primary" id="statusSave">Kaydet</button></div>';$('modalBg').classList.add('show');$('statusSel').value=u.durum||'online';$('statusCancel').addEventListener('click',closeModal);$('statusSave').addEventListener('click',async()=>{await saveStatusForm()})}
