<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="logo">E</div><div><h1>ENCTakip Sohbet</h1><small>Kurumsal iletişim merkezi</small></div></div>
    <div class="sidebar-actions"><button class="tool-btn" id="newGroup">＋ Grup</button><button class="tool-btn admin" id="adminUsers" hidden>⚙ Kullanıcılar</button></div>
    <div class="search"><span>⌕</span><input id="search" placeholder="Kişi veya sohbet ara"></div>
    <div class="scroll" id="chatList"></div>
    <div class="me" id="meCard"><div class="avatar" id="meAvatar"></div><div class="me-info"><div class="me-name" id="meName"></div><div class="me-role" id="meRole"></div></div><button class="icon-btn" id="meEdit" title="Profilimi düzenle">✎</button></div>
  </aside>
  <main class="main">
    <div class="topbar">
      <div class="head-left"><div class="avatar head-avatar" id="headAvatar"></div><div style="min-width:0"><div class="head-title" id="headTitle"></div><div class="head-sub" id="headSub"></div></div></div>
      <div class="head-actions"><button class="icon-btn" id="searchChat" title="Sohbette ara">⌕</button><button class="icon-btn" id="infoChat" title="Bilgi">ⓘ</button></div>
    </div>
    <div class="messages" id="messages"></div>
    <div class="composer">
      <div class="reply" id="reply"><span>↪</span><div style="min-width:0"><b id="replyName"></b><div id="replyText" class="muted-note"></div></div><button class="icon-btn x" id="cancelReply">×</button></div>
      <div class="compose-row">
        <button class="round" id="attach" title="Dosya ekle">📎</button>
        <div class="textwrap">
          <div class="mention-list" id="mentionList"></div>
          <div class="emoji-pop" id="emojiPop"><div class="emoji-head"><input class="emoji-search" id="emojiSearch" placeholder="Emoji ara…"><span class="emoji-count" id="emojiCount"></span></div><div class="emoji-tabs" id="emojiTabs"></div><div class="emoji-grid" id="emojiGrid"></div></div>
          <textarea id="input" rows="1" placeholder="Mesaj yazın…"></textarea>
        </div>
        <button class="round" id="emoji" title="Emoji">😊</button>
        <button class="send" id="send">Gönder</button>
      </div>
      <div class="composer-tools"><span id="typing" class="typing"></span><span>Enter gönderir · Shift+Enter yeni satır · Görseli doğrudan yapıştırabilirsiniz</span></div>
    </div>
    <div class="drop" id="drop"><div class="drop-card"><div style="font-size:38px">📎</div><h3>Dosyaları bırakın</h3><p>25 MB'a kadar dosya veya görsel gönderebilirsiniz.</p></div></div>
  </main>
</div>
<input id="fileInput" type="file" multiple hidden>
<div class="context" id="context"><button data-act="reply">↩ Yanıtla</button><button data-act="copy">▣ Kopyala</button><button data-act="react">☺ Tepki</button><button data-act="status">✓ Mesaj durumu</button><button data-act="edit">✎ Düzenle</button><button data-act="delete">⌫ Sil</button></div>
<div class="modal-bg" id="modalBg"><div class="modal" id="modal"></div></div>
<div class="toast" id="toast"></div>
<script>
